// A `break` / `continue` that targets a loop INSIDE the defer body leaves only that
// loop, never the cleanup, so it is allowed (relaxed 2026-09-05 — the ban used to
// key on "inside a defer body" alone). `break` at the defer body's top level, which
// would leave the cleanup, stays rejected (tests/zer_fail/defer_break.zer et al.).
u32 g;
u32 f(u32 n) {
    defer {
        for (u32 i = 0; i < 10; i += 1) {
            if (i == n) { break; }
            if (i == 1) { continue; }
            g += 1;
        }
    }
    if (n == 3) { return 1; }
    return 0;
}
u32 main() {
    u32 r = f(3);   /* i=0 (+1), i=1 skip, i=2 (+1), i=3 break => g=2 */
    if (r != 1) { return 1; }
    if (g != 2) { return 2; }
    r = f(5);       /* +4 => g=6 */
    if (g != 6) { return 3; }
    return 0;
}
