// EXPECTED: compile error
// expect-error: use after free: 'a' is freed
// BUG-1460: a call inside an intrinsic argument (@popcount) frees a — skipped before.
struct T { u32 v; }
u32 eat(*T p) { u32 v = p.v; free(p); return v; }
u32 main() {
    *T a = alloc(T) orelse return;
    a.v = 5;
    u32 y = @popcount(eat(a));
    *T c = alloc(T) orelse { free(a); return 0; };
    c.v = 99;
    u32 r = a.v;
    free(a);
    free(c);
    return r;
}
