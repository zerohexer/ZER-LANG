// BUG-1660, the handle form: the body allocates and frees its OWN handle under a
// name an enclosing (already freed) handle also has. The body's `pool.free(h)`
// was rebound to the enclosing handle, so this valid program was refused with
// "use after free: 'h_3'" and "double free" — errors about a variable the body
// never touches.
struct T { u32 a; }
Pool(T, 4) pool;

u32 work() {
    Handle(T) h = pool.alloc() orelse return;
    pool.free(h);
    {
        Handle(T) h = pool.alloc() orelse return;
        defer { ?Handle(T) mh = pool.alloc(); if (mh) |h| { pool.get(h).a = 9; pool.free(h); } }
        pool.get(h).a = 1;
        pool.free(h);
    }
    return 0;
}

u32 main() {
    if (work() != 0) { return 1; }
    // every slot is free again: four allocations must succeed
    u32 n = 0;
    for (u32 i = 0; i < 4; i += 1) {
        ?Handle(T) m = pool.alloc();
        if (m) |x| { n += 1; pool.free(x); }
    }
    if (n != 4) { return 2; }
    return 0;
}
