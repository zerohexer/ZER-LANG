// BUG-1318: regression (see BUGS-FIXED.md).
// var-decl form computes a * (f32)0.1 in float; the plain-assignment form emits
// `c = (a * 0.10000000000000001)` — computed in DOUBLE then rounded. Same source expression,
// two different answers. Expected exit 0; actual exit 1.
f32 id(f32 x) { return x; }
u32 main() {
    f32 a = id(1.00000012);
    f32 b = a * 0.1;
    f32 c = 0.0;
    c = a * 0.1;
    if (b != c) { return 1; }
    return 0;
}
