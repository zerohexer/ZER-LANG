// BUG-1273: an index in the RHS of && is evaluated only when the LHS holds.
// The auto-guard used to be HOISTED above the whole statement, so `i = 9`
// made f() return early (with 0) although `i < 4` is false and a[i] never runs.
u32 g = 0;
u32 f(u32 i) {
    u32[4] a;
    if (i < 4 && a[i] > 0) { return 1; }
    g = 7;
    return 5;
}
u32 main() {
    if (f(9) != 5) { return 1; }
    if (g != 7) { return 2; }
    return 0;
}
