// BUG-1332 boundary: a heap payload reached through &carrier is freed only
// after the join.
struct T { u32 v; }
struct H { *T p; }
void w(*H h) { h.p.v += 2; }
u32 main() {
    ?*T mp = alloc(T);
    *T p = mp orelse return;
    p.v = 40;
    H h = { .p = p };
    ThreadHandle th = spawn w(&h);
    th.join();
    u32 r = p.v;
    free(p);
    if (r != 42) { return 1; }
    return 0;
}
