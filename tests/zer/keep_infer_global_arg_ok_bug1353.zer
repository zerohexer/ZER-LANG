// BUG-1353 boundary: a global argument satisfies the inferred keep.
struct N { ?*u32 p; }
struct NN { N n; }
?*u32 g;
N gn;
N[2] garr;
NN gnn;
[*]u32 gsl;
*u32 id(*u32 p) { return p; }
?*u32 pp(*u32 p) { return p; }
[*]u32 sv([*]u32 s) { return s[0..1]; }
void put(*u32 p) { *u32 z = id(p); g = z; }
u32 gx;
u32 main() { put(&gx); return 0; }
