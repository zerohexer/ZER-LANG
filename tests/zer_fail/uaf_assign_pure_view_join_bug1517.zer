// expect-error: may be a view of 'a'
// BUG-1517: `out = got;` (assignment of a pure view) dropped the view; the
// var-decl spelling was refused.
struct T { u32 v; }
volatile u32 gk;
*T pick(*T x, *T y, u32 c) { if (c == 0) { return x; } return y; }
u32 main() {
    *T a = alloc(T) orelse return;
    *T c = alloc(T) orelse { free(a); return 1; };
    a.v = 7;
    *T got = pick(a, c, gk);
    ?*T out = null;
    out = got;
    free(a);
    *T b = alloc(T) orelse { free(c); return 1; };
    b.v = 99;
    u32 r = 0;
    if (out) |o| { r = o.v; }
    free(b);
    free(c);
    return r;
}
