// A real CAS spin lock (no break) around every access is accepted.
u32 g;
u32 la;
void w() {
    for (u32 i = 0; i < 1000; i += 1) {
        while (!@atomic_cas(&la, 0, 1)) { }
        g += 1;
        @atomic_store(&la, 0);
    }
}
u32 main() {
    ThreadHandle th = spawn w();
    for (u32 i = 0; i < 1000; i += 1) {
        while (!@atomic_cas(&la, 0, 1)) { }
        g += 1;
        @atomic_store(&la, 0);
    }
    th.join();
    if (g != 2000) { return 1; }
    return 0;
}
