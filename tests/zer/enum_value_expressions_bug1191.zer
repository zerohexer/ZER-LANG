// BUG-1191: an enum value may be any compile-time integer expression, and the value
// the checker reasons with is the value the program runs with. Pre-fix only a
// literal / `-N` was evaluated: the checker used 0, the emitter counted on from the
// previous variant — `j = 0 + 0` was proven index 0 and emitted 9 (an unchecked
// out-of-bounds write), and a switch dispatched on the wrong numbers.
const u32 BASE = 8;
enum E { a = 1 + 2, b, c = 1 << 4, d = BASE, e = (5) }
enum Cmd { get = 'G', put = 'P', del }
enum Late { l0, l1, l2, l3, l4, l5, l6, l7, l8, l9 = 0 + 0 }
static_assert(E.a == 3, "a");
static_assert(E.c == 16, "c");
u32 name(E x) {
    switch (x) {
        .a => { return 10; } .b => { return 11; } .c => { return 12; }
        .d => { return 13; } .e => { return 14; }
    }
}
u32[4] arr;
u32 main() {
    if ((i32)E.a != 3 || (i32)E.b != 4 || (i32)E.c != 16) { return 1; }
    if ((i32)E.d != 8 || (i32)E.e != 5) { return 2; }
    if ((i32)Cmd.get != 71 || (i32)Cmd.del != 81) { return 3; }
    if (name(E.c) != 12 || name(E.d) != 13) { return 4; }
    ?E t = @try_enum(E, 16);
    if (t == null) { return 5; }
    u32 k = (u32)Late.l9;          // 0, both at compile time and at run time
    arr[k] = 7;
    if (arr[0] != 7) { return 6; }
    return 0;
}
