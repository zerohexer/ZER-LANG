// BUG-1422 boundary: re-spawning a scoped ThreadHandle is fine once the previous
// thread was joined on EVERY path into the spawn — a for loop, and a backward
// goto whose loop body joins before jumping back.
void w(*u32 p) { *p += 1; }
u32 main() {
    u32 v = 0;
    for (u32 i = 0; i < 3; i += 1) {
        ThreadHandle th = spawn w(&v);
        th.join();
    }
    u32 i = 0;
again:
    ThreadHandle t2 = spawn w(&v);
    t2.join();
    i += 1;
    if (i < 3) { goto again; }
    if (v != 6) { return 1; }
    return 0;
}
