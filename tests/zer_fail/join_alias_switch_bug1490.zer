// EXPECTED: compile error
// expect-error: maybe-freed
// BUG-1490: the join of a switch arm that re-aims the pointer.
struct N { u32 v; }
u32 pick(u32 k) {
    *N a = alloc(N) orelse { return 1; };
    *N b = alloc(N) orelse { free(a); return 1; };
    a.v = 1; b.v = 2;
    *N p = a;
    switch (k) {
        0 => { }
        default => { p = b; }
    }
    free(p);
    *N r = alloc(N) orelse { free(b); return 1; };
    r.v = 99;
    u32 out = b.v;
    free(b);
    free(r);
    return out;
}
u32 main() { return pick(1); }
