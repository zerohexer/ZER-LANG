// BUG-1157: a struct literal whose field value is an ARRAY miscompiled, silently.
//  - a GLOBAL array or an array FIELD into a [*]T field lowered to no local
//    and was emitted as a literal `0` (r.s.len == 0, "none" for ?[*]T);
//  - any array into an ARRAY-typed field decayed to a pointer (`.arr = l`
//    put an address in arr[0]) or became `0`.
// Every value-flow form is exercised: var-decl, assignment, return, call arg.
struct R { [*]u32 s; }
struct Q { ?[*]u32 s; }
struct A { u32[2] arr; u32 tag; }
struct W { u32[4] arr; }
u32[4] ga;
u32[2] garr;
W gw;

R mk_ret() { gw.arr[1] = 5; return { .s = gw.arr }; }
u32 take(R r) { return (u32)r.s.len; }
A mk_arr() { u32[2] l; l[0] = 3; l[1] = 4; return { .arr = l, .tag = 1 }; }

u32 main() {
    R r = { .s = ga };
    if (r.s.len != 4) { return 1; }
    Q q = { .s = ga };
    [*]u32 qs = q.s orelse return;
    if (qs.len != 4) { return 2; }
    if (mk_ret().s[1] != 5) { return 3; }
    if (take({ .s = ga }) != 4) { return 4; }
    u32[2] l;
    l[1] = 9;
    garr[1] = 9;
    A a = { .arr = l, .tag = 2 };
    A b = { .arr = garr };
    A c;
    c = { .arr = l, .tag = 7 };
    if (a.arr[1] + b.arr[1] + c.arr[1] != 27) { return 5; }
    if (a.tag != 2 || c.tag != 7) { return 6; }
    A d = mk_arr();
    if (d.arr[0] != 3 || d.arr[1] != 4 || d.tag != 1) { return 7; }
    return 0;
}
