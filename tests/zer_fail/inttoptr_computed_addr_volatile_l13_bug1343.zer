// EXPECTED: compile error
// expect-error: cannot initialize non-volatile pointer from volatile
// BUG-1343: a COMPUTED @inttoptr address is range-checked into MMIO, so its result is volatile.
mmio 0x40000000..0x4000FFFF;
struct Regs { u32 ctrl; u32 status; }
void kick(u32 n) {
    *Regs u = @inttoptr(*Regs, 0x40000000 + n * 0x100);
    u.ctrl = 1;
    u.ctrl = 2;
    while (u.status == 0) { }
}
u32 main() { kick(1); return 0; }
