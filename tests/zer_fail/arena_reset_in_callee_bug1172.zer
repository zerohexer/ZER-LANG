// expect-error: use after free: 'p'
// BUG-1172: an arena reset inside a CALLEE was invisible to the caller; the
// next alloc returned the same bytes and the stale pointer read them.
struct T { u32 v; }
Arena gar;
u8[256] buf;
void rs() { gar.reset(); }
u32 main() {
    gar = Arena.over(buf);
    *T p = gar.alloc(T) orelse return;
    p.v = 5;
    rs();
    *T q = gar.alloc(T) orelse return;
    q.v = 9;
    return p.v;
}
