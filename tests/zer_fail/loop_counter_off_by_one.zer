// EXPECTED: compile error
// expect-error: loop provably performs an out-of-bounds access
// (from claude/loving-davinci-vgonmt a40104b8 = vigilant-tesla-v7pucv 8c8873d, body verbatim; its BUG-958 -> main BUG-992)
// `i <= 4` on a size-4 array — the classic off-by-one.
u32 main() {
    u32[4] arr;
    for (u32 i = 0; i <= 4; i += 1) { arr[i] = i; }
    return 0;
}
