// BUG-1015 (2026-09-13): an array index in a LOOP CONDITION was range-checked under
// the PRE-loop range. All three loop drivers ran check_expr(cond) BEFORE the body's
// writes were widened, so `u32 i = 0; while (arr[i] > 0) { i += n; }` proved `arr[i]`
// against `i in [0,0]`, marked it proven for good, and the emitted C read `arr[i]`
// with no bounds check, no auto-guard and no warning — ASan global-buffer-overflow on
// a 4-element array (the condition runs on EVERY iteration under the loop-carried
// value). BUG-748 had fixed exactly this for the BODY and never touched the condition.
//
// Every helper below walks its counter off the end of a 4-element array of ones.
// Post-fix each condition is unproven, gets the auto-guard, and the guard's early
// return yields the function's zero value (0) at i == 4. Pre-fix each helper read past
// the array and returned >= 4 (or crashed), so this file discriminates.
u32[4] arr;

void bump(*u32 p) { *p += 1; }

u32 w_body(u32 n)  { u32 i = 0; while (arr[i] > 0) { i += n; } return i; }
u32 w_const()      { u32 i = 0; while (arr[i] > 0) { i += 1; } return i; }
u32 w_assign(u32 n){ u32 i = 0; while (arr[i] > 0) { i = i + n; } return i; }
u32 dw_body(u32 n) { u32 i = 0; do { i += n; } while (arr[i] > 0); return i; }
u32 f_step()       { u32 i = 0; for (i = 0; arr[i] > 0; i += 1) { } return i; }
u32 f_body(u32 n)  { u32 i = 0; for (u32 k = 0; arr[i] > 0; k += 1) { i += n; } return i; }
u32 w_addr()       { u32 i = 0; while (arr[i] > 0) { bump(&i); } return i; }

// Boundaries: an index whose variable the body does NOT write keeps its proof
// (no guard fires — it returns 5), and a short-circuited `i < 4 &&` still stops the
// loop at 4 through the condition, not through the guard (the guard sits in the RHS
// block, which `i < 4` never enters at 4).
u32 w_notwritten() { u32 i = 0; u32 j = 0; while (arr[i] > 0) { j += 1; if (j > 4) { return 5; } } return 9; }
u32 w_shortcircuit() { u32 i = 0; while (i < 4 && arr[i] > 0) { i += 1; } return i; }

u32 main() {
    arr[0] = 1; arr[1] = 1; arr[2] = 1; arr[3] = 1;
    if (w_body(1) != 0)   { return 1; }
    if (w_const() != 0)   { return 2; }
    if (w_assign(1) != 0) { return 3; }
    if (dw_body(1) != 0)  { return 4; }
    if (f_step() != 0)    { return 5; }
    if (f_body(1) != 0)   { return 6; }
    if (w_addr() != 0)    { return 7; }
    if (w_notwritten() != 5)   { return 8; }
    if (w_shortcircuit() != 4) { return 9; }
    return 0;
}
