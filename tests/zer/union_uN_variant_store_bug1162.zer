// BUG-1162/1163/1164: the uN/iN store intercept ran before the union-tag and
// bit-slice cases and stored twice.
//  - `w.t = 5` into a u3 variant never set _tag (switch took `.n`);
//  - `x[2..1] = 3` on a u5 emitted invalid C;
//  - a volatile u12 compound store wrote the unmasked value, then re-masked.
union U { u32 n; u3 t; }
struct H { U u; }
volatile u12 reg;

u32 via_ptr(*U p) { p.t = 6; return 0; }

u32 main() {
    U w;
    w.n = 1;
    w.t = 5;
    switch (w) {
        .n => |v| { return 1; }
        .t => |v| { if (v != 5) { return 2; } }
    }
    H h;
    via_ptr(&h.u);
    switch (h.u) {
        .n => |v| { return 3; }
        .t => |v| { if (v != 6) { return 4; } }
    }
    u5 x = 0;
    x[2..1] = 3;
    if (x != 6) { return 5; }
    reg = 4095;
    reg += 1;
    if (reg != 0) { return 6; }
    u3 y = 7;
    y += 7;
    if (y != 6) { return 7; }
    return 0;
}
