// BUG-1402: the frame-bound taint is set textually AFTER the sink, but runs before it
// (loop back edge / goto / defer). Reproducer from the 2026-09-28 escape probe (L6).
// expect-error: cannot return pointer to local 'p' — stack memor
u32 g0 = 1;
*u32 f() {
    u32 x = 5;
    *u32 p = &g0;
    for (u32 i = 0; i < 2; i += 1) {
        if (i == 1) { return p; }
        p = &x;
    }
    return &g0;
}
u32 main() { return *f(); }
