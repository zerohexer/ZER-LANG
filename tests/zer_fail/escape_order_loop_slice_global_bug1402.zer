// BUG-1402: the frame-bound taint is set textually AFTER the sink, but runs before it
// (loop back edge / goto / defer). Reproducer from the 2026-09-28 escape probe (L7).
// expect-error: cannot store local-derived pointer 's' in global/s
u32[4] gz;
[*]u32 gs;
void f() {
    u32[4] x;
    x[0] = 5;
    [*]u32 s = gz[0..4];
    for (u32 i = 0; i < 2; i += 1) {
        gs = s;
        s = x[0..4];
    }
}
u32 main() { gs = gz[0..4]; f(); return gs[0]; }
