// BUG-1292: an await condition's auto-guard must run on EVERY poll. It was
// emitted before the resume label, so the second poll (g_i = 4) jumped past it
// and read g_arr[4] (here: pad[0], zero -> "still waiting"). Guarded, the task
// ends (the guard's early exit completes the task) instead.
u32[4] g_arr;
u32[4] pad;
u32 g_i;
async void waiter() {
    await g_arr[g_i] != 0;
}
u32 main() {
    _zer_async_waiter task;
    _zer_async_waiter_init(&task);
    g_i = 1;
    if (_zer_async_waiter_poll(&task) != 0) { return 1; }
    g_i = 4;
    if (_zer_async_waiter_poll(&task) != 1) { return 2; }
    return 0;
}
