// BUG-1017 precision half: the STEP is checked under the COND-NARROWED range,
// not a fully-widened one, so an index the loop bound already proves safe keeps
// its zero-overhead elision.
//
// `for (j = 0; j < 4; j += a[j])` reads a[j] with j in [0,3] on a u32[4] — in
// range by the loop bound itself. No warning, no guard.
//
// Also pins that the BODY keeps its narrow [init, bound-1] range: checking the
// step re-widens the counter as a side effect, so the step check is wrapped in a
// range snapshot/restore. `s += a[i]` in the first loop must stay guard-free.
u32 main() {
    u32[4] a;
    a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    u32 s = 0;
    for (u32 i = 0; i < 4; i += 1) {
        s += a[i];          // body: proven by the loop bound
    }
    for (u32 j = 0; j < 4; j += a[j]) {
        s += 1;             // step a[j]: proven by the loop bound
    }
    // 1+2+3+4 = 10, then j = 0 -> 1 -> 3 -> 7 is three iterations = 13
    if (s != 13) { return 1; }
    return 0;
}
