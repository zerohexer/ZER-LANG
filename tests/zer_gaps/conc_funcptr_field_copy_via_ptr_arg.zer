// GAP (2026-11-13 audit, docs/limitations.md): a callback loaded from a struct reached through a spawn POINTER argument and called through a local copy escapes the race scan (TSan)
u32 g;
void bump() { for (u32 i = 0; i < 100000; i += 1) { g += 1; } }
struct O { *() f; }
void w(*O p) { *() f = p.f; f(); }
u32 main() {
    O o = { .f = bump };
    ThreadHandle th = spawn w(&o);
    bump();
    th.join();
    return 0;
}
