// EXPECTED: compile error
// expect-error: lock is not re-entrant
// (BUG-1609: `g.cb = f` is a write of part of `g`, so the call now resolves to
// every function of the field's signature and the diagnostic names the real
// defect — the callee takes S again — rather than "the target is not known".)
// BUG-980b (from claude/loving-davinci-vgonmt, body verbatim): the funcptr is a FIELD of the shared(rw) struct itself —
// `g.cb()` reads the field under g's write lock and calls through it while the
// lock is held (the BUG-795 callee-position form). A callback that touches g
// re-enters the rwlock.
shared(rw) struct S { *() -> u32 cb; u32 v; }
S g;
u32 f() { g.v = 2; return 1; }
u32 main() { g.cb = f; u32 r = g.cb(); return r - 1; }
