// BUG-1366 boundary: a store / reset / read through a pointer that can only
// designate one object is the same operation as through the object's name.
struct T { u32 v; }
?*T slot;
*?*T gpp = &slot;
u32 rd() { if (slot) |p| { return p.v; } return 0; }
u32 main() {
    ?*T loc = null;
    *?*T lp = &loc;
    *T a = alloc(T) orelse return;
    a.v = 7;
    *lp = a;
    u32 r = 0;
    if (*lp) |q| { r = q.v; }
    if (loc) |q| { free(q); }
    *lp = null;
    *T b = alloc(T) orelse return;
    b.v = 5;
    *gpp = b;
    r += rd();
    free(b);
    *gpp = null;
    r += rd();
    if (r != 12) { return 1; }
    return 0;
}
