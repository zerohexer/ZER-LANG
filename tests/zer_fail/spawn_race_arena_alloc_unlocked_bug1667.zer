// expect-error: both access non-shared global 'ar'
// BUG-1667: `ar.alloc(T)` moves the Arena's bump offset. Two threads carving from one Arena with no lock
// can be handed the SAME bytes.
u32 flagx;
struct T { u32 v; }
u8[4096] backing;
Arena ar;
void w() {
    @atomic_store(&flagx, 1);
    for (u32 r = 0; r < 50; r += 1) { ?*T mp = ar.alloc(T); if (mp) |p| { p.v = r; } }
}
i32 main() {
    ar = Arena.over(backing);
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w();
    a.join(); b.join();
    return 0;
}
