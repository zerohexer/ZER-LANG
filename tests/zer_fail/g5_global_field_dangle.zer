// EXPECTED: compile error
// G5 (2026-07-27): a heap pointer stored into a struct-GLOBAL FIELD
// (`g.p = n`) then freed leaves g.p dangling at function exit. The
// bare-ident global-dangle check (BUG-739) matched only `g = n`; the
// `.field` projection sink was missed (per-sink patchwork). Now the
// full projection key `g.p` is tracked as an IR_GLOBAL_ROOT_ID compound
// entry, so the shared alloc_id carries FREED to it and the exit check
// fires. Cross-thread amplification (shared-struct field + worker read)
// would be a silent cross-thread UAF on a reused slab slot.
struct Item { u32 value; }
struct Holder { ?*Item p; }
Slab(Item) heap;
Holder g;
i32 main() {
    *Item n = heap.alloc_ptr() orelse return;
    n.value = 99;
    g.p = n;               // escape via global struct FIELD store
    heap.free_ptr(n);      // free local n; g.p now dangles
    return 0;
}
