// EXPECTED: compile error
// expect-error: overwritten while alive
// BUG-1072 (H10): `b = a` over a live `b` dropped the only reference to b's
// allocation. The overwrite check fired only for `b = alloc(...)`, not for the
// alias-assignment spelling. Pre-fix: compiled, LSan leak.
u32 main() {
    [*]u32 a = alloc(u32, 4) orelse return;
    defer free(a);
    [*]u32 b = alloc(u32, 4) orelse return;
    b = a;
    b[0] = 1;
    return 0;
}
