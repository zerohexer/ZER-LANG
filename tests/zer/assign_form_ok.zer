// BUG-933 BOUNDARY POSITIVE: the ASSIGN spelling now registers allocations and
// transfers, so this file pins what must STILL compile — otherwise the widening
// is an over-rejection wearing a bug fix.
struct Device { u32 id; }
Pool(Device, 4) pool_a;
move struct Tok { u32 fd; }
struct P { u32 x; }
u32 res;

void alloc_assign_then_free() {
    ?Handle(Device) mh;
    mh = pool_a.alloc();
    Handle(Device) h = mh orelse return;
    pool_a.get(h).id = 7;
    res += pool_a.get(h).id;
    pool_a.free(h);
}

void move_assign_use_dest() {
    Tok a; a.fd = 3;
    Tok b;
    b = a;
    res += b.fd;              // the DESTINATION is live after a move
}

void move_out_of_array_use_dest() {
    Tok[2] arr; arr[0].fd = 5;
    Tok b;
    b = arr[0];
    res += b.fd;
}

void plain_array_copy_is_not_a_move() {
    P[2] a; a[0].x = 4;
    P b;
    b = a[0];
    res += a[0].x + b.x;      // NOT a move struct — both stay usable
}

u32 main() {
    alloc_assign_then_free();
    move_assign_use_dest();
    move_out_of_array_use_dest();
    plain_array_copy_is_not_a_move();
    if (res != 7 + 3 + 5 + 8) { return 1; }
    return 0;
}
