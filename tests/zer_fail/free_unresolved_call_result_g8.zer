// expect-error: use after free: 'a' is maybe-freed
// BUG-1574: free(call(...)) whose result names several params / a field of a by-value struct freed nothing.
struct T { u32 v; }
struct H { *T p; *T q; }
*T getq(H h) { return h.q; }
u32 main() {
    *T a = alloc(T) orelse return;
    a.v = 7;
    H h = { .p = a, .q = a };
    free(getq(h));
    *T b = alloc(T) orelse { free(a); return 1; };
    b.v = 99;
    u32 r = a.v;
    free(b);
    free(a);
    return r;
}
