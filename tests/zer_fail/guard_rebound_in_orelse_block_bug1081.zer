// EXPECTED: compile error
// expect-error: use after free
// BUG-1081: BUG-1055's "does this guard NAME denote ONE binding?" walk stopped at
// expressions, so a second `bool c` declared inside an orelse-BLOCK fallback was
// not counted. The two `c`s share one IR local; the Level-B relaxation treated
// `if (c) free(a)` and `if (!c) a.v` as disjoint and accepted the read (x=1, y=2:
// both guards take the unsafe side). Pre-fix only a leak was reported, not the UAF.
struct T { u32 v; }
?u32 none() { return null; }
u32 run(u32 x, u32 y) {
    *T a = alloc(T) orelse return;
    a.v = 7;
    { bool c = x == 1; if (c) { free(a); } }
    u32 z = none() orelse {
        bool c = y == 1;
        if (!c) { u32 r = a.v; free(a); return r; }
        return 0;
    };
    return z;
}
u32 main() { return run(1, 2); }
