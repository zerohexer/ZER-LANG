// EXPECTED: compile error
// expect-error: may be a view of
// BUG-1075 (H5): a multi-param return view (`pick(d, a, c)` may return either) was
// honoured only by ir_check_ident_uaf; a FIELD READ through the view after one of
// its members was freed was accepted. Pre-fix: compiled, read freed memory.
struct T { u32 v; }
*T pick(*T x, *T y, bool c) { if (c) { return x; } return y; }
u32 main() {
    *T a = alloc(T) orelse return;
    *T d = alloc(T) orelse { free(a); return 1; };
    a.v = 7;
    *T c = pick(d, a, false);
    free(a);
    u32 r = c.v;
    free(d);
    return r;
}
