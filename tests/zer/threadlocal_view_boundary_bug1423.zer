// BUG-1423/1424 boundary: what a threadlocal may still be used for. Only its
// ADDRESS escaping (to a global, through a pointer parameter, into a keep
// parameter) is refused; reading it, viewing it locally, copying its VALUE out,
// passing it to a borrowing helper and keeping the view in another threadlocal
// all remain legal. (A spawned fill would trip the unrelated global-race
// rule on garr / g, masking what this file pins.)
struct O { u32 x; u32[4] arr; ?*u32 p; }
threadlocal u32[4] tla;
threadlocal u32 tl1;
threadlocal ?[*]u32 tl_view;
threadlocal ?*u32 tl_ptr;
u32 g = 5;
u32[4] garr;
u32 sum([*]u32 s) { u32 t = 0; for (u32 i = 0; i < s.len; i += 1) { t += s[i]; } return t; }
*u32 pass(*u32 p) { return p; }
void fill(*O out) {
    tla[0] = 1; tla[1] = 2; tla[2] = 3; tla[3] = 4;
    out.x = tla[1];                 // a VALUE read
    out.arr = tla;                  // an array VALUE copy, not a view
    garr = tla;                     // same, into a global
    [*]u32 s = tla[1..3];           // a local view
    out.x += sum(s) + sum(tla);     // borrowed by a non-keep helper
    tl_view = tla;                  // kept in ANOTHER threadlocal: same thread
    tl_ptr = &g;
    out.p = tl_ptr;                 // the VALUE of a threadlocal pointer (&g)
    *u32 q = pass(&tl1);            // a call-laundered TLS address used locally
    *q = 7;
    out.x += tl1;
}
u32 main() {
    O o;
    fill(&o);          // the rules are the same in any thread; main is one
    if (o.x != 2 + 5 + 10 + 7) { return 1; }
    if (o.arr[3] != 4) { return 2; }
    if (garr[2] != 3) { return 3; }
    if (o.p) |p| { if (*p != 5) { return 4; } } else { return 5; }
    return 0;
}
