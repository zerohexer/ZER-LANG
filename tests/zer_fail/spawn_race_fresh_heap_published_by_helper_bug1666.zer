// expect-error: reached through a reference the compiler cannot name
// BUG-1666, the own-heap rule: a call argument is a way out. `stash(buf)` keeps the reference in a global;
// the writer goes on writing through `buf` unlocked while the reader writes through the kept copy.
u32 flagx;
u32 lk;
struct Hold { ?[*]u32 s; }
Hold gh;
void stash(keep [*]u32 s) { while (!@atomic_cas(&lk, 0, 1)) { } gh.s = s; @atomic_store(&lk, 0); }
void wr() {
    @atomic_store(&flagx, 1);
    [*]u32 buf = alloc(u32, 64) orelse return;
    stash(buf);
    for (u32 r = 0; r < 100000; r += 1) { buf[0] += 1; }
}
void rd() {
    @atomic_store(&flagx, 1);
    for (u32 r = 0; r < 100000; r += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        ?[*]u32 m = gh.s;
        @atomic_store(&lk, 0);
        if (m) |s| { s[0] += 1; }
    }
}
i32 main() {
    ThreadHandle a = spawn wr();
    ThreadHandle b = spawn rd();
    a.join(); b.join();
    return 0;
}
