// BUG-1241 positive: reset the carried field after the free
struct Box { u32 v; }
struct S { ?*Box b; }
void init(*S s, *Box b) { s.b = b; }
u32 peek(*S s) { if (s.b) |b| { return b.v; } return 0; }
u32 main() {
    *Box p = alloc(Box) orelse return;
    p.v = 4;
    S t;
    init(&t, p);
    u32 r = peek(&t);
    free(p);
    t.b = null;
    if (peek(&t) != 0) { return 2; }
    if (r != 4) { return 1; }
    return 0;
}
