// Promoted from tests/zer_gaps/audit2026-05-24_bool_int_cast.zer (2026-11-13): filed as a gap, measured correct.
// An explicit (bool) cast is !!n and (u32) of a bool is 0/1 — no cast can forge a bool
// holding 42 (docs/reference.md "bool casts"). Implicit bool<->int stays an error.
u32 main() {
    u32 k = 42;
    for (u32 i = 0; i < 1; i += 1) { k = 42; }
    bool b2 = (bool)k;
    u32 n = (u32)b2;
    if (n != 1) { return 1; }
    return 0;
}
