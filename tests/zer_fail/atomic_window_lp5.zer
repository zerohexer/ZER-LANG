// expect-error: plain access to 'g' in a concurrent context
// BUG-1589: the concurrent window opened only at a spawn written earlier in the SAME function.
u32 g;
u32 done;
void worker() {
    for (u32 i = 0; i < 1000000; i += 1) { @atomic_add(&g, 1); }
    @atomic_add(&done, 1);
}
u32 main() {
    for (u32 r = 0; r < 2; r += 1) {
        for (u32 i = 0; i < 1000000; i += 1) { g = g + 5; }
        spawn worker();
    }
    while (@atomic_load(&done) < 2) { }
    if (@atomic_load(&g) != 12000000) { return 1; }
    return 0;
}
