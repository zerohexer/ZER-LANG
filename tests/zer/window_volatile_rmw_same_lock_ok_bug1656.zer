// BUG-1656: the spawner's read-modify-write of a volatile flag was refused whenever
// a thread stores the flag — lock or no lock. Under the lock every store of it
// holds, it is exact: 1000 thread increments + 1000 spawner increments, none lost.
volatile u32 g;
u32 lk;
void w() {
    for (u32 i = 0; i < 1000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        u32 t = g;
        g = t + 1;
        @atomic_store(&lk, 0);
    }
}
u32 main() {
    ThreadHandle a = spawn w();
    for (u32 i = 0; i < 1000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        g += 1;
        @atomic_store(&lk, 0);
    }
    a.join();
    if (g != 2000) { return 1; }
    return 0;
}
