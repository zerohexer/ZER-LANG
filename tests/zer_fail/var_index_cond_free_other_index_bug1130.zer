// EXPECTED: compile error
// expect-error: maybe-freed
// BUG-1130 (2): the same through a DIFFERENT index — j may equal k. Pre-fix: compiled.
struct T { u32 v; }
u32 run(u32 k, u32 j, bool c) {
    if (k >= 4) { return 0; }
    if (j >= 4) { return 0; }
    ?*T[4] arr;
    *T a = alloc(T) orelse return;
    arr[k] = a;
    if (c) { free(a); }
    *T q = arr[j] orelse return;
    return q.v;
}
u32 main() { return run(1, 1, true); }
