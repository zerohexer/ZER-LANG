// BUG-1570 boundary: a task declared in the same block as its pointee.
async void rd(*u32 p) { yield; *p += 1; }
u32 main() {
    u32 y = 1;
    { _zer_async_rd t; u32 x = 7; _zer_async_rd_init(&t, &x); _zer_async_rd_poll(&t); _zer_async_rd_poll(&t); y = x; }
    _zer_async_rd t2;
    _zer_async_rd_init(&t2, &y);
    while (_zer_async_rd_poll(&t2) == 0) { }
    return y - 9;
}
