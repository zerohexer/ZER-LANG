// expect-error: both access non-shared global 'pl'
// BUG-1667: `pl.alloc()` / `pl.free(h)` rewrite the Pool's used map and generation table. The context walk
// recorded only the READ of the receiver's name that walking the callee makes, so two threads allocating
// from one Pool met as two readers. (Without the @atomic the spawn scan refuses this outright; the @atomic
// downgrades that finding and hands the judgement to the walk.) TSan: data race on the pre-fix compiler.
u32 flagx;
struct Node { u32 v; }
Pool(Node, 8) pl;
void w() {
    @atomic_store(&flagx, 1);
    for (u32 r = 0; r < 20000; r += 1) { Handle(Node) h = pl.alloc() orelse return; pl.free(h); }
}
i32 main() {
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w();
    a.join(); b.join();
    return 0;
}
