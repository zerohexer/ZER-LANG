// G5 conservatism guard: the exit-dangle check must flag only a DEFINITELY-freed
// global projection. Here the allocation is freed on ONE path only, so at the
// return g.p is MAYBE dangling. Must COMPILE — this pins the BUG-742 tolerance
// (MAYBE_FREED globals are deliberately not flagged, so the legit
// register-ctx-then-callback pattern is not noised) against the new field sink.
// (BUG-1071: the earlier spelling freed and RETURNED inside the branch without a
// reset — a DEFINITE dangle on that path, invisible only because early-exit
// returns were not checked.)
struct Node { u32 x; }
struct Holder { ?*Node p; }
Holder g;
u32 main() {
    ?*Node mn = alloc(Node);
    *Node n = mn orelse return;
    g.p = n;
    if (n.x == 7) { free(n); }
    return 0;
}
