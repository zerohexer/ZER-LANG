// BUG-1529: an explicit slice of a volatile array was typed as a plain slice and
// emitted `_zer_slice_u8` for a `volatile [*]u8` parameter (GCC refused it).
volatile u8[4] hw;
u32 read_hw(volatile [*]u8 regs) {
    return @truncate(u32, regs[0]);
}
u32 main() {
    hw[0] = 42;
    u32 r = read_hw(hw[0..]); if (r != 42) { return 1; } return 0;
}
