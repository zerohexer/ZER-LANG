// expect-trap
// BUG-1430: f's return range was summarised from the stale [1,1] that resurfaced
// after `i = get(5)` hit only the guard's narrowing; arr[f(1)] was "proven" and
// stored at arr[5]. The index is now checked and traps.
u32 get(u32 a) { return a; }
u32 f(u32 i) { if (i < 4) { if (i < 2) { i = get(5); } return i; } return 0; }
u32 main() { u32[4] arr; arr[f(1)] = 7; return arr[0]; }
