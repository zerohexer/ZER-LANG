// EXPECTED: compile error
// expect-error: 'a' is maybe-freed
// BUG-1410: a callee freeing a field of an element argument (drop(hs[i])) must reach hs[0].p
struct T { u32 v; }
struct H { *T p; u32 k; }
void drop(H h) { free(h.p); }
u32 main() {
    *T a = alloc(T) orelse return;
    H[2] hs;
    hs[0] = { .p = a, .k = 1 };
    u32 i = 0;
    drop(hs[i]);                                  // frees a
    *T b = alloc(T) orelse { free(a); return 1; };
    b.v = 99;
    u32 r = a.v;                                  // stale: 99
    free(b);
    free(a);
    return r;
}
