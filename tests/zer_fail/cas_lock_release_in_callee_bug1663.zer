// expect-error: is not treated as a lock
// BUG-1663: a callee releases the lock inside the region.
volatile u32 g;
u32 lk;
void w() {
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        g += 1;
        @atomic_store(&lk, 0);
    }
}
void unl() { @atomic_store(&lk, 0); }
u32 main() {
    ThreadHandle a = spawn w();
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        unl();
        g += 1;
        @atomic_store(&lk, 0);
    }
    a.join();
    if (g != 400000) { return 1; }
    return 0;
}
