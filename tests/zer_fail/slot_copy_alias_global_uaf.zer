// expect-error: use after free
// BUG-985: the GLOBAL-target sibling of the slot-to-slot copy. Before, the
// store cleared the global projection (untracked source) instead of aliasing.
struct T { u32 v; }
struct H { ?*T p; }
H g;
u32 main() {
    H a;
    a.p = alloc(T);
    g.p = a.p;
    *T q = a.p orelse return;
    free(q);
    *T r = g.p orelse return;
    return r.v;
}
