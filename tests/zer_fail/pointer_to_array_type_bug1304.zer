// EXPECTED: compile error
// expect-error: pointer to an array type
// BUG-1304: `*u32[4]` was accepted as a param / local type and reached GCC as
// `uint32_t[4]* p` (not C). Now refused at the ZER line.
u32 sum(*u32[4] p) { u32[4] c = *p; return c[0] + c[3]; }
u32 main() {
    u32[4] a;
    a[0] = 1; a[3] = 2;
    *u32[4] q = &a;
    if (sum(q) != 3) { return 1; }
    return 0;
}
