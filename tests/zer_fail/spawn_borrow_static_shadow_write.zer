// expect-error: cannot write through 'r2' — it points into 'v', which is borrowed
// BUG-1569: a write through an alias under a shadowing static resolved the root to the static.
void w(*u32 p) { for (u32 i = 0; i < 100000; i += 1) { *p += 1; } }
u32 main() {
    u32 v = 0; *u32 r = &v; *u32 r2 = &v;
    ThreadHandle th = spawn w(r);
    { static u32 v = 0; for (u32 i = 0; i < 100000; i += 1) { *r2 += 1; } }
    th.join();
    if (v != 200000) { return 1; } return 0;
}
