// BUG-1554 boundary: pointers that stay within the lifetime of what they point
// at — an alias declared inner but aimed OUTWARD, a pointer used inside its block,
// nested blocks reading an enclosing local, a parameter.
u32 rd(*u32 q) { u32 r = 0; { u32 t = *q; r = t; } return r; }
u32 main() {
    u32 r = 0;
    { u32 x = 7; *u32 q = &x; r = *q; }
    u32 base = 3; *u32 p = &base;
    { *u32 q2 = &base; p = q2; }
    { u32 z = 2; *u32 pz = &z; r += *pz; }
    { u32 x = 1; *u32 px = &x; { u32 y = 2; r += *px + y; px = &x; } r += *px; }
    return r + *p + rd(&base) - 19;
}
