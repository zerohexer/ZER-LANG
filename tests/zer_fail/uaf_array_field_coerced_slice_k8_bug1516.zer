// expect-error: use after free
// BUG-1516 sibling sink of the implicit array->slice view (see uaf_array_field_coerced_slice_bug1516).
struct T { u32 v; u32[4] arr; }
struct V { [*]u32 s; }
u32 main() {
    *T a = alloc(T) orelse return;
    a.arr[2] = 7;
    V w = { .s = a.arr };
    free(a);
    *T b = alloc(T) orelse return;
    b.arr[2] = 99;
    u32 r = w.s[2];
    free(b);
    return r;
}
