// BUG-920 — VRP narrows from a short-circuit LHS into its RHS.
//
// `if (i < 4 && arr[i] > 0)` is the canonical guarded-access idiom and the exact
// shape the auto-guard warning tells users to write, yet the index used to be
// unprovable there: the nested-if spelling of the same program compiled to a bare
// access and the `&&` spelling carried a runtime guard.
//
// This test is about BEHAVIOUR, not the guard — every cell must produce the right
// answer, including the ones where the narrowing must NOT apply. The precision
// half is measured separately (auto-guard warnings on a fixed array: 6 before, 1
// after, the survivor being `!=`, which describes a hole rather than an interval).
//
// Each risky cell lives in its own helper, because an auto-guard on an out-of-range
// access inserts an early return — put those in `main` and the test would "pass" by
// skipping every later check. `g.tail` is the canary: it sits directly after the
// array, so an elided guard shows up as a changed value rather than as a crash.

struct Frame { u32[4] a; u32 tail; }
Frame g;

u32 gi = 0;
u32 setg() { gi = 9; return 1; }
u32 bump(*u32 p) { *p = 9; return 1; }
volatile u32 v_nine = 9;
u32 wild() { return v_nine; }   // unprovable: a volatile read

// --- the narrowing applies: the RHS runs only when the LHS held ---
u32 in_range_and() {
    u32 i = 3;
    if (i < 4 && g.a[i] == 11) { return 1; }
    return 0;
}
u32 in_range_const_left() {
    u32 i = 3;
    if (4 > i && g.a[i] == 11) { return 1; }
    return 0;
}
u32 in_range_eq() {
    u32 k = 0;
    if (k == 0 && g.a[k] == 7) { return 1; }
    return 0;
}

// --- the LHS is false, so the RHS must never run ---
u32 lhs_false_and() {
    u32 j = wild();                       // 9
    if (j < 4 && g.a[j] > 0) { return 1; }
    return 0;
}
// --- a `||` whose LHS is TRUE: the RHS must never run ---
u32 lhs_true_or() {
    u32 j = wild();                       // 9, so `j >= 4` holds
    if (j >= 4 || g.a[j] > 0) { return 1; }
    return 0;
}

// --- the narrowing must NOT survive a value change inside the RHS ---
void alias_write_in_rhs() {
    u32 m = 0;
    if (m < 4 && bump(&m) == 1 && g.a[m] > 0) { }   // m is 9 at the index
}
void global_write_in_rhs() {
    gi = 0;
    if (gi < 4 && setg() == 1 && g.a[gi] > 0) { }   // a call changed the global
}
// --- a `||` RHS runs when the LHS is FALSE: the fact there is the INVERSE ---
void or_rhs_takes_inverse() {
    u32 n = wild();                       // 9
    if (n < 4 || g.a[n] > 0) { }          // RHS runs with n >= 4
}
// --- the fact must not leak past the operator ---
void no_leak_past_operator() {
    u32 q = wild();                       // 9
    if (q < 4 && q > 0) { }
    g.a[q] = 999;                         // still guarded
}
// --- a volatile LHS must not narrow: it can change between check and use ---
void volatile_lhs() {
    if (v_nine < 4 && g.a[v_nine] > 0) { }
}
// --- a SIGNED index: `si < 4` gives [MIN, 3], which still includes negatives, so
//     the narrowing must not prove it. push_var_range clamps min to 0 only for an
//     unsigned type — that clamp is what makes the unsigned cells above provable
//     and its absence is what keeps this one guarded. ---
struct SFrame { i32[4] a; i32 tail; }
SFrame sg;
volatile i32 v_neg = -3;
i32 wild_s() { return v_neg; }
void signed_lhs() {
    i32 si = wild_s();
    if (si < 4 && sg.a[si] > 0) { }
}

// --- BUG-920b: the ELSE branch runs EXACTLY when the condition is false, so the
//     inverse holds throughout it. `if (i >= 4) {} else { a[i] }` used to carry a
//     guard the equivalent `if (i < 4) { a[i] }` does not. The index here is in
//     range and the else really runs, so an unsound narrowing shows up as a
//     corrupted canary rather than as a skipped branch. ---
volatile u32 v_two = 2;
u32 wild2() { return v_two; }
u32 else_inverse() {
    u32 i = wild2();              // 2
    if (i >= 4) { return 0; } else { g.a[i] = 42; }
    return 1;
}

// --- the same narrowing satisfies the DIVISION guard, and there the pre-fix
//     behaviour was not a runtime check but a HARD COMPILE ERROR: `if (d != 0 &&
//     100 / d > 0)` did not build at all, while the nested-if spelling did. ---
u32 div_guarded() {
    u32 d = wild();               // 9
    u32 t = 0;
    if (d != 0 && 100 / d > 0) { t += 1; }
    return t;
}

u32 main() {
    g.tail = 5;
    g.a[0] = 7; g.a[3] = 11;

    if (in_range_and() != 1)        { return 1; }
    if (in_range_const_left() != 1) { return 2; }
    if (in_range_eq() != 1)         { return 3; }
    if (lhs_false_and() != 0)       { return 4; }
    if (lhs_true_or() != 1)         { return 5; }

    alias_write_in_rhs();     if (g.tail != 5) { return 6; }
    global_write_in_rhs();    if (g.tail != 5) { return 7; }
    or_rhs_takes_inverse();   if (g.tail != 5) { return 8; }
    no_leak_past_operator();  if (g.tail != 5) { return 9; }
    volatile_lhs();           if (g.tail != 5) { return 10; }

    sg.tail = 6;
    signed_lhs();             if (sg.tail != 6) { return 13; }

    if (else_inverse() != 1) { return 14; }
    if (g.a[2] != 42)        { return 15; }
    if (g.tail != 5)         { return 16; }
    if (div_guarded() != 1)  { return 17; }

    // the array itself must be untouched by any of the above
    if (g.a[0] != 7)  { return 11; }
    if (g.a[3] != 11) { return 12; }
    return 0;
}
