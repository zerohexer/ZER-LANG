// GAP (2026-11-13 audit, docs/limitations.md): a free through a getter returning the ADDRESS of a global is not attributed to the global (exit 99)
struct T { u32 v; }
struct H { ?*T p; }
H g_h;
*H geth() { return &g_h; }
u32 main() {
    *T a = alloc(T) orelse return;
    g_h.p = a;
    *T q = geth().p orelse return;
    free(q);
    g_h.p = null;
    *T b = alloc(T) orelse return;
    b.v = 5;
    a.v = 99;
    u32 r = b.v;
    free(b);
    return r;
}
