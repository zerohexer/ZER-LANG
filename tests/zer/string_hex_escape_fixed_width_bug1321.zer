// BUG-1321: regression (see BUGS-FIXED.md).
// ZER lexes "\x41" + "b" as two bytes ('A','b'); the emitter copies the escape text verbatim into C,
// where a hex escape is GREEDY: "\x41b" is ONE char 0x41b (GCC warns "hex escape sequence out of range" / truncates).
// Expected exit 0.
u32 main() {
    const [*]u8 s = "\x41b";
    if (s.len != 2) { return 1; }
    if (s[0] != 65) { return 2; }
    if (s[1] != 'b') { return 3; }
    const [*]u8 t = "\x00a";
    if (t.len != 2) { return 4; }
    if (t[1] != 'a') { return 5; }
    return 0;
}
