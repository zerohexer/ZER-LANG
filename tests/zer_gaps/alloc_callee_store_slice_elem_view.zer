// GAP (2026-11-13 audit, docs/limitations.md): a callee stores its param through a view of a slice element; the caller frees it while the slot holds it (exit 99)
struct T { u32 v; }
struct H { ?*T p; }
void link([*]H s, *T p) { *H h = &s[1]; h.p = p; }
u32 main() {
    *T a = alloc(T) orelse return;
    H[2] hs;
    link(hs, a);
    free(a);
    *T b = alloc(T) orelse return;
    b.v = 5;
    if (hs[1].p) |z| { z.v = 99; }
    u32 r = b.v;
    free(b);
    return r;
}
