// BUG-1556: a container stamp is a type argument to @size / @offset / alloc / arena.alloc
container Box(T) { T v; u32 n; }
struct P { u32 a; }
Arena ar;
u8[256] backing;
u32 main() {
    ar = Arena.over(backing);
    usize s = @size(Box(u32));
    if (s != 8) { return 1; }
    usize o = @offset(Box(u32), n);
    if (o != 4) { return 2; }
    ?*Box(u32) b = alloc(Box(u32));
    if (b) |p| { p.v = 3; u32 r = p.v; free(p); if (r != 3) { return 3; } } else { return 4; }
    ?[*]Box(P) bs = alloc(Box(P), 3);
    if (bs) |q| { q[2].v.a = 7; u32 r2 = q[2].v.a; free(q); if (r2 != 7) { return 5; } } else { return 6; }
    ?*Box(u64) ab = ar.alloc(Box(u64));
    if (ab) |x| { x.v = 9; if (x.v != 9) { return 7; } } else { return 8; }
    ?[*]Box(u32) as2 = ar.alloc_slice(Box(u32), 2);
    if (as2) |y| { y[1].n = 4; if (y[1].n != 4) { return 9; } } else { return 10; }
    ?*Box(Box(u32)) nb = alloc(Box(Box(u32)));
    if (nb) |z| { z.v.v = 11; u32 r3 = z.v.v; free(z); if (r3 != 11) { return 11; } } else { return 12; }
    return 0;
}
