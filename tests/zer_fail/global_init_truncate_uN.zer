// @truncate to a NON-NATIVE uN emits a masking statement-expression (illegal at
// file scope). @truncate to a native width still folds to a constant cast and is
// allowed. (2026-08-09.)
const u3 MODE = @truncate(u3, 0xFF);
u32 main() { if ((u32)MODE != 7) { return 1; } return 0; }
