// EXPECTED: compile error
// G5 variant: projection through an array-of-struct global (`g[0].slots`).
// Same class as g5_global_field_dangle — the compound projection key is
// "g[0].slots", tracked via IR_GLOBAL_ROOT_ID.
struct Item { u32 value; }
struct Holder { ?*Item slots; }
Slab(Item) heap;
Holder[2] g;
i32 main() {
    *Item n = heap.alloc_ptr() orelse return;
    n.value = 99;
    g[0].slots = n;
    heap.free_ptr(n);
    return 0;
}
