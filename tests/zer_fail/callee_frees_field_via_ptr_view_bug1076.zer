// EXPECTED: compile error
// expect-error: use after free
// BUG-1076 (H4): the callee frees a FIELD of its pointer param, and the caller passed
// a pointer VIEW (`*H hp = &h; zap(hp);`), not `&h` itself — the summary's field free
// was keyed on hp, which has no `.p` entry, so `h.p` stayed ALIVE. Pre-fix: exit 99.
struct T { u32 v; }
struct H { *T p; }
void zap(*H h) { free(h.p); }
u32 main() {
    *T a = alloc(T) orelse return;
    a.v = 7;
    H h = { .p = a };
    *H hp = &h;
    zap(hp);
    *T b = alloc(T) orelse { free(a); return 1; };
    b.v = 99;
    u32 r = h.p.v;
    free(b);
    free(a);
    return r;
}
