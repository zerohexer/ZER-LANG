// EXPECTED: compile error
// expect-error: use after free
// BUG-1350: pick(id(a), a) returns param 0, which is id(a), which is a.
struct T { u32 v; }
*T id(*T p) { return p; }
?*T maybe(*T p) { return p; }
*T pick(*T p, *T q) { return p; }
u32 main() {
    *T a = alloc(T) orelse return;
    *T c = pick(id(a), a);
    free(a);
    *T b = alloc(T) orelse return;
    b.v = 99;
    u32 r = c.v;
    free(b);
    return r;
}
