// zerc-flags: --stack-limit 1024
// BUG-811 boundary: the concurrent-peak check must not fire when the sum
// genuinely fits. main's chain plus the ISR's chain is ~400 bytes against a
// 1024-byte limit, so this compiles and runs — the rule adds a real bound, not a
// blanket rejection of any program that has both a main and an interrupt.
//
// The ISR here is COMPILE-ONLY on a hosted host by nature (GCC refuses the
// attribute on x86-64), which is why the handler body is trivial and nothing
// calls it: what this test asserts is that the CHECKER accepts the program.
volatile u32 tick;

void main_work() {
    u8[200] scratch;
    scratch[0] = 1;
    tick = scratch[0];
}

u32 main() {
    main_work();
    if (tick != 1) { return 1; }
    return 0;
}
