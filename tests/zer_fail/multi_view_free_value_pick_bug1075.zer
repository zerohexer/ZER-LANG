// EXPECTED: compile error
// expect-error: may already be freed
// BUG-1075 (H5): the pick decides on a VALUE (x.v == 0) rather than a flag.
struct T { u32 v; }
*T pick(*T x, *T y) { if (x.v == 0) { return x; } return y; }
u32 main() {
    *T a = alloc(T) orelse return;
    *T d = alloc(T) orelse { free(a); return 1; };
    a.v = 7;
    d.v = 1;
    *T c = pick(d, a);
    free(c);
    free(a);
    free(d);
    return 0;
}
