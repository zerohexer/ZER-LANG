// expect-error: while a spawned thread may store it
// BUG-1656 boundary: a lock makes the spawner's read-modify-write exact only if the
// thread's store holds the SAME lock. Two different locks exclude nothing.
volatile u32 g;
u32 lk;
u32 lk2;
void w() {
    for (u32 i = 0; i < 1000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        g = i;
        @atomic_store(&lk, 0);
    }
}
u32 main() {
    ThreadHandle a = spawn w();
    for (u32 i = 0; i < 1000; i += 1) {
        while (!@atomic_cas(&lk2, 0, 1)) { }
        g += 1;
        @atomic_store(&lk2, 0);
    }
    a.join();
    return 0;
}
