// EXPECTED: compile error
// expect-error: while it is borrowed by a scoped spawn
// BUG-924 (2026-09-04): the scoped-spawn borrow was established ONLY for a
// literal `&v` argument. Passing a pointer LOCAL bound to &v lent nothing, so the
// parent wrote `v` while the thread held it — a data race that compiled clean.
void w(*u32 p) { *p = 5; }
u32 main() {
    u32 v = 0;
    *u32 q = &v;
    ThreadHandle th = spawn w(q);
    v = 3;                       // races the thread's write through q
    th.join();
    return v;
}
