// BUG-1353 boundary: using (not storing) a param through id() infers nothing.
struct N { ?*u32 p; }
struct NN { N n; }
?*u32 g;
N gn;
N[2] garr;
NN gnn;
[*]u32 gsl;
*u32 id(*u32 p) { return p; }
?*u32 pp(*u32 p) { return p; }
[*]u32 sv([*]u32 s) { return s[0..1]; }
void put(*u32 p) { u32 v = *id(p); gn.p = null; if (v == 7) { g = null; } }
u32 main() { u32 x = 7; put(&x); return 0; }
