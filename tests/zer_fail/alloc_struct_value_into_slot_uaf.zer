// expect-error: use after free
// BUG-986: a struct VALUE assigned into a field slot (`h.inner = i`) carries
// its allocations under the slot's key. Before, the store looked for a bare
// handle on `i` (a struct has none), registered nothing, and a free through
// the outer path followed by a read through the inner variable was reported —
// when at all — as a LEAK of `i`, never as the use-after-free it is.
struct T { u32 v; }
struct In { ?*T p; }
struct H { In inner; }
u32 main() {
    In i;
    i.p = alloc(T);
    H h;
    h.inner = i;
    *T q = h.inner.p orelse return;
    free(q);
    *T r = i.p orelse return;
    return r.v;
}
