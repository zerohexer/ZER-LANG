// BUG-1654 boundary: distinct objects stay accepted — by name, through a carrier
// whose root is known, and an unresolvable pointer handed to a function that
// lends nothing.
struct H { *u32 p; }
void w(*u32 a) { for (u32 i = 0; i < 1000; i += 1) { *a += 1; } }
void f(*u32 p, *u32 q) {
    ThreadHandle th = spawn w(p);
    for (u32 i = 0; i < 1000; i += 1) { *q += 1; }
    th.join();
}
*u32 id(*u32 x) { return x; }
void plain(*u32 p, *u32 q) { *p += 1; *q += 1; }
u32 main() {
    u32 a = 0;
    u32 b = 0;
    f(&a, &b);                 /* two names */
    H h;
    h.p = &b;
    f(&a, h.p);                /* the carrier points at b, not a */
    plain(&a, id(&a));         /* unknown, but `plain` lends nothing */
    if (a != 2002) { return 1; }   /* 1000 + 1000 from the threads, + 2 from plain */
    if (b != 2000) { return 2; }
    return 0;
}
