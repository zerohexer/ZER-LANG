// expect-error: use after free
// BUG-976: a slot-to-slot copy (`b.p = a.p`) formed NO alias — the passthrough
// assign arm keyed on a bare-ident RHS only — so freeing through one slot and
// reading through the other was a silent use-after-free.
struct T { u32 v; }
struct H { ?*T p; }
u32 main() {
    H a; H b;
    a.p = alloc(T) orelse return;
    b.p = a.p;
    *T q = a.p orelse return;
    free(q);
    *T r = b.p orelse return;
    return r.v;
}
