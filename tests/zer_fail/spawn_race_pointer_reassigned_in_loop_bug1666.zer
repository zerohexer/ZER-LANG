// expect-error: both access non-shared global 'g'
// BUG-1666 (was docs/limitations.md B.11): a local pointer starts at the thread's own stack and is re-aimed from a call result LATER
// in the loop body (`*p += 1; p = getp();`): on the second turn `*p` is the global. The walk read bindings in
// source order; a name's answer now comes from every write of it in its function.
// ThreadSanitizer reported a data race on the pre-fix compiler, which accepted this.
u32 flagx;
u32 g;
*u32 getp() { return &g; }
void w() { @atomic_store(&flagx, 1); u32 loc = 0; *u32 p = &loc; for (u32 i = 0; i < 100000; i += 1) { *p += 1; p = getp(); } }
void w2() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { g += 1; } }
i32 main() {
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w2();
    a.join(); b.join();
    return 0;
}
