// EXPECTED: compile error
// expect-error: read-modify-written in a single statement
// BUG-981, MAIN-side site (the third place the "is the RHS a read of the target?"
// question is asked): main read-modify-writes `counter` through a local alias
// while an ISR also writes it. The compound spelling `*p += 1` was rejected here.
volatile u32 counter;
interrupt TIM2 { counter = 1; }
u32 main() { volatile *u32 p = &counter; *p = *p + 1; return 0; }
