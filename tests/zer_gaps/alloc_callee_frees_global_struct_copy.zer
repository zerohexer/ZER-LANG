// GAP (2026-11-13 audit, docs/limitations.md): a callee frees what a global holds through a struct COPY of it; the caller's alias stays ALIVE (exit 99)
struct T { u32 v; }
struct H { ?*T p; }
H g_h;
void drop() { H c = g_h; g_h.p = null; if (c.p) |q| { free(q); } }
u32 main() {
    *T a = alloc(T) orelse return;
    g_h.p = a;
    drop();
    *T b = alloc(T) orelse return;
    b.v = 5;
    a.v = 99;
    u32 r = b.v;
    free(b);
    return r;
}
