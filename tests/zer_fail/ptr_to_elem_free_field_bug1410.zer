// EXPECTED: compile error
// expect-error: 'a' is maybe-freed
// BUG-1410: a free through a POINTER to an element (*H hp = &hs[i]; free(hp.p)) must reach hs[0].p
struct T { u32 v; }
struct H { *T p; u32 k; }
u32 main() {
    *T a = alloc(T) orelse return;
    H[2] hs;
    hs[0] = { .p = a, .k = 1 };
    u32 i = 0;
    *H hp = &hs[i];
    free(hp.p);                                   // frees a
    *T b = alloc(T) orelse { free(a); return 1; };  // reuses the slot
    b.v = 99;
    u32 r = a.v;                                  // stale: 99
    free(b);
    free(a);                                      // and a double free
    return r;
}
