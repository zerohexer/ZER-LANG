// expect-error: no release/acquire flag ordering them
// BUG-1664: two threads hold the SAME value (both waited for 1): the flag orders nothing between them, and one writes.
u32 ready;
u32 data;
u32 sink;
void writer() { data = 1; @atomic_store(&ready, 1); }
void reader() { while (@atomic_load(&ready) == 0) { } sink = data; }
void reader2() { while (@atomic_load(&ready) == 0) { } data = 9; }
u32 main() {
    ThreadHandle a = spawn writer();
    ThreadHandle b = spawn reader();
    ThreadHandle c = spawn reader2();
    a.join(); b.join(); c.join();
    return 0;
}
