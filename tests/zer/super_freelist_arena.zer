// Real program: Freelist allocator built on Arena
// *opaque round-trips through function boundary (clears provenance),
// ?*T linked list, defer cleanup
// Tests: cast safety, interior pointer concepts, arena + linked list

// The freelist link lives INSIDE Block. The original version kept a separate
// FreeNode and type-punned Block <-> FreeNode through *opaque — the classic C
// freelist trick. ZER refuses that: @ptrcast carries a runtime type_id and the
// pun TRAPS ("type mismatch in cast"). Nobody noticed, because the arena had no
// backing store, so the first alloc returned null and the punning code never
// ran. Fixing the arena made the trap immediate. Keeping the link in Block is
// the type-safe expression of the same data structure, and the *opaque
// round-trip below is preserved at its LEGITIMATE use (Block -> *opaque ->
// Block, same type in and out).
struct Block {
    u32 data_a;
    u32 data_b;
    u32 data_c;
    u32 data_d;
    ?*Block next;      // freelist link
}

// 2026-08-20: this file used to declare `Arena backing;` with NO backing store.
// An unbacked arena has capacity 0, so the very first `backing.alloc(Block)`
// returned null and `orelse return` returned from `u32 main()` — which yields 0,
// i.e. PASS. The test therefore executed four of its ~120 lines and reported
// success, while every one of the things its header advertises (the *opaque
// round-trips, the freelist, the recycling, the defer) never ran. Textbook
// vacuous test: the pass condition was weaker than the claim.
//
// Found by the new "arena allocated from but never given a backing store" check,
// whose corpus cost across the whole tree was exactly this one file.
u8[4096] arena_mem;
Arena backing;

// Helper: cast *opaque to *Block — function boundary clears provenance
*Block opaque_to_block(*opaque raw) {
    return (*Block)raw;
}

u32 main() {
    backing = Arena.over(arena_mem);   // WITHOUT this the whole body below is skipped
    ?*Block free_head = null;
    u32 alloc_count = 0;
    u32 free_count = 0;

    // === Allocate 4 blocks from arena ===
    ?*Block mb1 = backing.alloc(Block);
    *Block b1 = mb1 orelse return;
    b1.data_a = 10;
    b1.data_b = 20;
    alloc_count += 1;

    ?*Block mb2 = backing.alloc(Block);
    *Block b2 = mb2 orelse return;
    b2.data_a = 30;
    b2.data_b = 40;
    alloc_count += 1;

    ?*Block mb3 = backing.alloc(Block);
    *Block b3 = mb3 orelse return;
    b3.data_a = 50;
    alloc_count += 1;

    ?*Block mb4 = backing.alloc(Block);
    *Block b4 = mb4 orelse return;
    b4.data_a = 60;
    alloc_count += 1;

    if (alloc_count != 4) { return 1; }
    if (b1.data_a != 10) { return 2; }
    if (b2.data_b != 40) { return 3; }

    // === "Free" b2 — push onto the freelist (round-tripped through *opaque,
    //     Block in and Block out, which is the legitimate erasure) ===
    {
        *opaque raw = (*opaque)b2;
        *Block node = opaque_to_block(raw);
        node.next = free_head;
        free_head = node;
        free_count += 1;
    }

    // === "Free" b3 ===
    {
        *opaque raw = (*opaque)b3;
        *Block node = opaque_to_block(raw);
        node.next = free_head;
        free_head = node;
        free_count += 1;
    }

    if (free_count != 2) { return 4; }

    // === Re-allocate from freelist ===
    *Block b5 = b1; // placeholder
    if (free_head) |node| {
        free_head = node.next;
        *opaque raw = (*opaque)node;
        b5 = opaque_to_block(raw);
        b5.data_a = 0;
        b5.data_b = 0;
        b5.data_c = 0;
        b5.data_d = 0;
        alloc_count += 1;
    }

    // Verify recycled block is zeroed
    if (b5.data_a != 0) { return 5; }
    b5.data_a = 70;

    // Second re-alloc from freelist
    *Block b6 = b1; // placeholder
    if (free_head) |node| {
        free_head = node.next;
        *opaque raw = (*opaque)node;
        b6 = opaque_to_block(raw);
        b6.data_a = 0;
        alloc_count += 1;
    }
    b6.data_a = 80;

    if (alloc_count != 6) { return 7; }

    // === Verify all blocks ===
    if (b1.data_a != 10) { return 8; }
    if (b4.data_a != 60) { return 9; }
    if (b5.data_a != 70) { return 10; }
    if (b6.data_a != 80) { return 11; }

    // Arena reset frees all memory
    defer backing.reset();
    return 0;
}
