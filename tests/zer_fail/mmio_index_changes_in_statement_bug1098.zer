// expect-error: can change within this statement
// BUG-1098: the MMIO index guard is hoisted to the start of the statement and a
// pointer index has no inline single-read form; an index the statement changes
// first (g() writes gi) is refused instead of guarded on a stale value.
mmio 0x40000000..0x4000000F;
u32 gi = 1;
u32 g() { gi = 4; return 0; }
u32 main() {
    volatile *u32 reg = @inttoptr(*u32, 0x40000000);
    u32 v = g() + reg[gi];
    return v;
}
