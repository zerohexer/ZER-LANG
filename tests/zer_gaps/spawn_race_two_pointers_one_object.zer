// GAP (2026-11-14, docs/limitations.md section B item 11): two global pointers hold ONE heap object; a thread
// works through each. The context walk keys each access by the pointer it came through, so the two never meet.
// ThreadSanitizer reports a data race. Compile-clean IS the gap.
u32 flagx;
struct Node { u32 v; }
?*Node p1;
?*Node p2;
void setup() { ?*Node n = alloc(Node); p1 = n; p2 = n; }
void w() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { if (p1) |q| { q.v += 1; } } }
void w2() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { if (p2) |q| { q.v += 1; } } }
i32 main() {
    setup();
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w2();
    a.join(); b.join();
    return 0;
}
