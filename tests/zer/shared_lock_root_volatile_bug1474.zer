// BUG-1474: a shared-struct LOCK ROOT whose index reads a volatile was evaluated
// separately at the lock, the operation and the unlock: another thread changing
// hv made bump() lock sl[i1], write sl[i2] and unlock sl[i3] — a later access
// hung on the mutex left held (measured). The root is now evaluated once.
shared struct S { u32 v; }
volatile u32 hv;
void bump([*]S sl) { sl[hv % 2].v += 1; }
void writer() {
    for (u32 i = 0; i < 20000000; i += 1) { hv = i; }
}
void touch([*]S sl) { sl[0].v += 1; sl[1].v += 1; }
u32 main() {
    S[2] pair;
    ThreadHandle w = spawn writer();
    for (u32 it = 0; it < 1000000; it += 1) { bump(pair[0..2]); }
    w.join();
    ThreadHandle t = spawn touch(pair[0..2]);
    t.join();
    if (pair[0].v + pair[1].v != 1000002) { return 1; }
    return 0;
}
