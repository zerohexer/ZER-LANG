// BUG-1290 boundary: a funcptr the compiler cannot resolve is checked against
// EVERY function of its signature — here all of them are race-free, so the
// helper that spawns a callback param still compiles.
shared struct C { u32 n; }
C cnt;
void tick() { cnt.n += 1; }
void tock() { cnt.n += 2; }
void worker(*() -> void fp) { fp(); }
void run(*() -> void fp) { ThreadHandle th = spawn worker(fp); th.join(); }
u32 main() {
    *() -> void f = tick;
    f = tock;
    run(f);
    run(tick);
    if (cnt.n != 3) { return 1; }
    return 0;
}
