// expect-error: use after free
// BUG-1516: `[*]u32 s = a.arr;` (implicit array->slice of a heap object's field)
// formed no view, so free(a) then s[2] read a recycled object (exit 99);
// `a.arr[0..]` was refused.
struct T { u32 v; u32[4] arr; }
u32 main() {
    *T a = alloc(T) orelse return;
    a.arr[2] = 7;
    [*]u32 s = a.arr;
    free(a);
    *T b = alloc(T) orelse return;
    b.arr[2] = 99;
    u32 r = s[2];
    free(b);
    return r;
}
