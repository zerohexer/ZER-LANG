// BUG-1099: a for-in over a FIXED array snapshots `arr.len` into a synthetic
// bound; the typed fold now knows `.len` of a fixed array, so the element index
// is proven in [0, N-1] and needs no guard. The loop must still visit every
// element exactly once.
u32 main() {
    u32[4] a;
    a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    u32 s = 0;
    for (u32 x in a) { s += x; }
    if (s != 10) { return 1; }
    return 0;
}
