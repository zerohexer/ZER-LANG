// EXPECTED: compile error
// expect-error: must be 1, 2, 4, or 8 bytes
// The atomics width contract. A 16-byte target is not atomic on most ISAs, so it
// must be rejected rather than silently lowered to a non-atomic sequence.
// Pins the half of the documented contract that IS enforced — the other half
// (`*shared T`) was removed from the docs 2026-08-10 as not constructible.
u128 g;

u32 main() {
    u128 old = @atomic_add(&g, 1);
    if (old > 0) { return 1; }
    return 0;
}
