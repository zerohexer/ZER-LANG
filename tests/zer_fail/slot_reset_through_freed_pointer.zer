// expect-error: use after free
// BUG-985 boundary: a slot RESET is not a use of the slot's old pointee, but
// reaching the slot THROUGH a freed pointer is still a write into freed memory.
struct T { u32 v; }
struct H { ?*T p; }
u32 main() {
    *H hp = alloc(H) orelse return;
    free(hp);
    hp.p = null;
    return 0;
}
