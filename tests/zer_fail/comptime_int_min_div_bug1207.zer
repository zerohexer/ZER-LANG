// EXPECTED: compile error
// expect-error: could not be evaluated at compile time
// BUG-1207: signed MIN / -1 overflows — the emitted code TRAPS on it, and the fold
// produced -2147483648 instead (at i64 width, UB in the compiler's own process).
comptime i32 D(i32 a, i32 b) { if (b == 0) { return 0; } return a / b; }
u32 main() { i32 r = D(-2147483648, -1); if (r < 0) { return 1; } return 0; }
