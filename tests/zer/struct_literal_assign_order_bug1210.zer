// BUG-1210: a struct literal ASSIGNED (not a var-decl init) passed through as a C
// compound literal, whose initializer order is unspecified — GCC ran `.a` first.
// Every other position already evaluated its fields left to right.
struct S { u32 a; u32 b; }
u32 cnt = 0;
u32 nx() { cnt += 1; return cnt; }
S g;
u32 main() {
    S s;
    s = { .b = nx(), .a = nx() };
    if (s.b != 1 || s.a != 2) { return 1; }
    g = { .b = nx(), .a = nx() };
    if (g.b != 3 || g.a != 4) { return 2; }
    S t = { .b = nx(), .a = nx() };
    if (t.b != 5 || t.a != 6) { return 3; }
    return 0;
}
