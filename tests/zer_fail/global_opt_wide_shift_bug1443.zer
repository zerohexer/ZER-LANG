// EXPECTED: compile error
// expect-error: wider than 64 bits must be built from integer literals
// BUG-1443: the optional payload of a >64-bit global is folded by the same 64-bit
// evaluators as a plain one, so it gets the same admitted-expression rule.
?u128 C = 1 << 70;
u32 main() { u128 v = C orelse 0; if (v == 0) { return 1; } return 0; }
