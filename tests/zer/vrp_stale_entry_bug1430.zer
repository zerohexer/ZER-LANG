// BUG-1430: a store under a guard's narrowing must reach EVERY range entry of
// the variable. Each helper returns 1 only if its fixed-array access RAN out of
// bounds (the auto-guard returns 0 early). A broken compiler proves every access
// in range and returns 7 here (the writes land in `pad`).
u32[4] arr;
u32[64] pad;
u32 get(u32 a) { return a; }
u32 plain() { u32 i = 1; if (i < 2) { i = get(5); } arr[i] = 7; return 1; }
u32 compound() { u32 i = get(1); if (i < 4) { if (i < 2) { i += 4; } arr[i] = 7; return 1; } return 0; }
u32 with_else() { u32 i = get(1); if (i < 4) { if (i < 2) { i = get(5); } else { } arr[i] = 7; return 1; } return 0; }
u32 eq_guard() { u32 i = get(1); if (i < 4) { if (i == 1) { i = 5; } arr[i] = 7; return 1; } return 0; }
u32 not_eq() { u32 i = get(1) % 4; if (i != 0) { i = get(5); } arr[i] = 7; return 1; }
u32 arm() {
    u32 i = get(1);
    u32 c = get(0);
    if (i < 4) {
        switch (c) { 0 => { if (i < 2) { i = 5; } } default => { } }
        arr[i] = 7;
        return 1;
    }
    return 0;
}
u32 bound() {
    u32 n = 4;
    if (n == 4) { n = get(8); }
    for (u32 k = 0; k < n; k += 1) { arr[k] = 7; }
    return 1;
}
u32 main() {
    return plain() + compound() + with_else() + eq_guard() + not_eq() + arm() + bound();
}
