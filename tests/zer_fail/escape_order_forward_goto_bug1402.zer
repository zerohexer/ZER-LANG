// BUG-1402: the frame-bound taint is set textually AFTER the sink, but runs before it
// (loop back edge / goto / defer). Reproducer from the 2026-09-28 escape probe (G1).
// expect-error: cannot store local-derived pointer 'p' in global/s
u32 g0 = 1;
?*u32 gp;
void f() {
    u32 x = 5;
    *u32 p = &g0;
    goto set;
use:
    gp = p;
    return;
set:
    p = &x;
    goto use;
}
u32 main() { f(); if (gp) |q| { return *q; } return 0; }
