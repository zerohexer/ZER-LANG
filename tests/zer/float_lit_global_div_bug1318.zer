// BUG-1318: regression (see BUGS-FIXED.md).
// expected: compiles, gh == 0.5. Actual: GCC error "braced-group within expression allowed only inside a function"
// (global initializer emits a statement-expression division guard) — and the literals are ints anyway.
f64 gh = 1.0 / 2.0;
u32 main() {
    if (gh != 0.5) { return 1; }
    return 0;
}
