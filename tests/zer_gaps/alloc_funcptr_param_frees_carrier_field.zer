// GAP (2026-11-13 audit, docs/limitations.md): a struct carrying a pointer forwarded to a funcptr PARAMETER is not widened (exit 99)
struct T { u32 v; }
struct H { *T p; }
?*T gk;
void fre(H h) { free(h.p); }
void apply(*(H) f, H h) { f(h); }
u32 main() {
    *T a = alloc(T) orelse return;
    H h = { .p = a };
    apply(fre, h);
    u32 r = 0;
    ?*T mb = alloc(T);
    if (mb) |b| {
        b.v = 5;
        a.v = 99;
        r = b.v;
        free(b);
    }
    gk = a;
    return r;
}
