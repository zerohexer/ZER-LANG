Pool(T, 4) pool;
u32 rdl(*T x, Handle(T) hh) {
    pool.free(hh);
    Handle(T) g2 = pool.alloc() orelse return;
    pool.get(g2).v = 77;
    u32 r = x.v;
    pool.free(g2);
    return r;
