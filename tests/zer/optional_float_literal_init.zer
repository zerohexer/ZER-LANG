// BUG-1000 sibling (2026-09-06): a FLOAT literal is f64, so `?f32 r = 1.5;` was
// rejected ("cannot initialize ... with f64") while `f32 x = 1.5;` is accepted and
// the integer tree already looked through one optional level. Local, global,
// negative, assignment, call-arg, return, struct-field and orelse-fallback sinks.
?f32 gr = 1.5;
?f64 gd = -2.25;
u32 main2() {
    ?f32 r = 1.5;
    ?f32 m = -0.5;
    ?f64 d = 2.25;
    f32 a = r orelse 0.0; if (a < 1.49 || a > 1.51) { return 1; }
    f32 b = m orelse 0.0; if (b > -0.49) { return 2; }
    f64 c = d orelse 0.0; if (c != 2.25) { return 3; }
    f32 e = gr orelse 0.0; if (e < 1.49) { return 4; }
    f64 f = gd orelse 0.0; if (f != -2.25) { return 5; }
    r = 3.5;
    f32 g = r orelse 0.0; if (g < 3.4) { return 6; }
    return 0;
}
struct W { ?f32 v; }
?f32 mk() { return 1.5; }
f32 take(?f32 x) { f32 r = x orelse 0.0; return r; }
u32 main() {
    if (main2() != 0) { return 10; }
    if (take(2.5) < 2.4) { return 1; }
    f32 a = mk() orelse 0.0; if (a < 1.4) { return 2; }
    W w = { .v = 4.5 };
    f32 b = w.v orelse 0.0; if (b < 4.4) { return 3; }
    ?f32 o = null;
    f32 c = o orelse 7.5; if (c < 7.4) { return 4; }
    return 0;
}
