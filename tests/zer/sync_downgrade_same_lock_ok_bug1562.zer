// BUG-1562 boundary: two threads writing a plain global under ONE CAS lock (taken
// in a helper call inside the region) stay a warning, not an error.
u32 lock;
u32 counter;
void inc() { counter += 1; }
void w() { while (!@atomic_cas(&lock, 0, 1)) { } inc(); @atomic_store(&lock, 0); }
u32 main() { ThreadHandle a = spawn w(); ThreadHandle b = spawn w(); a.join(); b.join(); if (counter != 2) { return 1; } return 0; }
