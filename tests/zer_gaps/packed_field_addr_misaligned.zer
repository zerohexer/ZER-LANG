// GAP (2026-08-10): &packed_field forms a misaligned *u32 (offset 1); the plain
// deref is unchecked. Faults / silently-wrong on strict-align ARM; works on x86
// so host tests never surface it. Alignment is checked at @inttoptr but not at
// address-of a packed field (Rust rejects this as E0793). compile-clean = gap.
packed struct P { u8 id; u32 v; u8 tail; }
P g;
u32 read_it() {
    *u32 p = &g.v;
    *p = 0xDEAD;
    return *p;
}
u32 main() { return read_it(); }
