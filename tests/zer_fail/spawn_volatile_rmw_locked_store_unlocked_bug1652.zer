// expect-error: does not hold that lock
// BUG-1652: a read-modify-write under a CAS lock is exact only if every other
// store of the flag holds the lock. The spawner's plain `g = 5;` lands between
// the thread's read and its write-back and is erased.
volatile u32 g;
u32 lk;
void w() {
    for (u32 i = 0; i < 1000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        g += 1;
        @atomic_store(&lk, 0);
    }
}
u32 main() {
    ThreadHandle a = spawn w();
    g = 5;
    a.join();
    return 0;
}
