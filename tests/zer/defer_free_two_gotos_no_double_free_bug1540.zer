// BUG-1540: the double fire freed p twice — the second free released the slot
// already reused by q, so gq dangled and read another object (7, not 42).
struct T { u32 v; }
?*T gq;
u32 f(u32 k) {
    *T p = alloc(T) orelse return;
    p.v = 5;
    defer free(p);
    if (k == 1) { goto out; }
out:
    *T q = alloc(T) orelse return;
    q.v = 42;
    gq = q;
    if (k == 2) { goto out2; }
out2:
    return 0;
}
u32 main() {
    f(1);
    *T z = alloc(T) orelse return;
    z.v = 7;
    u32 r = 0;
    if (gq) |q| { r = q.v; }
    free(z);
    if (r != 42) { return 1; }
    return 0;
}
