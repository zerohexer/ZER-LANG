// EXPECTED: compile error
// A function that frees the same FIELD of its param twice → intra-function
// double free. The free handler did not register a compound handle for an
// untracked param field, so both frees were silent no-ops.
struct B { u32 x; }
struct H { [*]B buckets; }
void fb(H h) {
    free(h.buckets);
    free(h.buckets);
}
u32 main() {
    H h;
    h.buckets = alloc(B, 4) orelse { return 0; };
    fb(h);
    return 0;
}
