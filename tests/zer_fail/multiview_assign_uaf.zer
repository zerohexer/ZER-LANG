// expect-error: may be a view of an allocation that is freed
// BUG-919: the MULTI-VIEW call-result registration (a callee whose every return
// is a view, naming more than one param) was wired only at the var-decl sink.
// The ASSIGNMENT spelling recorded no view set at all.
[*]u8 pick([*]u8 a, [*]u8 b, bool fl) { if (fl) { return b[0..1]; } return a[0..1]; }
u32 res;

void g(bool fl) {
    [*]u8 x = alloc(u8, 4) orelse return;
    [*]u8 y = alloc(u8, 4) orelse return;
    [*]u8 h = x;
    h = pick(x, y, fl);
    free(y);
    res = (u32)h[0];
    free(x);
}
u32 main() { g(true); return 0; }
