// expect-error: more than one 'v' is visible here
// BUG-1569: a static shadow re-aimed the lent root name; the thread's pointee was never lent (TSan race).
void w(*u32 p) { for (u32 i = 0; i < 100000; i += 1) { *p += 1; } }
u32 main() {
    u32 v = 0; *u32 r = &v; *u32 r2 = &v;
    { static u32 v = 0; ThreadHandle th = spawn w(r); for (u32 i = 0; i < 100000; i += 1) { *r2 += 1; } th.join(); }
    if (v != 200000) { return 1; } return 0;
}
