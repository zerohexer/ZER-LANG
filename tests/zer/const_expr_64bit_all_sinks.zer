// A pure integer-literal tree is evaluated in its DESTINATION width at EVERY
// value-flow sink (2026-09-05). Before: var-decl / call-arg / return /
// struct-init retyped the tree (IR temps carry the width), but assignment,
// orelse fallback, spawn arg and global init did not, and the AST literal
// emitter wrote a bare `1` (a C int) — so `a = -(1 << 40);` stored 0 while
// `i64 a = -(1 << 40);` one line away stored -2^40. No diagnostic either way.
shared struct Box { i64 v; }
Box g_box;
void worker(i64 v) { g_box.v = v; }
?i64 opt() { return null; }
i64 g1 = -(1 << 40);                     // global sink, negative (stays a tree)
u64 g2 = 1 << 40;                        // global sink, folded to a literal
i32 g3 = -5 - 1;
?i32 g4 = 5 - 1;                         // global ?integer payload
u3  g5 = 3 + 4;
// the ninth sink — compound assignment
u32 compound_sink() {
    u64 s = 0;
    s += 1 << 40;
    i64 m = 0;
    m -= 1 << 40;
    u3 v = 1;
    v += 3 + 3;
    if (s != 1099511627776) { return 1; }
    if (m != -1099511627776) { return 2; }
    if (v != 7) { return 3; }
    return 0;
}
u32 main() {
    i64 a = 0;
    a = -(1 << 40);                      // assignment sink
    i64 b = opt() orelse -(1 << 40);     // orelse fallback sink
    u64 c = 0;
    c = 100000 * 100000;                 // 64-bit product, assignment sink
    u64[2] arr;
    arr[1] = 1 << 40;                    // index-store assignment
    ThreadHandle th = spawn worker(-(1 << 40));   // spawn-arg sink
    th.join();
    if (g1 != -1099511627776) { return 1; }
    if (g2 != 1099511627776) { return 2; }
    if (g3 != -6) { return 3; }
    i32 g4v = g4 orelse 0; if (g4v != 4) { return 4; }
    if (g5 != 7) { return 5; }
    if (a != -1099511627776) { return 6; }
    if (b != -1099511627776) { return 7; }
    if (c != 10000000000) { return 8; }
    if (arr[1] != 1099511627776) { return 9; }
    if (g_box.v != -1099511627776) { return 10; }
    if (compound_sink() != 0) { return 11; }
    return 0;
}
