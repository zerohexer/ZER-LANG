// expect-trap
// BUG-913 (loop form): `j` is 0 at the `defer`, reassigned to the array length
// before scope exit. The deferred read must be guarded, not proven from the
// stale [0,0] range.
u32 g;
u32 main() {
    u32[4] arr;
    for (u32 i = 0; i < 4; i += 1) {
        arr[i] = i;
    }
    u32 j = 0;
    defer { g = arr[j]; }
    j = 4;
    return 0;
}
