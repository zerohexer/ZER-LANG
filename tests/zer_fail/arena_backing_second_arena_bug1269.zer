u32 main() {
    Arena a = Arena.over(gbuf);
    Arena b = Arena.over(gbuf);
    *B pb = b.alloc(B) orelse return;
    pb.s = small[0..];
    *A pa = a.alloc(A) orelse return;
    pa.x = (u64)@ptrtoint(&small[0]); pa.y = 64;
