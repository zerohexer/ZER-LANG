// expect-error: a label sits inside its region
// BUG-1663: a goto enters the region past the acquire.
volatile u32 g;
u32 lk;
void w() {
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        g += 1;
        @atomic_store(&lk, 0);
    }
}
u32 main() {
    ThreadHandle a = spawn w();
    u32 i = 0;
again:
    goto inside;
    while (!@atomic_cas(&lk, 0, 1)) { }
inside:
    g += 1;
    @atomic_store(&lk, 0);
    i += 1;
    if (i < 200000) { goto again; }
    a.join();
    if (g != 400000) { return 1; }
    return 0;
}
