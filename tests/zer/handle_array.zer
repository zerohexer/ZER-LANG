// Handle(T)[N] — array of handles
// BUG-1130: a local array's variable-index slots are leak-checked now, so the
// checks compute a result code and every slot that was filled is freed before
// the one return (the old early `return 2;` and `orelse { return 1; }` leaked
// what the array already held).

struct Task { u32 id; u32 val; }
Slab(Task) heap;

u32 main() {
    Handle(Task)[4] tasks;
    u32 n = 0;

    for (u32 i = 0; i < 4; i += 1) {
        ?Handle(Task) mt = heap.alloc();
        if (mt) |t| {
            tasks[i] = t;
            tasks[i].id = i;
            tasks[i].val = i * 100;
            n += 1;
        } else {
            break;
        }
    }

    u32 rc = 0;
    if (n != 4) {
        rc = 1;
    } else {
        if (tasks[0].id != 0) { rc = 2; }
        if (tasks[2].val != 200) { rc = 3; }
        if (tasks[3].val != 300) { rc = 4; }
    }

    for (u32 i = 0; i < n; i += 1) {
        heap.free(tasks[i]);
    }

    return rc;
}
