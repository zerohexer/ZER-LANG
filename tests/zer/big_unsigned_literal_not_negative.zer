// BOUNDARY POSITIVE for BUG-859: the negative-constant rule folds in int64, so
// "the fold came out negative" alone cannot tell `-1` from the bare literal
// 0xFFFFFFFFFFFFFFFF, whose int64 image is also -1. The first version of the
// rule rejected both and broke two corpus tests; these are the shapes that
// must keep compiling.
u32 main() {
    u64 a = 0xFFFFFFFFFFFFFFFF;
    if (a != 18446744073709551615) { return 1; }
    u64 b = 0xDEADBEEFCAFEBABE;
    if (b != 0xDEADBEEFCAFEBABE) { return 2; }
    i32 c = -5;
    if (c != -5) { return 3; }
    i64 d = -5000000000;
    if (d >= 0) { return 4; }
    u64 e = 0xFFFFFFFFFFFFFFFF - 1;
    if (e != 18446744073709551614) { return 5; }
    return 0;
}
