// Arena: bump allocator — alloc struct, use, reset

struct Vec2 { u32 x; u32 y; }

Arena scratch;
u8[256] backing;

u32 main() {
    /* BUG-846: was `scratch.over(backing);` — a silent NO-OP. `over` is a constructor
     * returning an Arena BY VALUE, so as a statement it built one into a
     * discarded temp and this arena stayed at capacity 0. Every allocation
     * below then returned null and the test ran only its `orelse` path. */
    scratch = Arena.over(backing);
    ?*Vec2 mv = scratch.alloc(Vec2);
    *Vec2 v = mv orelse return;
    v.x = 3;
    v.y = 4;

    if (v.x != 3) { return 1; }
    if (v.y != 4) { return 2; }

    scratch.reset();
    return 0;
}
