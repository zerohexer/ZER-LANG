// expect-error: both access non-shared global 'g'
// BUG-1666: a READ through a never-re-aimed global pointer (`*gp`) against a write of its target by name.
// The read was keyed by the pointer `gp`, the write by `g`; the assignment arm resolved a write through
// `gp` to `g`, nothing did the same for a read. TSan: data race on the pre-fix compiler.
u32 flagx;
u32 g;
*u32 gp = &g;
u32 sink;
void rd() { @atomic_store(&flagx, 1); u32 acc = 0; for (u32 i = 0; i < 100000; i += 1) { acc += *gp; } }
void wr() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { g += 1; } }
i32 main() {
    ThreadHandle a = spawn rd();
    ThreadHandle b = spawn wr();
    a.join(); b.join();
    return 0;
}
