// BUG-1221: a declaration without an initializer is auto-zeroed EVERY time it
// executes. Locals are hoisted and were zeroed once, so `acc` in a loop body kept
// the previous iteration's value (30, not 15) — also after a backward goto.
struct T { u32 v; }
u32 main() {
    u32 total = 0;
    for (u32 i = 0; i < 3; i += 1) {
        u32 acc;
        acc += 5;
        total += acc;
        ?*T p;
        if (p) |q| { return 9; }
        p = alloc(T);
        if (p) |q| { free(q); }
        u8[4] buf;
        buf[0] += 2;
        total += buf[0];
    }
    u32 k = 0;
    again:
    u32 w;
    w += 1;
    k += w;
    if (k < 3) { goto again; }
    if (total != 21) { return 1; }
    if (k != 3) { return 2; }
    return 0;
}
