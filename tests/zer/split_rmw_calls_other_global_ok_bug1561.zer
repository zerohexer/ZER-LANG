// BUG-1561 boundary: `rd` reads h and `wr` stores g, so `wr(rd() + 1)` in a
// thread is a read of one global and a single-word store of another — not a
// read-modify-write of either.
volatile u32 g;
volatile u32 h;
u32 rd() { return h; }
void wr(u32 v) { g = v; }
void worker() { u32 t = rd(); wr(t + 1); }
u32 main() {
    h = 4;
    ThreadHandle th = spawn worker();
    th.join();
    if (g != 5) { return 1; }
    return 0;
}
