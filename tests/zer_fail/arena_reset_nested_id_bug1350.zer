// EXPECTED: compile error
// expect-error: use after free
// BUG-1350: c = id(id(arena alloc)); reset; c.v read the next allocation.
struct T { u32 v; }
*T id(*T p) { return p; }
u8[256] buf;
u32 main() {
    Arena ar = Arena.over(buf);
    *T a = ar.alloc(T) orelse return;
    a.v = 1;
    *T c = id(id(a));
    ar.reset();
    *T b = ar.alloc(T) orelse return;
    b.v = 99;
    return c.v;
}
