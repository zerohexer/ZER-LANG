// BUG-1355 boundary.
// BUG-1355 boundary: an allocation stored into a field of an object the
// function OWNS is still tracked — building a node and handing it on (return,
// global, container) is fine, and so is freeing the field before the node.
struct T { u32 v; }
struct N { ?*T p; }
struct L { ?*N head; }
?*N gnode;

?*N mk(u32 v) {
    *T a = alloc(T) orelse return;
    a.v = v;
    *N n = alloc(N) orelse { free(a); return null; };
    n.p = a;
    return n;
}

void push(*L l, *N n) { l.head = n; }

void drop(*N n) {
    if (n.p) |q| { free(q); }
    n.p = null;
    free(n);
}

u32 main() {
    u32 r = 0;
    *N n = mk(7) orelse return;
    if (n.p) |q| { r += q.v; }
    drop(n);

    *T b = alloc(T) orelse return;
    b.v = 5;
    *N m = alloc(N) orelse { free(b); return 1; };
    m.p = b;
    gnode = m;                   // the node (and what it holds) now lives in a global
    if (gnode) |g| { if (g.p) |q| { r += q.v; } }

    *T c = alloc(T) orelse return;
    c.v = 1;
    *N k = alloc(N) orelse { free(c); return 1; };
    k.p = c;
    free(c);                     // free the field's target first ...
    k.p = null;
    free(k);                     // ... then the node: nothing leaks

    L l;
    *T d = alloc(T) orelse return;
    *N j = alloc(N) orelse { free(d); return 1; };
    j.p = d;
    push(&l, j);                 // handed to a container the caller owns
    l.head = null;
    drop(j);
    return r - 12;
}
