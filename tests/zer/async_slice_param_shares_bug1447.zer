// BUG-1447 boundary: a SLICE parameter shares the caller's array with the task
// (the task's _init keeps it, so the array must outlive the task — here both are
// locals of main).
async void fill([*]u32 a) {
    a[0] = 5;
    yield;
    a[1] = 6;
}
u32 main() {
    u32[4] y;
    _zer_async_fill t;
    _zer_async_fill_init(&t, y);
    while (_zer_async_fill_poll(&t) == 0) { }
    if (y[0] != 5 || y[1] != 6) { return 2; }
    return 0;
}
