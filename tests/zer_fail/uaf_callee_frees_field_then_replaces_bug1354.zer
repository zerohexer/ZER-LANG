// EXPECTED: compile error
// expect-error: use after free
// BUG-1354: re(*H h) { n = alloc orelse return; free(h.p); h.p = n; } freed a on one path.
struct T { u32 v; }
struct H { *T p; }
T gt;
void re(*H h) {
    *T n = alloc(T) orelse return;
    free(h.p);
    h.p = n;
}
u32 main() {
    *T a = alloc(T) orelse return;
    H h = { .p = a };
    re(&h);
    u32 r = a.v;
    free(h.p);
    return r;
}
