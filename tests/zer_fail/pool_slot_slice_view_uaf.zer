// EXPECTED: compile error
// expect-error: use after free
// BUG-966 (2026-09-07): a subslice of an array field reached through Handle
// auto-deref (`h.arr[0..]`) is a view into h's slot; it must not outlive
// `p.free(h)`. The subslice registration used to stop at the FIELD step.
struct T { u8[4] arr; }
Pool(T, 4) p;
u32 main() {
    Handle(T) h = p.alloc() orelse return;
    [*]u8 s = h.arr[0..];
    p.free(h);
    s[0] = 7;
    return 0;
}
