// EXPECTED: compile error
// expect-error: @atomic_add on a 'E' cell
// BUG-1197: an arithmetic atomic on an enum cell stored 5 into a 3-variant enum; the
// exhaustive switch then took its last arm. (The uN half: '@atomic_add(&g21, 1)' on a
// u21 now needs an exactly 8/16/32/64-bit cell — see atomic_uN_width_bug1197.)
enum E { a, b, c }
E g;
u32 main() {
    E x = @atomic_add(&g, 5);
    switch (g) {
        .a => { return 1; }
        .b => { return 2; }
        .c => { return 3; }
    }
    return 0;
}
