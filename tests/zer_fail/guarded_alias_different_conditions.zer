// expect-error: use after free
// BUG-862 boundary: the recovery needs COMPLEMENTARY guards on the SAME
// immutable bool. `c` and `d` are independent, so neither path is excluded by
// the other and the second free may double-free. Adding the alias-group
// marking must not weaken that — this is the shape that separates "freed on
// every path" from "freed twice on some path".
struct Task { u32 id; }
Pool(Task, 4) pool;

u32 run(bool c, bool d) {
    ?Handle(Task) mh = pool.alloc();
    Handle(Task) h = mh orelse return;
    if (c) { pool.free(h); }
    if (d) { pool.free(h); }
    return 0;
}

u32 main() { return run(true, false); }
