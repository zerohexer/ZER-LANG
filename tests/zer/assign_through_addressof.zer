// Regression (2026-07-29): an assignment target with an address-of node in its
// lvalue chain (`*(&x) = v`, `*(&arr[0]) = v`, `*(&s.f) = v`) crashed the checker
// with a SEGV — the const-check lvalue walk admitted NODE_UNARY but read
// index_expr.object off the `&` node (wrong union member → garbage deref).
// With the fix these compile and write through the address correctly.
struct S { u32 f; }

u32 main() {
    u32 x = 0;
    u8[4] arr;
    S s;
    *(&x) = 5;
    *(&arr[0]) = 7;
    *(&s.f) = 9;
    if (x == 5 && arr[0] == 7 && s.f == 9) { return 0; }
    return 1;
}
