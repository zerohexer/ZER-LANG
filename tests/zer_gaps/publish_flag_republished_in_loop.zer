// GAP (2026-11-14, docs/limitations.md section B): the PUBLISH-FLAG idiom republished in a loop.
// `data = i; @atomic_store(&ready, 1);` is accepted as "published by ready", and the reader's
// `if (@atomic_load(&ready) == 1) { sink = data; }` as "acquired through ready" — but the
// second iteration writes `data` while the reader may be reading it (ThreadSanitizer: data race).
// Compile-clean IS the gap.
u32 data;
u32 ready;
u32 sink;
void writer() { for (u32 i = 0; i < 100000; i += 1) { data = i; @atomic_store(&ready, 1); } }
u32 main() {
    ThreadHandle a = spawn writer();
    for (u32 i = 0; i < 100000; i += 1) { if (@atomic_load(&ready) == 1) { sink = data; } }
    a.join();
    return 0;
}
