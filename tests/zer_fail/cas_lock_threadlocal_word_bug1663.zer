// expect-error: no common lock
// BUG-1663: a `threadlocal` lock word is one word PER THREAD: each thread spins on, and wins, its own copy. It excludes nobody.
threadlocal u32 lk;
u32 counter;
void w() {
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        counter += 1;
        @atomic_store(&lk, 0);
    }
}
i32 main() {
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w();
    a.join(); b.join();
    return 0;
}
