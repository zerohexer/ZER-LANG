// expect-trap
// BUG-864, the SIBLING ROUTE. BUG-843 closed `@bitcast(State, 7)` by TRACKING —
// a variant guard that traps at the point of forgery, deliberately keeping the
// legitimate "read an enum out of a hardware register field" idiom working.
// The guard was then called from the two @bitcast sites and nowhere else, so
// @truncate reached the same closed set through a different door with NO check
// at all, and the forged value silently ran the switch's LAST arm.
//
// Pre-fix this exited 12 (the .done arm). It must now SIGTRAP.
enum State { idle, running, done }
u32 opaque_u32(u32 v) { return v; }
u32 main() {
    State s = @truncate(State, opaque_u32(7));
    switch (s) {
        .idle => { return 10; }
        .running => { return 11; }
        .done => { return 12; }
    }
}
