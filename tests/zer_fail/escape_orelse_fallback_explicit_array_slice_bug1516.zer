// expect-error: cannot store local array as slice in global/static
// BUG-1516: `g = opt orelse local_buf[0..]` (an EXPLICIT slice in the fallback)
// was accepted — only the bare-array spelling was checked.
[*]u8 g_slice;
void leak(?[*]u8 opt) {
    u8[10] local_buf;
    g_slice = opt orelse local_buf[0..];
}
u32 main() { return 0; }
