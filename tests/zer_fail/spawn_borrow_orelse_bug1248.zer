// BUG-1248: the root was lost through an orelse unwrap.
void w(*u32 p) { for (u32 i = 0; i < 100000; i += 1) { *p += 1; } }
struct H { *u32 p; }
u32 main() {
    u32 v = 0;
    ?*u32 op = &v; *u32 p = op orelse return;
    ThreadHandle th = spawn w(p);
    for (u32 i = 0; i < 100000; i += 1) { v += 1; }
    th.join();
    return 0;
}
