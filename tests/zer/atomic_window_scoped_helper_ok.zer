// BUG-1589 boundary: a helper whose thread is JOINED before it returns opens no
// window — plain access after it is single-threaded again.
u32 g;
void worker() { @atomic_add(&g, 1); }
void run_joined() { ThreadHandle th = spawn worker(); th.join(); }
u32 main() {
    run_joined();
    g = g + 5;
    for (u32 i = 0; i < 3; i += 1) { run_joined(); }
    if (@atomic_load(&g) != 9) { return 1; }
    return 0;
}
