// GAP (isolated 2026-08-02, NOT fixed): same class as
// gap_spawn_funcptr_struct_field.zer, but the binding happens in a DIFFERENT
// function (`install`). This is the variant that makes a cheap fix insufficient:
// following the same-function binding would catch the sibling file but not this
// one, so a partial fix would leave the realistic pattern open while looking
// covered. A real fix needs a FuncSummary axis ("stores function F into a
// funcptr field of param N") — see docs/limitations.md.
u32 counter;
void bump() { counter += 1; }
struct Ops { *() cb; }
void install(*Ops o) { o.cb = bump; }
void worker(Ops o) { o.cb(); }
u32 main() {
    Ops ops;
    install(&ops);
    spawn worker(ops);
    counter += 1;
    return counter;
}
