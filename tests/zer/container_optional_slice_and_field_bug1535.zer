// BUG-1535: container stamps got none of the companion typedefs (?Box(u32),
// [*]Box(u32) were unknown types) and came after every regular struct, so a
// struct holding a stamp by value had an incomplete field.
container Box(T) { T v; }
container LNode(T) { T val; [*]LNode(T) kids; }
struct S { u32 k; Box(u32) b; }
?Box(u32) mk(u32 v) { Box(u32) b; b.v = v; return b; }
u32 main() {
    S s;
    s.b.v = 4;
    ?Box(u32) o = mk(5);
    u32 r = 0;
    if (o) |i| { r = i.v; }
    Box(u32)[2] arr;
    arr[1].v = 6;
    [*]Box(u32) sl = arr[0..2];
    LNode(u32) n;
    n.val = 1;
    if (s.b.v + r + sl[1].v + n.val != 16) { return 1; }
    return 0;
}
