// BUG-1025 (2026-09-11): a VOLATILE index must be read exactly once. The
// auto-guard was `if (g_i >= 4) return; ... arr[g_i]` — two loads of g_i — so
// anything that changes it between them (an ISR on bare metal) walks past the
// guard. Now: no auto-guard for a volatile ident; the emitter's single-read
// inline form (`size_t _zer_idx = g_i; _zer_bounds_check(...); arr[_zer_idx]`)
// is used, and VRP never narrows a volatile at all.
volatile u32 g_i = 0;
u32[4] arr;
u32 main() {
    g_i = 2;
    arr[g_i] = 7;                       // in range — must not trap
    if (g_i < 4) { arr[g_i] += 1; }     // VRP must NOT elide the check here
    volatile u32 li = 1;
    arr[li] = 9;                        // volatile LOCAL: same rule
    return arr[2] + arr[1] - 17;
}
