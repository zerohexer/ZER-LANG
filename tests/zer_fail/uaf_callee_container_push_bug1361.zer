// EXPECTED: compile error
// expect-error: freed pointer
// BUG-1361: push(&s, a) stores a at s.data[s.top].p; free(a); top(&s) reads it.
struct T { u32 v; }
container Stack(E) { E[4] data; u32 top; }
struct PT { ?*T p; }
void push(*Stack(PT) s, *T p) { s.data[s.top].p = p; s.top += 1; }
?*T top(*Stack(PT) s) { return s.data[0].p; }
u32 main() {
    *T a = alloc(T) orelse return;
    Stack(PT) s;
    push(&s, a);
    free(a);
    *T b = alloc(T) orelse { return 0; };
    b.v = 99;
    u32 r = 0;
    if (top(&s)) |q| { r = q.v; }
    free(b);
    return r;
}
