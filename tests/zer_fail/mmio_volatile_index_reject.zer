// EXPECTED: compile error
// expect-error: cannot index MMIO pointer with volatile
// BUG-960: a pointer index has no single-read inline form, so a volatile index on
// an MMIO pointer is refused rather than guarded with two reads.
mmio 0x4000_0000..0x4000_00FF;
volatile u32 g_i = 0;
u32 main() {
    volatile *u32 reg = @inttoptr(volatile *u32, 0x4000_0000);
    reg[g_i] = 1;
    return 0;
}
