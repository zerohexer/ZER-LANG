// expect-trap
// expect-trap-msg: read of a null non-null pointer
// expect-trap-at: 13
// BUG-1152: guarding the DEREFERENCE of a field would miss this launder —
// the NULL is copied into a plain `*u32` local first, and a local is assumed
// non-null. The guard sits on the LOAD out of the field, so the NULL never
// reaches the local.
struct H { u32 a; *u32 p; }
H g;

u32 main() {
    u32 r = 0;
    *u32 q = g.p;
    r = *q;
    return r;
}
