// GAP (2026-11-13 audit, docs/limitations.md): a callee forwards &global.field to a freeing helper (exit 99)
struct T { u32 v; }
struct H { *T p; }
struct G { H h; }
G g;
void drop2(*H h) { free(h.p); }
void drop() { drop2(&g.h); }
u32 main() {
    *T a = alloc(T) orelse return;
    g.h.p = a;
    drop();
    *T b = alloc(T) orelse return;
    b.v = 5;
    a.v = 99;
    u32 r = b.v;
    free(b);
    return r;
}
