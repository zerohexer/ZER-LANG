// EXPECTED: compile error
// expect-error: use after free
// BUG-1133: a CHAINED wrapper `mk2(a) { return mk(a); }` — the param handed on had no
// identity, so the chain dropped the field view. Pre-fix: compiled.
struct T { u32 v; }
struct H { *T p; }
struct W { H h; u32 n; }
H mk(*T a) { return { .p = a }; }
H mk2(*T a) { return mk(a); }
u32 main() {
    *T a = alloc(T) orelse return;
    a.v = 5;
    H h = mk2(a);
    free(a);
    return h.p.v;
}
