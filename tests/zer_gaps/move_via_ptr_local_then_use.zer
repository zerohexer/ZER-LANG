// GAP (2026-11-13 audit, docs/limitations.md): a move through a pointer local then a use through the original name (use-after-move)
move struct Tok { u32 k; }
struct W { Tok t; }
void consume(Tok t) { }
void eat(*W w) { consume(w.t); }
u32 main() {
    W w;
    *W p = &w;
    eat(p);
    consume(w.t);
    return 0;
}
