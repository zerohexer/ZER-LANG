// BUG-1570 boundary: views and tasks aimed at OUTER storage stay legal.
u32 rd([*]u32 s) { u32 g = 1; *u32 q = &g; { q = &s[1]; } return *q; }
u32 main() { u32[4] o; o[0] = 3; o[1] = 4; u32 g = 1; *u32 q = &g;
  { [*]u32 s = o; q = &s[0]; }
  { [*]u32 p = o[1..3]; q = &p[0]; }
  if (*q != 4) { return 1; }
  return rd(o) - 4; }
