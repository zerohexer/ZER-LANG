// EXPECTED: compile error
// expect-error: use after free
// BUG-1492: an allocation stored through the EXPLICIT 'pool.get(h).f' spelling
// was tracked by nothing ('h.f' was): the read after free(it) returned a recycled slot.
struct Item { u32 v; }
struct Node { *Item p; u32 k; }
Pool(Node, 4) nodes;
u32 main() {
    Handle(Node) nh = nodes.alloc() orelse { return 1; };
    *Item it = alloc(Item) orelse { nodes.free(nh); return 1; };
    it.v = 5;
    nodes.get(nh).p = it;
    free(it);
    *Item j = alloc(Item) orelse { nodes.free(nh); return 1; };
    j.v = 99;
    u32 r = nodes.get(nh).p.v;
    free(j);
    nodes.free(nh);
    return r;
}
