// Tests zercheck_ir.c BUG-618 — orelse-ident alias UAF in IR_ASSIGN.
// 12 paired ?Handle + Handle = ... orelse return declarations grow
// ps->handles past initial cap=8. Without the snapshot fix the analyzer
// reads freed memory and may produce wrong leak/UAF decisions.
// EXPECTED: compiles clean, exits 0 (proper alias tracking — no spurious
// UAF, no spurious leak). BUG-1071: each handle is released by a defer so a
// failing LATER `orelse return` frees the earlier ones — the frees used to sit
// after all twelve allocations, which leaked on every fallback path.
struct Task { u32 id; }
Slab(Task) heap;

void main() {
    ?Handle(Task) m1 = heap.alloc(); Handle(Task) h1 = m1 orelse return; defer heap.free(h1);
    ?Handle(Task) m2 = heap.alloc(); Handle(Task) h2 = m2 orelse return; defer heap.free(h2);
    ?Handle(Task) m3 = heap.alloc(); Handle(Task) h3 = m3 orelse return; defer heap.free(h3);
    ?Handle(Task) m4 = heap.alloc(); Handle(Task) h4 = m4 orelse return; defer heap.free(h4);
    ?Handle(Task) m5 = heap.alloc(); Handle(Task) h5 = m5 orelse return; defer heap.free(h5);
    ?Handle(Task) m6 = heap.alloc(); Handle(Task) h6 = m6 orelse return; defer heap.free(h6);
    ?Handle(Task) m7 = heap.alloc(); Handle(Task) h7 = m7 orelse return; defer heap.free(h7);
    ?Handle(Task) m8 = heap.alloc(); Handle(Task) h8 = m8 orelse return; defer heap.free(h8);
    ?Handle(Task) m9 = heap.alloc(); Handle(Task) h9 = m9 orelse return; defer heap.free(h9);
    ?Handle(Task) m10 = heap.alloc(); Handle(Task) h10 = m10 orelse return; defer heap.free(h10);
    ?Handle(Task) m11 = heap.alloc(); Handle(Task) h11 = m11 orelse return; defer heap.free(h11);
    ?Handle(Task) m12 = heap.alloc(); Handle(Task) h12 = m12 orelse return; defer heap.free(h12);
}
