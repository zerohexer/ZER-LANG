// expect-error: both access non-shared global 'g'
// BUG-1666 (was docs/limitations.md B.11): one thread writes `g` through the pointer field of a global struct (`*h.p += 1`, with
// `H h = { .p = &g };`), the other writes `g` by name. The first access was keyed by the struct `h`, the second
// by `g`, and the two never met.
// ThreadSanitizer reported a data race on the pre-fix compiler, which accepted this.
u32 flagx;
u32 g;
struct H { *u32 p; }
H h = { .p = &g };
void w() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { *h.p += 1; } }
void w2() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { g += 1; } }
i32 main() {
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w2();
    a.join(); b.join();
    return 0;
}
