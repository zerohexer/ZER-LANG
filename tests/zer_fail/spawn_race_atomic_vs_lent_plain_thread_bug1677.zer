// expect-error: both access non-shared global 'counter'
// BUG-1677: two threads the spawn scan finds CLEAN — one touches the cell only
// atomically, the other only through the pointer it was lent — were never
// compared with each other: an @atomic_* is no borrow, so the lend rules saw
// one borrower, and no finding, so nothing was downgraded.
u32 counter;

void bump_plain(*u32 p) {
    for (u32 i = 0; i < 100000; i += 1) { *p += 1; }
}
void bump_atomic() {
    for (u32 i = 0; i < 100000; i += 1) { @atomic_add(&counter, 1); }
}
u32 main() {
    ThreadHandle a = spawn bump_plain(&counter);
    ThreadHandle b = spawn bump_atomic();
    a.join();
    b.join();
    return 0;
}
