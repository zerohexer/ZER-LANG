// BUG-1494: a sub-slice of a slice PARAM (or of a heap slice local) stored into
// a struct field views the memory the slice REFERENCES, not the frame — so the
// struct may be returned, and a heap sub-slice starting at 0 may be freed
// through the field. (Pre-fix: "cannot return pointer to local 'v'" and
// "cannot free() a slice that views non-heap memory".)
struct V { [*]u8 s; }
V mk([*]u8 b) { V v; v.s = b; return v; }
V mk2([*]u8 b) { V v; v.s = b[2..6]; return v; }
u32 main() {
    u8[8] buf;
    V v = mk(buf);
    V w = mk2(buf);
    [*]u8 h = alloc(u8, 8) orelse { return 1; };
    V x;
    x.s = h[0..8];
    x.s[1] = 3;
    free(x.s);
    return (u32)(v.s.len + w.s.len) - 12;
}
