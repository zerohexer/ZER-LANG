// EXPECTED: compile error
// expect-error: CARRIES a Handle
// An OPTIONAL wrapping a by-value struct that carries a Handle, handed to spawn.
// The `?Handle` arm used to match EVERY optional and only report when the inner
// was a bare Handle — so a `?Box` was SWALLOWED there and never reached the
// recursive type_carries_handle check. Narrowed to a bare `?Handle`.
struct T { u32 v; }
struct Box { Handle(T) h; }
Pool(T, 4) p;

void w(?Box ob) { Box b = ob orelse { return; }; u32 x = b.h.v; }

u32 main() {
    Handle(T) h = p.alloc() orelse { return 1; };
    Box b;
    b.h = h;
    ?Box ob = b;
    spawn w(ob);
    return 0;
}
