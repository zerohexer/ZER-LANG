// expect-trap
// expect-trap-msg: defer cleanup
// BUG-1298: an unproven index in a defer body, in the vardecl position, in a function
// WITH a label. The body went through the AST-only defer emitter, which emitted no
// bounds guard in this position: arr[100] on a u32[4] was read silently (exit 0).
// The body is now emitted from its IR template and the guard traps.
u32 g = 0;
u32[4] arr;
void f(u32 k) {
    u32 i = 0;
    defer {
        u32 v = arr[i];
        g = v;
    }
    i = k;
    if (k > 500) { goto out; }
    g += 100;
out:
    g += 1000;
}
u32 main() { f(100); return 0; }
