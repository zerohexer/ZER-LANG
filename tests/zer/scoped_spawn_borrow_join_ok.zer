// BUG-969 (2026-09-07): the borrow through a pointer/slice local is released
// by join() exactly like the `&x` form — writes to the storage AND through the
// pointer after the join must compile and run.
void w(*u32 p) { *p = 5; }
void ws([*]u8 d) { d[0] = 1; }
u32 main() {
    u32 v = 0;
    *u32 q = &v;
    ThreadHandle th = spawn w(q);
    th.join();
    v = 3;
    *q = 4;
    u8[4] buf;
    [*]u8 s = buf;
    ThreadHandle t2 = spawn ws(s);
    t2.join();
    buf[1] = 2;
    if (v != 4) { return 1; }
    if (buf[0] != 1) { return 2; }
    return 0;
}
