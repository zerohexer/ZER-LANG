// expect-error: @bitcast cannot build a '_zer_async_worker'
// BUG-1432: the @bitcast door to the same task frame (ASan stack-buffer-overflow
// at the resuming poll).
u32 get(u32 a) { return a; }
u32[4] arr;
async void worker() { u32 i = get(1); if (i < 4) { yield; arr[i] = 7; } }
u32 main() {
    _zer_async_worker task;
    _zer_async_worker_init(&task);
    i32 d = _zer_async_worker_poll(&task);
    task = @bitcast(_zer_async_worker, 21474836481);
    d = _zer_async_worker_poll(&task);
    return 42;
}
