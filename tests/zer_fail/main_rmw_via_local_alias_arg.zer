// EXPECTED: compile error
// expect-error: read-modify-written and is shared
// BUG-1046 (RMW REACH): the pointer to `g` reaches the read-modify-write through
// a vehicle the resolvers never followed — a local alias passed as the ARGUMENT, at the main-side sink (the two scans already resolved it). Accepted on main before the fix
// (measured); a torn read-modify-write that loses an update, silent on bare metal.
volatile u32 g;
void bump(volatile *u32 p) { *p += 1; }
interrupt TIM2 { g = 1; }
u32 main() { volatile *u32 q = &g; bump(q); return 0; }
