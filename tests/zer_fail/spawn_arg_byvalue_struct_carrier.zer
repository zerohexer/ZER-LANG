// EXPECTED: compile error
// expect-error: cannot pass a value that CARRIES a Handle to spawn
// Promoted from tests/zer_gaps/ on 2026-08-03 — the gap CLOSED the same day.
//
// `spawn worker(h)` with a bare Handle was always rejected; wrapping the same
// handle in a by-value struct slipped every arm of the spawn-arg gate, and the
// emitted worker really derefed it (`_zer_pool_get(..., b.h, 4)->v`) while the
// parent ran `p.free(h)`. The wrapper-hides-the-inner-kind family at the spawn
// sink. Fixed by making the gate ask type_carries_handle() instead of testing
// the bare argument kind, so nested / optional / distinct / array carriers are
// all covered by one predicate.
//
// The exhaustive half is the CARRIER GRID in tests/test_conc_matrix.c
// (carrier x payload x sink); this file pins the specific shape.
struct T{u32 v;}
struct Box{ Handle(T) h; }
Pool(T,4) p;

void worker(Box b){ u32 x = b.h.v; }

u32 main(){
    Handle(T) h = p.alloc() orelse { return 1; };
    Box b;
    b.h = h;
    spawn worker(b);
    p.free(h);
    return 0;
}
