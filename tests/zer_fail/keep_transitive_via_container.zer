// EXPECTED: compile error
// expect-error: cannot satisfy 'keep' parameter
// BUG-1045: keep INFERENCE is transitive — `inner` stores its param, so `outer`'s
// param must become keep too and `outer(&d.list)` must be refused. The trace from
// the argument to the caller's param peeled every intrinsic to its LAST argument,
// which for @container(*T, ptr, field) is the FIELD NAME, so the chain broke and
// a pointer into main's frame was stored in a global. The direct `inner(p)`
// spelling was always refused.
struct L { u32 x; }
struct D { u32 a; L list; }
?*D g;
void inner(*D d) { g = d; }
void outer(*L p) { inner(@container(*D, p, list)); }
u32 main() { D d; outer(&d.list); return 0; }
