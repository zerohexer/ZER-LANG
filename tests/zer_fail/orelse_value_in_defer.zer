// EXPECTED: compile error
// orelse with a value/block fallback inside a defer body is banned:
// defer bodies are raw-AST emitted and cannot express orelse's branch
// (would emit a compiler-bug trap + duplicate-temp gcc error).
u32 g = 5;
?u32 maybe() { return 7; }
u32 main() {
    defer { u32 z = maybe() orelse g; }
    return 0;
}
