// expect-trap
// BUG-974 boundary: a u8 index proves in-range only for an array of 256 or more.
// Into an array of 255 the type bound (255) is NOT below the size, so the inline
// runtime bounds check must stay — and here it fires (the index is 255).
// The index is written as an EXPRESSION on purpose: a bare ident that is not
// proven takes the auto-guard path (a silent early return, exit 0), which cannot
// pin the boundary; an expression index gets the inline _zer_bounds_check trap.
// A helper that compared with `<=` instead of `<` would elide the check here and
// write one past the end without any signal — that is what this test catches.
u32[255] arr;
u32 pick() { return 0xFFFFFFFF; }
u32 main() {
    u32 x = pick();
    arr[@truncate(u8, x)] = 1;
    return 0;
}
