// BUG-1651 boundary: an exit that follows a join of the handle IN THE SAME
// statement list does not open the window (the thread is dead on that path),
// and an open window is released by its own tail join.
void w(*u32 p) { *p += 1; }
u32 early(u32 err) {
    u32 x = 0;
    x = 5;
    ThreadHandle th = spawn w(&x);
    if (err != 0) { th.join(); return 1; }
    th.join();
    return x;
}
u32 looped() {
    u32 x = 0;
    for (u32 i = 0; i < 3; i += 1) {
        ThreadHandle th = spawn w(&x);
        if (i == 1) { th.join(); break; }
        th.join();
    }
    x += 1;
    return x;
}
u32 tail() {
    u32 x = 0;
    ThreadHandle th = spawn w(&x);
    goto A;
A:
    th.join();
    x += 1;
    return x;
}
u32 inner_loop() {
    u32 x = 0;
    u32 n = 0;
    ThreadHandle th = spawn w(&x);
    for (u32 k = 0; k < 4; k += 1) { if (k == 2) { break; } n += 1; }
    th.join();
    return x + n;
}
u32 main() {
    if (early(0) != 6) { return 1; }
    if (early(1) != 1) { return 2; }
    if (looped() != 3) { return 3; }
    if (tail() != 2) { return 4; }
    if (inner_loop() != 3) { return 5; }
    return 0;
}
