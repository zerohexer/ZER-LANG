union U { u32 n; P p; }
?U mu(u32 k) { U u; if (k == 0) { return null; } u.n = 4; return u; }
u32 main() {
    u32 r = 0;
    switch (mu(1)) {
        .n => { r += 1; }
        .p => { r += 10; }
    }
    return r;
}
