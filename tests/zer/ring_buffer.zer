// Ring buffer — FIFO with push/pop/push_checked
// Tests: Ring(T, N), optional unwrap, orelse

Ring(u32, 8) fifo;

u32 main() {
    // Push 5 items
    fifo.push(10);
    fifo.push(20);
    fifo.push(30);
    fifo.push(40);
    fifo.push(50);

    // Pop in FIFO order
    u32 v = fifo.pop() orelse return;
    if (v != 10) { return 1; }
    v = fifo.pop() orelse return;
    if (v != 20) { return 2; }
    v = fifo.pop() orelse return;
    if (v != 30) { return 3; }

    // Push more
    fifo.push(60);
    fifo.push(70);

    // Pop remaining
    v = fifo.pop() orelse return;
    if (v != 40) { return 4; }
    v = fifo.pop() orelse return;
    if (v != 50) { return 5; }
    v = fifo.pop() orelse return;
    if (v != 60) { return 6; }
    v = fifo.pop() orelse return;
    if (v != 70) { return 7; }

    // Empty pop returns null
    ?u32 empty = fifo.pop();
    if (empty) |val| { return 8; }

    // push_checked on a full ring must REPORT the overflow.
    //
    // This section used to read `fifo.push_checked(99) orelse return;` followed
    // by a comment that could not decide whether it should succeed or fail. In a
    // `u32 main()` a bare `return` yields 0, which IS the pass code, so the
    // section asserted NOTHING either way — the self-cancelling vacuous form
    // (CLAUDE.md "VACUOUS TESTS"). Measured and asserted now: overflow on a full
    // ring, success on a ring with room.
    for (u32 i = 0; i < 8; i += 1) {
        fifo.push(i);
    }
    ?void full = fifo.push_checked(99);
    if (full) { return 9; }             // must NOT succeed — the ring is full

    v = fifo.pop() orelse { return 10; };
    ?void room = fifo.push_checked(99);
    if (room) { return 0; }             // must succeed — one slot freed
    return 11;
}
