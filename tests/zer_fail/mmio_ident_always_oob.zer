// expect-error: always out of range
// EXPECTED: compile error
//
// The MMIO sibling of bounds_ident_always_oob.zer. The mmio declaration bounds
// the pointer to 4 u32 words; index 100 is provably past the end. Before
// 2026-08-16 this only warned and got the silent auto-guard — on bare metal a
// peripheral write that never happens, with no fault to notice it by.
mmio 0x40000000..0x4000000F;

u32 main() {
    volatile *u32 reg = @inttoptr(*u32, 0x40000000);
    u32 i = 100;
    return reg[i];
}
