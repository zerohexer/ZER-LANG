// expect-error: cannot assign to '.len' of a slice
// BUG-967: the forge reached through a STRUCT FIELD rather than a bare local. The
// rule keys on the type of the object immediately under the `.len`, so every
// nesting depth and every route to it — a struct field, a nested struct, an array
// element, a pointer auto-deref, a global — is covered by the same test rather
// than needing a case each. This pins the property.
struct Inner { [*]u8 d; }
struct Outer { Inner i; }
u32 main() {
    u8[4] a;
    Outer o;
    o.i.d = a;
    o.i.d.len = 100;
    o.i.d[50] = 1;
    return 0;
}
