// Gap 31 regression test (2026-04-27, Stage 2): range-for must snapshot
// collection.len BEFORE the loop. Re-binding the slice to a LONGER view inside
// the body must NOT change the bound mid-iteration.
//
// BUG-959 (2026-09-07): this test used to write `slice.len = 10;` directly.
// The slice header is now read-only (a writable `.len` forges any bound), so
// the mutation is spelled as a whole-slice re-bind, which is the legal way to
// change what a slice covers.

i32 main() {
    u8[10] data;
    data[0] = 1; data[1] = 2; data[2] = 3; data[3] = 4; data[4] = 5;
    [*]u8 slice = data[0..5];
    u32 count = 0;
    for (u8 b in slice) {
        count += 1;
        if (count == 2) {
            slice = data[0..10];  // re-bind mid-loop — must NOT affect snapshot
        }
    }
    if (count != 5) { return 1; }   // snapshot held; loop ran exactly 5 times
    if (slice.len != 10) { return 2; }
    return 0;
}
