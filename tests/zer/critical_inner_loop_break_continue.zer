// `break` / `continue` targeting a loop INSIDE an @critical block stay inside the
// block (interrupts are re-enabled at its end as usual), so they are allowed
// (relaxed 2026-09-05). A break of a loop that ENCLOSES the @critical block still
// leaves it early and stays rejected.
u32 g;
u32 main() {
    @critical {
        for (u32 i = 0; i < 10; i += 1) {
            if (i == 4) { break; }
            if (i == 1) { continue; }
            g += 1;
        }
    }
    if (g != 3) { return 1; }
    return 0;
}
