// expect-error: use after free
// BUG-984: the INDEX sibling — `arr[0] = alloc(T);` into an optional-pointer
// array element was equally untracked.
struct T { u32 v; }
u32 main() {
    ?*T[2] arr;
    arr[0] = alloc(T);
    *T q = arr[0] orelse return;
    free(q);
    *T r = arr[0] orelse return;
    return r.v;
}
