// GAP (2026-11-14, docs/limitations.md section B item 11): a local pointer starts at the thread's own stack and is
// re-aimed from a call result LATER in the loop body (`*p += 1; p = getp();`): on the second turn `*p` is the
// global. The walk reads bindings in source order.
// ThreadSanitizer reports a data race. Compile-clean IS the gap.
u32 flagx;
u32 g;
*u32 getp() { return &g; }
void w() { @atomic_store(&flagx, 1); u32 loc = 0; *u32 p = &loc; for (u32 i = 0; i < 100000; i += 1) { *p += 1; p = getp(); } }
void w2() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { g += 1; } }
i32 main() {
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w2();
    a.join(); b.join();
    return 0;
}
