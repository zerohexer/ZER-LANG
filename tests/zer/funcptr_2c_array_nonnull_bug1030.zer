// BUG-1030: the typedef-free 2C funcptr ARRAY in its NON-nullable spelling,
// `*(u32) -> u32 [2] ops;`, did not parse ("expected name at '['") — parse_type's
// `*(` branch returned the funcptr type without ever reaching the array-suffix
// branch, while `?*(u32) -> u32 [2]` worked because the `?` handler has its own
// suffix check. reference.md and CLAUDE.md both documented the failing form.
// ONE helper (parse_array_suffix) now serves all three sites; it also honours
// no_array_suffix so `*(u32) -> ?u32 [2]` is an array of funcptrs returning ?u32.
u32 inc(u32 x) { return x + 1; }
?u32 mk(u32 x) { return x; }

?*(u32) -> u32 [2] g1;
*(u32) -> u32 [2] g2;
*(u32) -> ?u32 [2] g3;

u32 main() {
    ?*(u32) -> u32 [2] l1;
    *(u32) -> u32 [2][3] l2;
    *(u32) -> ?u32 [2] l3;
    g1[0] = inc;
    l1[1] = inc;
    g2[1] = inc;
    l2[2][1] = inc;
    g3[0] = mk;
    l3[1] = mk;
    u32 a = g2[1](1);
    u32 b = l2[2][1](2);
    u32 c = g3[0](5) orelse 0;
    u32 d = l3[1](7) orelse 0;
    if (a != 2 || b != 3 || c != 5 || d != 7) { return 1; }
    if (g1[0]) |f| { if (f(3) != 4) { return 2; } } else { return 3; }
    if (l1[1]) |f| { if (f(3) != 4) { return 4; } } else { return 5; }
    [*]*(u32) -> u32 s = g2;
    g2[0] = inc;
    if (s[0](9) != 10) { return 6; }
    return 0;
}
