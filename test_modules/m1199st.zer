// BUG-1199: a module STATIC, reached only through this module's functions.
struct Rec { u32 v; }
static u32 scnt;
static Pool(Rec, 4) spool;
static u32 sac;
void sbump() { for (u32 i = 0; i < 1000; i += 1) { scnt += 1; } }
u32 sread() { return scnt; }
u32 salloc() { Handle(Rec) h = spool.alloc() orelse return; spool.free(h); return 1; }
void sabump() { @atomic_add(&sac, 1); }
u32 saread() { return sac; }
