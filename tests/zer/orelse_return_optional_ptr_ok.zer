// BUG-962 boundary: `orelse return` stays legal where the auto-zero IS a value
// of the return type — an optional pointer (None), an integer (0), void.
struct T { u32 v; }
?*T pick(?*T o) { *T t = o orelse return; return t; }
u32 count(?u32 o) { u32 v = o orelse return; return v + 1; }
void touch(?u32 o) { u32 v = o orelse return; g = v; }
u32 g = 0;
u32 main() {
    T x; x.v = 5;
    ?*T r = pick(null);
    if (r) |p| { return 1; }
    ?*T r2 = pick(&x);
    *T p2 = r2 orelse return;
    if (p2.v != 5) { return 2; }
    if (count(null) != 0) { return 3; }
    if (count(4) != 5) { return 4; }
    touch(null); touch(9);
    return g - 9;
}
