// BUG-920: a `switch` and a `do-while` INSIDE a defer body. The raw-AST defer
// emitter had no handler for either and emitted a runtime trap ("compiler bug:
// unsupported stmt kind in defer") on valid code. Lowered through IR now.
u32 g;
u32 h;
u32 f() {
    u32 x = 2;
    defer {
        switch (x) {
            2 => { g = 5; }
            default => { g = 1; }
        }
    }
    u32 y = 0;
    defer { do { y += 1; } while (y < 3); h = y; }
    return 0;
}
u32 main() {
    u32 r = f();
    if (r != 0) { return 1; }
    if (g != 5) { return 2; }
    if (h != 3) { return 3; }
    return 0;
}
