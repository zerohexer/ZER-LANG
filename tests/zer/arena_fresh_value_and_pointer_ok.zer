// BUG-916 boundary: a FRESH value is not a copy of an existing object.
// `Arena.over(...)` as an initializer or a reassignment, and a LOCAL Arena
// returned by value from a factory (a move — the local dies with the frame)
// must all keep compiling; only copying an object that outlives the copy
// (`Arena b = a;`, a global returned by value, a by-value param) is refused.
struct T { u32 v; }
u8[64] gbuf;
u8[64] gbuf2;
Arena mk() { Arena a = Arena.over(gbuf); return a; }
u32 main() {
    Arena a = mk();
    *T t = a.alloc(T) orelse return;
    t.v = 4;
    u32 r = t.v;
    a = Arena.over(gbuf2);
    *T u = a.alloc(T) orelse return;
    u.v = 5;
    if (r + u.v != 9) { return 1; }
    return 0;
}
