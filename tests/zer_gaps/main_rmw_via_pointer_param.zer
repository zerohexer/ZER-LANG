// gap-masked-by: interrupt service routine can only have a pointer argument
// (GCC refuses __attribute__((interrupt)) on hosted x86-64, so this file cannot
//  reach a clean exit here regardless of the checker. The CHECKER's verdict is
//  the gap: `zerc <this> -o out.c` emits NO diagnostic.)
// GAP (2026-08-17, BUG-792): an RMW reached from MAIN through a helper is not
// attributed to main, so "shared between interrupt and main" never fires.
// The ISR side of this family is CLOSED (see tests/zer_fail/isr_rmw_*.zer); this
// is the one remaining form. The mirror of ISR-TRANS (a transitive walk over every
// regular function body) was implemented and REVERTED: with the walker's depth-32
// call descent it is exponential and hung test_firmware_patterns for >4 minutes.
// The right fix is a MEMOISED per-function RMW summary (bit n = performs an RMW
// through param n), computed once per function like ret_param_mask.
// EXPECTED: compile error
// RMW-LAUNDER, main-code (`from_func`) half: main performs the laundered RMW
// and the ISR only stores. main's read-modify-write can be interrupted between
// its load and its store, so the ISR's write is silently clobbered.
volatile u32 g;

void bump(volatile *u32 p) { *p += 1; }

interrupt TIM2 { g = 1; }

u32 main() { bump(&g); return 0; }
