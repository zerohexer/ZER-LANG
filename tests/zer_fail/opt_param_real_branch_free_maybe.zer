// expect-error: freed
// BUG-988 boundary: a free under a REAL runtime branch is MAYBE — the null-path skip
// applies only to the param's own `orelse return`.
struct T { u32 v; }
u32 pick() { return 0; }
void f(?*T p) { *T q = p orelse return; if (pick() == 1) { free(q); } }
u32 main() {
    ?*T mp = alloc(T);
    f(mp);
    return 0;
}
