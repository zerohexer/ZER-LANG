// EXPECTED: compile error
// expect-error: maybe-freed
// BUG-1360: fp(id(a)) hands a to an unknown callee (argument-precise barrier).
struct T { u32 v; }
*T id(*T p) { return p; }
void killp(*T p) { free(p); }
u32 main() {
    *T a = alloc(T) orelse return;
    *(*T) fp = killp;
    fp(id(a));
    *T b = alloc(T) orelse { free(a); return 0; };
    b.v = 7;
    a.v = 99;
    u32 r = b.v;
    free(b);
    free(a);
    return r;
}
