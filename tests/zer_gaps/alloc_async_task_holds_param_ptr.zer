// GAP (2026-11-13 audit, docs/limitations.md): an async task holding a pointer PARAMETER of the function is polled after the pointer is freed (exit 99)
struct T { u32 v; }
async void co(*T p) {
    yield;
    p.v = 99;
}
u32 run(*T a) {
    _zer_async_co task;
    _zer_async_co_init(&task, a);
    _zer_async_co_poll(&task);
    free(a);
    *T b = alloc(T) orelse return;
    b.v = 5;
    _zer_async_co_poll(&task);
    u32 r = b.v;
    free(b);
    return r;
}
u32 main() {
    *T a = alloc(T) orelse return;
    return run(a);
}
