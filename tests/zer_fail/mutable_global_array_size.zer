// EXPECTED: compile error
// expect-error: array size must be a compile-time constant
// BUG-860 boundary: the relaxation resolves through resolve_const_ident, which
// requires sym->is_const. A MUTABLE global must still be rejected — otherwise a
// VLA would slip in behind a fixed-array type.
u32 N = 4;

i32 main() {
    u8[N] b;
    b[0] = 1;
    return 0;
}
