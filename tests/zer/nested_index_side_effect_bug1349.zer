// BUG-1349: a single-evaluation index form `*({...; &a[i]; })` used as the operand
// of a further `[j]` / `.f` parsed as `*(({...})[j])` — `m[id(1)][2] = 7` wrote
// m[3][0] (and m[id(2)][2] overflowed the stack); `rs[id(1)].x` did not compile;
// and the outer index ran before the inner one.
struct R { u32 x; u32 y; }
struct S { u32[4][4] m; }
u32 lg = 0;
u32 id(u32 v) { return v; }
u32 t(u32 d) { lg = lg * 10 + d; return d - 1; }
u32 main() {
    u32[4][4] m;
    m[id(1)][2] = 7;
    if (m[1][2] != 7 || m[3][0] != 0) { return 1; }
    u32 r = m[id(1)][2];
    if (r != 7) { return 2; }
    m[id(1)][2] += 1;
    if (m[1][2] != 8) { return 3; }
    R[3] rs;
    rs[id(1)].x = 5;
    if (rs[1].x != 5 || rs[1].y != 0) { return 4; }
    S s;
    s.m[t(1)][t(2)] = 5;
    if (lg != 12 || s.m[0][1] != 5) { return 5; }
    volatile u32 vi = 2;
    m[vi][3] = 9;
    if (m[2][3] != 9) { return 6; }
    return 0;
}
