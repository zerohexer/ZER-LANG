// EXPECTED: compile error
// expect-error: may be a view of
// BUG-1131 backstop: the field was filled by a callee through `*H`. Pre-fix: compiled.
struct T { u32 v; }
struct H { *T p; }
void fill(*H o, *T a) { o.p = a; }
H mk(*T a) { H h; fill(&h, a); return h; }
u32 main() {
    *T a = alloc(T) orelse return;
    a.v = 5;
    H h = mk(a);
    free(a);
    return h.p.v;
}
