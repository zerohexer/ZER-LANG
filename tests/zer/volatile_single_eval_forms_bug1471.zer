// BUG-1471..1474: every form that writes a place / operand more than once now
// evaluates a VOLATILE read in it exactly once (tools/emit_audit.sh counts the
// loads); this checks the single-evaluation forms still compute the right values.
shared struct S { u32 v; }
volatile u32 hv = 3;
u32[8] g;
i32[8] gi;
u32[8][8] m;
S[4] gs;
void bump([*]S sl) { sl[hv % 2].v += 1; }
u32 main() {
    for (u32 k = 0; k < 8; k += 1) { g[k] = 1; gi[k] = -64; }
    g[hv % 8] <<= 3;
    if (g[3] != 8) { return 1; }
    g[hv % 8] >>= 1;
    if (g[3] != 4) { return 2; }
    gi[hv % 8] /= 2;
    if (gi[3] != -32) { return 3; }
    gi[hv % 8] %= 5;
    if (gi[3] != -2) { return 4; }
    if (@ctz(hv) != 0) { return 5; }
    if (@clz(hv + 1) != 29) { return 6; }
    m[3][4] = 7;
    if (m[hv % 8][(hv + 1) % 8] != 7) { return 7; }
    S[2] pair;
    bump(pair[0..2]);
    if (pair[1].v != 1) { return 8; }
    gs[hv % 4].v += 2;
    if (gs[hv % 4].v != 2) { return 9; }
    for (u32 i = 0; i < 3; gs[hv % 4].v += 1) { i += 1; }
    if (gs[3].v != 5) { return 10; }
    return 0;
}
