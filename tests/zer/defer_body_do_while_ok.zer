// BUG-913: `do { } while` in a defer body used to fall to emit_defer_stmt's loud
// default — the compiler exited 0 and the emitted C trapped with
// "compiler bug: unsupported stmt kind in defer". It is the sibling of the
// `while` arm that walker already had. static_assert is here for the same
// reason: it generates no code, and it too hit the default.
u32 g = 0;
u32 main() {
    {
        u32 i = 0;
        defer {
            static_assert(1 == 1, "compile-time only, emits nothing");
            do { g += 1; i += 1; } while (i < 3);
        }
    }
    if (g != 3) { return 1; }
    return 0;
}
