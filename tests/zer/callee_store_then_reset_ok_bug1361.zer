// BUG-1361/1352 boundary.
// BUG-1361 / BUG-1362 boundary: a callee that stores its argument into an
// element / the whole object / a global is fine while the allocation lives,
// and freeing it through the container (then resetting) is the idiom.
struct T { u32 v; }
struct PT { ?*T p; }
struct S { PT[4] data; u32 top; }
?*T g;
void put(*S s, *T p, u32 k) { s.data[k].p = p; }
void whole(*PT s, *T p) { *s = { .p = p }; }
void reg(*T p) { g = p; }
u32 main() {
    u32 r = 0;
    *T a = alloc(T) orelse return;
    a.v = 2;
    S s;
    put(&s, a, 1);
    if (s.data[1].p) |q| { r += q.v; }
    free(a);
    s.data[1].p = null;

    *T b = alloc(T) orelse return;
    b.v = 3;
    PT w;
    whole(&w, b);
    if (w.p) |q| { r += q.v; }
    free(b);
    w.p = null;

    *T c = alloc(T) orelse return;
    c.v = 4;
    reg(c);
    if (g) |q| { r += q.v; }
    g = null;
    free(c);
    return r - 9;
}
