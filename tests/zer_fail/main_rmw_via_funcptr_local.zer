// EXPECTED: compile error
// expect-error: to a call through a function pointer
// BUG-1046 (RMW REACH): the pointer to `g` reaches the read-modify-write through
// a vehicle the resolvers never followed — a call through a LOCAL function pointer, whose target the summary cannot name. Accepted on main before the fix
// (measured); a torn read-modify-write that loses an update, silent on bare metal.
volatile u32 g;
void bump(volatile *u32 p) { *p += 1; }
interrupt TIM2 { g = 1; }
u32 main() { *(volatile *u32) fp = bump; fp(&g); return 0; }
