// expect-trap
// expect-trap-msg: wrong-pool handle
struct T { u32 v; }
Pool(T, 4) pa;
Pool(T, 4) pb;
Handle(T)[2] gh;
void stash(Handle(T) x) { gh[0] = x; }
u32 main() {
    Handle(T) g = pb.alloc() orelse return;
    defer pb.free(g);
    pb.get(g).v = 9;
    // No `defer pa.free(h)`: stash() hands h to a global, and freeing it at
    // exit would leave gh[0] dangling (BUG-1352 — the direct spelling
    // `gh[0] = h;` is refused for the same reason). The global owns it.
    Handle(T) h = pa.alloc() orelse return;
    pa.get(h).v = 5;
    stash(h);
    u32 r = pb.get(gh[0]).v;
    return r;
}
