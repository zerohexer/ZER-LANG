// EXPECTED: compile error
// expect-error: use after free
// BUG-1012: the SUMMARY free sink — consume(q) frees its param; q is a view of
// slot 1, so the callee's free widens slot 1 and the later read is rejected.
struct T { u32 v; }
struct H { ?*T p; }
void consume(*T t) { free(t); }
u32 pick() { return 1; }
u32 main() {
    H[2] hs;
    hs[1].p = alloc(T);
    u32 k = pick();
    *T q = hs[k].p orelse return;
    consume(q);
    *T r = hs[1].p orelse return;
    return r.v;
}
