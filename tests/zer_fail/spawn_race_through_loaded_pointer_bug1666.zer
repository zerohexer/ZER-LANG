// expect-error: reached through a reference the compiler cannot name
// BUG-1666 (was docs/limitations.md B.11): both threads only READ the global `h`; the pointer they load from it was aimed at `g` at
// run time, and `*q += 1` was attributed to nothing.
// ThreadSanitizer reported a data race on the pre-fix compiler, which accepted this.
u32 flagx;
u32 g;
struct H { ?*u32 p; }
H h;
void w() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { if (h.p) |q| { *q += 1; } } }
void w2() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { if (h.p) |q| { *q += 1; } } }
i32 main() {
    h.p = &g;
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w2();
    a.join(); b.join();
    return 0;
}
