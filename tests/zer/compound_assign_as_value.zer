// BUG-1041: a COMPOUND assignment used as a VALUE. Every form below aborted the
// compiler with "IR VALIDATION ERROR: ... BINOP missing operand" — the compound
// arm of lower_expr answered -1 ("statement-like") and the consumer stored it as
// an operand. The plain `(x = 5) + 1` form always worked. Semantics are C's: the
// value is the stored value, and the target is evaluated ONCE (idx() below runs
// exactly once — the returned k proves it).
shared struct C { u32 v; }
C g;
u32 k;
u32 idx() { k += 1; return 0; }
u32 id(u32 v) { return v; }
u32 main() {
    u32 x = 0;
    if ((x += 1) > 3) { return 1; }            /* condition operand */
    u32 y = (x += 1) + 2;                      /* binary operand: x=2 -> y=4 */
    if (y != 4) { return 2; }
    *u32 p = &x;
    if ((*p += 1) > 3) { return 3; }           /* through a pointer: x=3 */
    if (x != 3) { return 4; }
    u32 z = id((x += 1));                      /* call argument: x=4 */
    if (z != 4) { return 5; }
    u32[4] a;
    u32 w = (a[idx()] += 5) + 1;               /* side-effecting target, once */
    if (w != 6 || k != 1 || a[0] != 5) { return 6; }
    u32 s = (g.v += 2) + 1;                    /* shared struct, per-statement lock */
    if (s != 3 || g.v != 2) { return 7; }
    u3 n = 3;
    u32 m = (u32)(n += 7) + 1;                 /* uN target: 3+7 wraps to 2 -> 3 */
    if (m != 3 || n != 2) { return 8; }
    return 0;
}
