// BUG-1390: a defer followed by a loop that never exits aborted the compiler
// (IR validation required a reachable DEFER_FIRE even when no exit is reachable).
u32 g = 0;
void run() { defer { g = 1; } for (;;) { if (g == 5) { return; } g += 1; } }
void spin() { defer { g = 2; } for (;;) { } }
void spin2() { defer { g = 3; } for (u32 i = 0; ; i += 1) { } }
void spin3() { defer { g = 4; } l: goto l; }
u32 main() {
    volatile u32 never = 0;
    if (never == 42) { spin(); spin2(); spin3(); }
    run();
    if (g != 1) { return 1; }
    return 0;
}
