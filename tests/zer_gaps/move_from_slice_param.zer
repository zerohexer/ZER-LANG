// GAP (2026-11-13 audit, docs/limitations.md): a callee moves out of a slice param element; the caller moves it again (use-after-move)
move struct Tok { u32 k; }
void consume(Tok t) { }
void eat([*]Tok s) { consume(s[0]); }
u32 main() {
    Tok[2] ts;
    eat(ts);
    consume(ts[0]);
    return 0;
}
