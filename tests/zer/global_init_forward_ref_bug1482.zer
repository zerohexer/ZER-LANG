// BUG-1482: a global initializer naming a global declared LATER in the file (address-of,
// a cycle of struct literals, a slice of a later array, @ptrtoint, static, volatile) —
// GCC saw the reference before the definition ("'g' undeclared").
*u32 p = &g;
u32 g = 42;
struct N { ?*N next; u32 v; }
N a = { .next = &b, .v = 1 };
N b = { .next = &a, .v = 2 };
[*]u8 s = buf[0..2];
u8[4] buf;
usize ap = @ptrtoint(&g2);
u32 g2 = 5;
const u32 K = 7;
volatile u32 vv = 3;
*u32 pk = &kk;
static u32 kk = 9;
volatile *u32 pv = &vv2;
volatile u32 vv2 = 11;
u32 main() {
    if (*p != 42) { return 1; }
    if (b.next == null) { return 2; }
    if (s.len != 2) { return 3; }
    if (ap == 0) { return 4; }
    if (*pk != 9) { return 5; }
    if (*pv != 11) { return 6; }
    N x = a;
    if (x.v != 1) { return 7; }
    return 0;
}
