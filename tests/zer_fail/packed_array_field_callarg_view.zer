// EXPECTED: compile error
// expect-error: argument 1 points into a PACKED struct field
// BUG-971 (2026-09-07): the CALL-ARG sink — `fill(p.w)` into a `[*]u32`
// parameter coerces the packed array field to a slice view. (An array
// PARAMETER is by-reference in the emitted C too, so `u32[2]` would be a view
// as well; only a by-value SCALAR or an array LOCAL is a real copy.)
packed struct P { u8 a; u32[2] w; }
void fill([*]u32 s) { s[0] = 9; }
u32 main() {
    P p;
    fill(p.w);
    return 0;
}
