// expect-error: ThreadHandle 'th' re-spawned while the thread spawned at line
// BUG-1422: the atomic-cell sibling — the concurrent window closes at the one
// join, but two earlier threads are still running @atomic_add afterwards. Same
// root: the handle was overwritten.
// (2026-11-15: this file ended in a plain `g = 0; return g;`. Since BUG-1677 a
// thread that is all-atomic is judged against its spawner's window, and under a
// goto that window is the whole function — so the checker refused the plain
// write FIRST, and the re-spawn rule this file is here for never got to speak.
// The tail is atomic now; the plain one is
// spawn_race_respawn_lost_threads_plain_write_bug1677.zer.)
u32 g;
void w() { for (u32 k = 0; k < 1000000; k += 1) { @atomic_add(&g, 1); } }
u32 main() {
    u32 i = 0;
again:
    ThreadHandle th = spawn w();
    i += 1;
    if (i < 3) { goto again; }
    th.join();
    @atomic_store(&g, 0);
    return @atomic_load(&g);
}
