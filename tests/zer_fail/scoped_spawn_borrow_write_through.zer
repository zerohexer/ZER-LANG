// EXPECTED: compile error
// expect-error: cannot write to 'q' while it is borrowed by a scoped spawn
// BUG-969 (2026-09-07): the pointer local itself is borrowed too — a parent
// write THROUGH it (`*q = 3`) reaches the storage the thread is mutating.
void w(*u32 p) { *p = 5; }
u32 main() {
    u32 v = 0;
    *u32 q = &v;
    ThreadHandle th = spawn w(q);
    *q = 3;
    th.join();
    return v;
}
