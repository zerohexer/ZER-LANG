// BUG-1303 boundary: the same object as both arguments is fine when the callee
// uses the second only AFTER the join; distinct objects are fine during the window.
void w(*u32 p) { *p = *p + 1; }
void f(*u32 a, *u32 b) {
    ThreadHandle t = spawn w(a);
    t.join();
    *b = *b + 5;
}
void g(*u32 a, *u32 b) {
    ThreadHandle t = spawn w(a);
    *b = 5;
    t.join();
}
u32 main() {
    u32 v = 0;
    u32 x = 0;
    f(&v, &v);
    g(&v, &x);
    if (v != 7) { return 1; }
    if (x != 5) { return 2; }
    return 0;
}
