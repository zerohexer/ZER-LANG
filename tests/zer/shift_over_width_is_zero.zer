// Promoted from tests/zer_gaps/ast_shift_over_width.zer (2026-11-13): filed as a gap, measured correct.
// A shift by >= the width yields 0 (defined), here through a value VRP cannot fold.
u32 main() {
    u32 x = 5;
    u32 n = 40;  // > 32, should be treated as 0
    for (u32 i = 0; i < 1; i += 1) { n = 40; }
    return x << n;
}
