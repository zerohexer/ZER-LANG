// BUG-959 boundary: READING .len / .ptr stays legal; only writes are refused.
u32 total([*]u8 s) { u32 n = 0; for (usize i = 0; i < s.len; i += 1) { n += s[i]; } return n; }
u32 main() {
    u8[4] a; a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    [*]u8 s = a;
    usize l = s.len;
    const *u8 p = s.ptr;
    [*]u8 t = s[1..3];
    if (l != 4) { return 1; }
    if (t.len != 2) { return 2; }
    if (*p != 1) { return 3; }
    return total(s) - 10;
}
