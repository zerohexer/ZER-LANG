// expect-error: cannot mutate union 'w' inside its own switch arm
// BUG-1377: `w = w2;` inside `switch (w.u)` replaces the union under the live
// `|*bq|` capture — the key comparison read the ANCESTOR `w` as "a different
// element" of `w.u`. The capture then read a *T as a *Big (ASan
// global-buffer-overflow).
struct T { u32 v; }
struct Big { u32[64] a; }
T t0;
Big b0;
union U { *T p; *Big q; }
struct W { U u; }
u32 main() {
    W w;
    w.u.q = &b0;
    W w2;
    w2.u.p = &t0;
    u32 r = 0;
    switch (w.u) {
        .q => |*bq| { w = w2; r = (*bq).a[2]; }
        .p => |m| { r = 1; }
    }
    return r;
}
