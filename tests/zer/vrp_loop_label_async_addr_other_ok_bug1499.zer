// BUG-1499..1503 boundary: taking the address of a DIFFERENT variable in a loop
// or after a label, and an async frame local with no call before its use, keep
// their proofs and run correctly.
u32[4] arr;
u32[64] pad;
u32 g;
void w(*u32 q) { *q = 4; }
async void t() {
    u32 i = 1;
    yield;
    i = 2;
    arr[i] = 7;
}
u32 main() {
    u32 i = 1;
    u32 j = 0;
    for (u32 k = 0; k < 2; k += 1) {
        arr[i] = 7;
        ThreadHandle th = spawn w(&j);
        th.join();
    }
    u32 n = 0;
    *u32 p = &g;
top:
    n += 1;
    if (i < 4) { *p = 4; arr[i] = 8; }
    p = &j;
    if (n < 2) { goto top; }
    _zer_async_t task;
    _zer_async_t_init(&task);
    _zer_async_t_poll(&task);
    _zer_async_t_poll(&task);
    if (arr[1] != 8 || arr[2] != 7 || j != 4) { return 1; }
    return 0;
}
