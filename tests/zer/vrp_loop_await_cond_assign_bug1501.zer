// BUG-1501: `await ((i = 4) > 0)` — the await CONDITION writes i.
u32[4] arr;
u32[64] pad;
u32 hit = 0;
async void t() {
    u32 i = 1;
    for (u32 k = 0; k < 2; k += 1) {
        arr[i] = 7;
        if (k == 1) { hit = 1; }
        await ((i = 4) > 0);
    }
}
u32 main() {
    _zer_async_t task;
    _zer_async_t_init(&task);
    for (u32 r = 0; r < 4; r += 1) { _zer_async_t_poll(&task); }
    if (hit == 1) { return 42; }
    return 0;
}
