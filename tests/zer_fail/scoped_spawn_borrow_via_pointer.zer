// EXPECTED: compile error
// expect-error: cannot write to 'v' while it is borrowed by a scoped spawn
// BUG-969 (2026-09-07): the scoped-spawn borrow was established only for a
// literal `&x` argument. Handing the thread a pointer LOCAL that was formed
// from `&v` lent the same storage with no borrow, so the parent's write to
// `v` before join() compiled (TSan-confirmed race).
void w(*u32 p) { *p = 5; }
u32 main() {
    u32 v = 0;
    *u32 q = &v;
    ThreadHandle th = spawn w(q);
    v = 3;
    th.join();
    return v;
}
