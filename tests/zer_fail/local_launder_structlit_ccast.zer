// expect-error: cannot store struct/union literal carrying a pointer
// BUG-920: the same struct-literal peel gap for a plain STACK LOCAL, not just an
// arena pointer — the un-peeled Case B never saw the laundered alias.
struct L { u32 f; }
struct B { *u32 p; }
B gb;
void stash() { L loc; loc.f = 1; gb = { .p = (*u32)(&loc.f) }; }
u32 main() { stash(); return 0; }
