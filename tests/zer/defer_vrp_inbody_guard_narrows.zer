// BUG-913 positive: a guard INSIDE the defer body is evaluated at fire time, so
// it still narrows the index and the deferred access is safe (and the range
// derived in the body must not leak to the code after the defer — B4).
// The pre-defer narrowing of `i` ([0,0]) is discarded for the body, but the
// in-body `if (i < 4)` recovers it.
u32 g;
u32 main() {
    u32[4] arr;
    arr[2] = 9;
    u32 i = 0;
    defer {
        if (i < 4) { g = arr[i]; }
    }
    i = 2;
    if (g != 0) { return 1; }
    return 0;
}
