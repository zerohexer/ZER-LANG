// expect-error: use after free
// BUG-848: the `return b[0..1]` arm sits in an is_early_exit block. That tag is
// about LEAK COVERAGE ("not the canonical exit"), not about the returned value,
// but the return-summary loops skipped such blocks — so the summary claimed
// "views param 0" and the call site aliased the result to `a`. Freeing `b` was
// then invisible (and freeing `a` would have been a false positive).
[*]u8 pick([*]u8 a, [*]u8 b, bool f) { if (f) { return b[0..1]; } return a[0..1]; }
u32 main() {
    [*]u8 s = alloc(u8, 4) orelse { return 1; };
    [*]u8 t = alloc(u8, 4) orelse { return 2; };
    [*]u8 h = pick(s, t, true);
    free(t);
    u32 r = h[0];
    free(s);
    return r;
}
