// expect-trap
// expect-trap-msg: wrong-pool handle
struct T { u32 v; }
Pool(T, 4) pa;
Pool(T, 4) pb;
Handle(T)[2] gh;
void stash(Handle(T) x) { gh[0] = x; }
u32 main() {
    Handle(T) h = pa.alloc() orelse return;
    defer pa.free(h);
    pa.get(h).v = 5;
    Handle(T) g = pb.alloc() orelse return;
    defer pb.free(g);
    pb.get(g).v = 9;
    stash(h);
    u32 r = pb.get(gh[0]).v;
    return r;
}
