// The path key, positive (access_alias.v: apart_paths_never_alias). Two workers
// share ONE struct global and never touch a common byte:
//   - each owns one element of `per_worker` (a constant index);
//   - each owns one field of a nested struct;
//   - both bump one ATOMIC field, beside the other's plain fields;
//   - the spawner reads a field nobody writes while they run.
// Before the key every one of these was "both access non-shared global 'st'".
// ThreadSanitizer-clean; the result is exact.
struct Pair { u32 left; u32 right; }
struct State {
    u32 total;              // atomic, both workers
    u32[2] per_worker;      // element 0: worker_a, element 1: worker_b
    Pair last;              // .left: worker_a, .right: worker_b
    u32 limit;              // written before the spawns, read by everyone
}
State st;

void worker_a() {
    u32 n = st.limit;
    for (u32 i = 0; i < n; i += 1) {
        @atomic_add(&st.total, 1);
        st.per_worker[0] += 2;
        st.last.left = i;
    }
}
void worker_b() {
    u32 n = st.limit;
    for (u32 i = 0; i < n; i += 1) {
        @atomic_add(&st.total, 1);
        st.per_worker[1] += 3;
        st.last.right = i + 100;
    }
}

u32 main() {
    st.limit = 5000;
    ThreadHandle a = spawn worker_a();
    ThreadHandle b = spawn worker_b();
    u32 seen_limit = st.limit;          // a field no thread writes
    a.join();
    b.join();
    if (seen_limit != 5000) { return 1; }
    if (@atomic_load(&st.total) != 10000) { return 2; }
    if (st.per_worker[0] != 10000) { return 3; }
    if (st.per_worker[1] != 15000) { return 4; }
    if (st.last.left != 4999) { return 5; }
    if (st.last.right != 5099) { return 6; }
    return 0;
}
