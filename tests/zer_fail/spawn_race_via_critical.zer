// expect-error: accesses non-shared global
// BUG-804: @critical was a LEAF in the spawn data-race scan, so wrapping a
// non-shared global access in it hid the race. @critical disables INTERRUPTS on
// the current core and gives no mutual exclusion between threads at all, so this
// reads as deliberate synchronisation while being a genuine race. The identical
// access without the wrapper was rejected.
u32 g_counter = 0;
void worker() {
    @critical {
        g_counter += 1;
    }
}
u32 main() { spawn worker(); return 0; }
