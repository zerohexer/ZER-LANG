// Positive: fresh shared-struct declaration + construction + per-field
// (auto-locked) reads are fine; only copying an existing instance by value is banned.
shared struct C { u32 v; u32 w; }
C g;
u32 test() {
    C x;
    C y = { .v = 3 };
    x.v = g.v;
    x.w = g.w;
    if (x.v + x.w + y.v != 3) { return 1; }
    return 0;
}
u32 main() { return test(); }
