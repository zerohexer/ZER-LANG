// expect-error: no release/acquire flag ordering them
// BUG-1664: a wait loop with a `break` can be left without the flag having been seen set.
u32 ready;
u32 data;
u32 sink;
void writer() { data = 1; @atomic_store(&ready, 1); }
void reader() { while (@atomic_load(&ready) == 0) { break; } sink = data; }
u32 main() {
    ThreadHandle a = spawn writer();
    ThreadHandle b = spawn reader();
    a.join(); b.join();
    return 0;
}
