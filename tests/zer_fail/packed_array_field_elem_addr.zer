// EXPECTED: compile error
// expect-error: points into a PACKED struct field
// BUG-971 (2026-09-07): `&p.w[1]` — the address of an ELEMENT of a packed
// array field. addr_of_is_packed_field required the operand to be the field
// itself, so every element address slipped.
packed struct P { u8 a; u32[2] w; }
u32 main() {
    P p;
    *u32 q = &p.w[1];
    *q = 1;
    return 0;
}
