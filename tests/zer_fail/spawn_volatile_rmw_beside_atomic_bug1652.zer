// expect-error: performs a non-atomic read-modify-write on volatile global
// BUG-1652: an UNRELATED @atomic in the spawn target downgraded every race
// finding of the scan to a warning — including `g += 1` on a volatile flag,
// which no atomic elsewhere makes exact. Two threads, lost updates, exit 0.
volatile u32 g;
u32 hits;
void w() {
    for (u32 i = 0; i < 1000; i += 1) {
        @atomic_add(&hits, 1);
        g += 1;
    }
}
u32 main() {
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w();
    a.join();
    b.join();
    return 0;
}
