// EXPECTED: compile error
// expect-error: use after free
// BUG-1131: `return w.h;` — a struct value read out of a FIELD. Pre-fix: compiled.
struct T { u32 v; }
struct H { *T p; }
struct W { H h; u32 n; }
H mk(*T a) { W w; w.h = { .p = a }; return w.h; }
u32 main() {
    *T a = alloc(T) orelse return;
    a.v = 5;
    H h = mk(a);
    free(a);
    return h.p.v;
}
