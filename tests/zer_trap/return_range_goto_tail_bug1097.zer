// expect-trap
// expect-trap-msg: array index out of bounds
// BUG-1097: f's return-range summary was read at the END of its body, after the
// `tail:` guard `if (x >= 2) { return 1; }` had narrowed x to [0,1] — and credited
// to the EARLIER `return x`, reached without the guard. Summary [0,1]; f(2)
// returns 2; `two[f(2)]` was emitted with no check (ASan pre-fix). The range is
// now recorded at each return, where x is [0,50].
u32 f(u32 x) {
    if (x > 50) { goto tail; }
    return x;
tail:
    if (x >= 2) { return 1; }
    return 0;
}
u32 main() {
    u32[2] two;
    two[f(2)] = 7;
    return 42;
}
