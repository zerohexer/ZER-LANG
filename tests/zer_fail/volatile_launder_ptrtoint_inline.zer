// expect-error: non-volatile pointer from volatile
// EXPECTED: compile error
//
// The same laundering with no intermediate variable. The rule has to answer at
// BOTH shapes — inline, and through a local that carries the fact on its Symbol
// — or the fix would only close whichever one the reproducer happened to use.
mmio 0x40020000..0x40020FFF;

u32 main() {
    volatile *u32 reg = @inttoptr(volatile *u32, 0x40020010);
    *u32 plain = @inttoptr(*u32, @ptrtoint(reg));
    *plain = 1;
    return 0;
}
