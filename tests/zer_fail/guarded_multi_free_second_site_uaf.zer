// expect-error: use after free
// BUG-914: Level B guarded refinement recorded only ONE free site per handle.
// The second free (under !c && d) was accepted as disjoint from the first
// (under c) — correct — but left free_block pointing at the FIRST free, so the
// use under !c && d was judged disjoint from "the" free and ACCEPTED, though it
// sits on the exact path of the second free (verified UAF on main).
// Two free sites now saturate free_block to MULTI = "cannot prove disjoint".
struct T { u32 v; }
volatile u32 v1 = 0;
volatile u32 v2 = 1;
?*T gp = null;
u32 g;
u32 main() {
    *T h = alloc(T) orelse { return 1; };
    gp = h;
    bool c = v1 == 1;
    bool d = v2 == 1;
    if (c) { free(h); }
    if (!c) { if (d) { free(h); } }
    if (!c) { if (d) { g = h.v; } }
    return 0;
}
