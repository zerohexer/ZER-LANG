// expect-error: use after free
// BUG-986: a NESTED designated initializer carrying an allocation —
// `H h = { .inner = { .p = alloc(T) } }` — registered nothing on `h`: the inner
// init registered (temp, ".p"), and the outer init only looked for a BARE handle
// on the field value (a struct temp has none), so `.inner.p` was untracked and a
// free-then-re-unwrap read freed memory.
struct T { u32 v; }
struct In { ?*T p; }
struct H { In inner; }
u32 main() {
    H h = { .inner = { .p = alloc(T) } };
    *T q = h.inner.p orelse return;
    free(q);
    *T r = h.inner.p orelse return;
    return r.v;
}
