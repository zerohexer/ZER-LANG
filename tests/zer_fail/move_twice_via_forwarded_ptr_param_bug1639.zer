// EXPECTED: compile error
// expect-error: was already moved out of
// BUG-1639: a function forwards its pointer PARAMETER twice to a callee that moves
// a move-struct field out of what it points at. Only `&w` / `w.t` / `w` named a
// root to the call-site transfer; a pointer param named none, so the second
// consume was accepted (use-after-move, no memory fault).
move struct Tok { u32 k; }
struct W { Tok t; }
void consume(Tok t) { }
void eat(*W w) { consume(w.t); }
void twice(*W w) { eat(w); eat(w); }
u32 main() {
    W w;
    twice(&w);
    return 0;
}
