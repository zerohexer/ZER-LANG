// expect-error: deadlock: single statement accesses both 'A'
// BUG-1518: the for-loop STEP was never collected by the per-statement deadlock
// check — two threads running these steps in opposite order hung (exit 124).
shared struct A { u32 x; }
shared struct B { u32 y; }
A a;
B b;
u32 main() {
    for (u32 i = 0; i < 20; i += 1 + a.x + b.y) { }
    return 0;
}
