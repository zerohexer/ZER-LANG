// GAP (re-verified 2026-08-03, still open): cross-block scoped-borrow race.
//
// Satisfies the join discipline on EVERY path, so the ThreadHandle leak rule
// does not fire, and the branch condition references an UNRELATED variable so
// the read check does not fire either. Both of those masked earlier attempts at
// this reproducer — on this checker a negative test proves nothing until you
// read the ACTUAL diagnostic (which is why tests/test_zer.sh now supports
// `// expect-error:`).
//
// Path B writes `work.x` while the worker thread is still running. Visible in
// the emitted C: the store precedes pthread_join.
//
// Compile-clean today = the gap. Fix = a borrow-set MERGE in zercheck_ir.c
// (per-block set, union at joins), same shape as the threads[] merge.
struct W { u32 x; }
void worker(*W w) { for (u32 i = 0; i < 200000; i += 1) { w.x += 1; } }
u32 run(u32 flag_in) {
    W work; work.x = 0;
    ThreadHandle th = spawn worker(&work);
    if (flag_in == 99) { th.join(); return 0; }   // path A: joined, exits
    work.x = 2;                                    // path B: thread STILL RUNNING
    th.join();
    return work.x;
}
u32 main() { return run(1); }
