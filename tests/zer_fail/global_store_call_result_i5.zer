// expect-error: dangling global
// BUG-1575: a CALL result stored into a global registered no alias / view of the allocation.
struct T { u32 v; }
?*T g;
*T pick(*T x, *T y, bool c) { if (c) { return x; } return y; }
u32 rd() { if (g) |q| { return q.v; } return 0; }
u32 main() {
    *T a = alloc(T) orelse return;
    a.v = 7;
    *T z = pick(a, a, false);
    g = z;
    free(a);
    *T b = alloc(T) orelse return;
    b.v = 99;
    u32 r = rd();
    free(b);
    return r;
}
