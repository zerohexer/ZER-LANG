// expect-error: no common lock
// BUG-1663: two threads spin on two DIFFERENT fields of one struct; both resolved to the same global and both "held" it. A lock word is a whole global scalar.
struct L { u32 a; u32 b; }
L s;
u32 g;
void w() {
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&s.a, 0, 1)) { }
        g += 1;
        @atomic_store(&s.a, 0);
    }
}
u32 main() {
    ThreadHandle a = spawn w();
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&s.b, 0, 1)) { }
        g += 1;
        @atomic_store(&s.b, 0);
    }
    a.join();
    if (g != 400000) { return 1; }
    return 0;
}
