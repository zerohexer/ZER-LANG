// Rust: Condvar — loop with predicate re-check (spurious wakeup safe)
// ZER: @cond_wait loop pattern — condition rechecked automatically
// Equivalent to: Rust Condvar::wait_while with while loop

shared struct Queue {
    u32[8] items;
    u32 head;
    u32 tail;
    u32 count;
}

Queue gq;

// NOTE (2026-08-25): this used to claim a slot with
//
//     q.items[q.tail] = val;
//     q.tail = (q.tail + 1) % 8;
//
// which is a race IN THE TEST, and it made this file fail roughly 1 run in 8.
// ZER's auto-locking is PER-STATEMENT, so those are two separate lock scopes:
// two threads can both read `q.tail == 0`, both write `items[0]`, and both then
// advance the tail — one value lost, `sum != 60`. The function body is not
// atomic just because every statement in it is.
//
// The test's SUBJECT is @cond_wait re-checking its predicate, not slot
// allocation, so each caller is given its own index and the contention is gone.
// `q.count += 1` stays as it is: a compound assignment is ONE statement, hence
// one lock scope, hence genuinely atomic.
void enqueue(*Queue q, u32 idx, u32 val) {
    q.items[idx] = val;
    q.count += 1;
    @cond_signal(q);
}

u32 main() {
    gq.head = 0;
    gq.tail = 0;
    gq.count = 0;

    ThreadHandle t1 = spawn enqueue(&gq, 0, 10);
    ThreadHandle t2 = spawn enqueue(&gq, 1, 20);
    ThreadHandle t3 = spawn enqueue(&gq, 2, 30);

    // Wait until three items are available
    @cond_wait(gq, gq.count >= 3);

    t1.join();
    t2.join();
    t3.join();

    u32 sum = 0;
    u32 i = 0;
    while (i < 3) {
        sum += gq.items[i];
        i += 1;
    }

    if (sum != 60) { return 1; }
    return 0;
}
