// EXPECTED: compile error
// expect-error: while it is borrowed by a scoped spawn
// BUG-1247: the deferred join released the borrow at the defer statement; the loop raced the thread.
void w(*u32 p) { for (u32 i = 0; i < 100000; i += 1) { *p += 1; } }
u32 main() {
    u32 v = 0;
    ThreadHandle th = spawn w(&v);
    defer th.join();
    for (u32 i = 0; i < 100000; i += 1) { v += 1; }
    return 0;
}
