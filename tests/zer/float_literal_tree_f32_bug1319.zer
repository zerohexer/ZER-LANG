// BUG-1319: a pure float-literal tree initialises an f32 (local and global).
f64 gh = 1.0 / 2.0;
f32 gf = 3.0 / 4.0;
u32 main() {
    f64 x = 3.0;
    x /= 2.0;
    f32 y = 1.0;
    y = y / -4.0;
    if (gh != 0.5) { return 1; }
    if (gf != 0.75) { return 2; }
    if (x != 1.5) { return 3; }
    if (y != -0.25) { return 4; }
    return 0;
}
