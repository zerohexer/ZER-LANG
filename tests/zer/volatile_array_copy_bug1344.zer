// BUG-1344: a whole-array copy to/from a volatile array is element-wise through
// volatile pointers (it was a plain memmove that cast the qualifier away).
volatile u32[4] gv;
struct S { u32 a; u32[3] w; }
volatile S gs;
u32 main() {
    u32[4] c;
    c[0] = 1; c[1] = 2; c[2] = 3; c[3] = 4;
    gv = c;
    u32[4] d;
    d = gv;
    u32[3] w;
    w[2] = 9;
    gs.w = w;
    u32[3] w2 = gs.w;
    if (d[0] != 1 || d[3] != 4 || w2[2] != 9) { return 1; }
    return 0;
}
