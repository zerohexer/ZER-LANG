// BUG-914 boundary: one shared root PER ARGUMENT is locked separately and stays legal.
shared struct A { u32 x; }
shared struct B { u32 y; }
A a; B b;
void w(u32 v, u32 z) { a.x = v + z; }
u32 main() { a.x = 1; b.y = 2; ThreadHandle th = spawn w(a.x, b.y); th.join(); if (a.x != 3) { return 1; } return 0; }
