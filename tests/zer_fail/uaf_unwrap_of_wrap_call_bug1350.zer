// EXPECTED: compile error
// expect-error: use after free
// BUG-1350: unwrap(wrap(a)) is a (struct-valued inner call).
struct T { u32 v; }
struct W { *T p; }
W wrap(*T p) { W w = { .p = p }; return w; }
*T unwrap(W w) { return w.p; }
u32 main() {
    *T a = alloc(T) orelse return;
    *T c = unwrap(wrap(a));
    free(a);
    *T b = alloc(T) orelse return;
    b.v = 99;
    u32 r = c.v;
    free(b);
    return r;
}
