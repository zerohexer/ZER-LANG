// BUG-924 (2026-09-04) positive boundary: every borrow a non-`&` argument
// establishes is released by the join, and a pointer to a GLOBAL lends no
// local at all — the parent may keep working on unrelated locals meanwhile.
u32 g;
struct H { *u32 p; }
void w(*u32 p) { *p = 5; }
void wh(H h) { *h.p = 5; }
void ws([*]u8 s) { s[0] = 9; }
u32 main() {
    u32 v = 0;
    *u32 q = &v;
    ThreadHandle t1 = spawn w(q);
    t1.join();
    v = v + 1;                   // OK — released at the join
    *q = *q + 1;
    if (v != 7) { return 1; }

    u32 x = 0;
    H h;
    h.p = &x;
    ThreadHandle t2 = spawn wh(h);
    t2.join();
    *h.p = x + 1;                // OK — released
    if (x != 6) { return 2; }

    u8[4] a;
    [*]u8 s = a;
    ThreadHandle t3 = spawn ws(s);
    t3.join();
    if (a[0] != 9) { return 3; }

    *u32 gq = &g;
    u32 other = 1;
    ThreadHandle t4 = spawn w(gq);
    other += 1;                  // OK — a global was lent, not a local
    t4.join();
    if (g != 5 || other != 2) { return 4; }
    return 0;
}
