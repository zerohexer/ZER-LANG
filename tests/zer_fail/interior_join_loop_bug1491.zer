    [*]u8 b = alloc(u8, 8) orelse { return 1; };
    [*]u8 s = b;
    for (u32 i = 0; i < 2; i += 1) {
        if (i == 1) { free(s); return 0; }
        s = b[2..6];
    }
    free(b);
