// expect-error: use after free
// BUG-1311: a getter whose every return reads global g is a read of g — c aliases a.
i32 printf(const *u8 fmt, ...);
struct T { u32 v; }
?*T g;
?*T getg() { return g; }
u32 main() {
    *T a = alloc(T) orelse return;
    a.v = 11;
    g = a;
    *T c = getg() orelse return;
    g = null;
    free(c);
    *T b = alloc(T) orelse return;
    b.v = 22;
    printf("%u\n", a.v);
    free(b);
    return 0;
}
