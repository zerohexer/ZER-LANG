// BUG-1648: a spawn..join written after the last jump keeps the plain textual rule.
void w(*u32 p) { *p = 5; }
u32 main() {
    u32 x = 0;
    u32 n = 0;
again:
    n += 1;
    if (n < 3) { goto again; }
    ThreadHandle th = spawn w(&x);
    th.join();
    if (x != 5) { return 1; }
    return 0;
}
