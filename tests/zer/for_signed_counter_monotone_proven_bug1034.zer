// BUG-1034 precision pin: a signed counter whose only writer is a NON-NEGATIVE
// constant increment keeps its proven range — both the `+=` and the `i = i + 1`
// spelling, and a body that only READS the counter. Runs the loops for real.
u32 main() {
    u32[4] arr;
    u32 sum = 0;
    for (i32 i = 0; i < 4; i += 1) { arr[i] = (u32)i; }
    for (i32 j = 0; j < 4; j = j + 1) { sum += arr[j]; }
    for (i32 m = 1; m <= 3; m = 1 + m) { sum += arr[m]; }
    if (sum != 6 + 6) { return 1; }
    return 0;
}
