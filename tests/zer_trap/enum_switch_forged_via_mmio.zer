// expect-trap
// BUG-915: the DOCUMENTED bare-metal pattern — read an enum out of a hardware
// register. `@inttoptr(*State, addr)` then `*sp` produced a value that is not a
// declared variant, and the exhaustive-enum switch ELIDES its last arm's
// comparison, so the forged value was silently classified as `.running`.
// Compile-time and runtime BOTH missed it; on bare metal nothing faults.
mmio 0x0..0xFFFFFFFFFFFFFFFF;

enum State { idle, running }

u32 main() {
    volatile u32 v = 99;
    u32 raw = v;
    usize a = @ptrtoint(&raw);
    volatile *State sp = @inttoptr(*State, a);
    State s = *sp;
    switch (s) {
        .idle => { return 0; }
        .running => { return 1; }
    }
}
