// BUG-919: the guard's bare IR_RETURN in a struct-returning function emits the
// zero compound literal (emit_return_null used to emit `return 0;` for structs).
struct P { u32 x; u32 y; }
volatile u32 vi = 100;
P f() {
    u32[4] arr;
    u32 i = vi;
    arr[i] = 1;
    P p = { .x = 1, .y = 2 };
    return p;
}
u32 main() {
    P p = f();
    if (p.x != 0) { return 1; }
    return 0;
}
