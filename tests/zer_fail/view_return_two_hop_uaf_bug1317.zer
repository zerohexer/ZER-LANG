// expect-error: use after free
// BUG-1317: the 2-hop view aliases the argument — a use after freeing it is a UAF.
[*]u8 tl([*]u8 s) { return s[1..s.len]; }
[*]u8 tr([*]u8 s) { return s[0..s.len - 1]; }
[*]u8 tb([*]u8 s) { return tr(tl(s)); }
u32 main() {
    [*]u8 h = alloc(u8, 8) orelse return;
    [*]u8 t = tb(h);
    free(h);
    return (u32)t[0];
}
