// BUG-1635 boundary: a consume loop and a free-and-reset loop written through a
// slice view of a local array, a literal read through a view that does not
// start at element 0, and a read-only view. Before the fix the first three were
// refused as LEAKS (the frees through the view reached no slot of `arr`).
struct T { u32 v; }
u32 main() {
    ?*T[4] arr;
    for (u32 i = 0; i < 4; i += 1) { arr[i] = alloc(T); }
    [*]?*T s = arr[0..];
    u32 n = 0;
    for (u32 i = 0; i < s.len; i += 1) {
        if (s[i]) |q| { n += q.v; free(q); }
    }

    ?*T[4] brr;
    for (u32 i = 0; i < 4; i += 1) { brr[i] = alloc(T); }
    [*]?*T t = brr;
    for (u32 i = 0; i < t.len; i += 1) {
        if (t[i]) |q| { free(q); }
        t[i] = null;
    }
    for (u32 j = 0; j < 4; j += 1) {
        if (brr[j]) |r| { n += r.v + 1; }
    }

    ?*T[4] crr;
    crr[2] = alloc(T);
    [*]?*T u = crr[1..3];
    if (u[1]) |q| { free(q); }
    u[1] = null;

    *T a = alloc(T) orelse return;
    a.v = 3;
    ?*T[2] drr;
    drr[0] = a;
    [*]?*T w = drr[0..];
    if (w[0]) |q| { n += q.v - 3; }
    drr[0] = null;
    free(a);
    return n;
}
