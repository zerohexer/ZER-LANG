// expect-error: global 'buf' is accessed from both interrupt and main code
// BUG-1174: a global SLICE view of a global array did not reach the array in
// the ISR sharing rule (only pointer views did).
u32[4] buf;
[*]u32 gs = buf[0..];
interrupt TIMER { u32 v = buf[0]; if (v == 9) { buf[1] = 1; } }
u32 main() { gs[0] = 9; return 0; }
