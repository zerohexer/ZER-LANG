// EXPECTED: compile error
// expect-error: never reassigned
// BUG-1056, the back-edge form: the reassignment comes AFTER the index in the
// source but reaches it on the second iteration — why a per-statement update
// of the bound could never be enough.
mmio 0x40000000..0x400000FF;
u32 main() {
    volatile *u32 r = @inttoptr(*u32, 0x40000000);
    u32 acc = 0;
    for (u32 k = 0; k < 2; k += 1) {
        acc += r[10];
        r = @inttoptr(*u32, 0x400000F0);
    }
    return acc;
}
