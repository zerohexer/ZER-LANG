// expect-error: both access non-shared global 'rg'
// BUG-1667: `rg.push(x)` / `rg.pop()` rewrite the Ring's head, tail and count (`count--` is not atomic).
// Recorded as reads of `rg`, two threads pushing and popping one Ring were accepted.
u32 flagx;
Ring(u32, 8) rg;
u32 sink;
void w() {
    @atomic_store(&flagx, 1);
    for (u32 r = 0; r < 20000; r += 1) { rg.push(r); u32 x = rg.pop() orelse 0; }
}
i32 main() {
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w();
    a.join(); b.join();
    return 0;
}
