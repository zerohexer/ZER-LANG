// expect-trap
// expect-trap-msg: wrong-pool handle
struct T { u32 v; }
Ring(Handle(T), 4) rq;
Pool(T, 4) pa;
Pool(T, 4) pb;
u32 main() {
    Handle(T) h = pa.alloc() orelse return;
    defer pa.free(h);
    Handle(T) g = pb.alloc() orelse return;
    defer pb.free(g);
    pa.get(h).v = 5;
    pb.get(g).v = 9;
    rq.push(h);
    u32 r = 0;
    if (rq.pop()) |k| { r = pb.get(k).v; }
    return r;
}
