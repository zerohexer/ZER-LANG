// GAP (2026-11-14, docs/limitations.md section B): the flag hand-off trusts ANY loop that
// reads the flag as a wait for the publication. This one spins while the flag is NON-zero:
// it exits at once (the flag starts at 0), and `sink = data` runs beside the writer's
// `data = 42` (ThreadSanitizer: data race when the writer is slow to start).
// Compile-clean IS the gap.
u32 ready;
u32 data;
u32 sink;
void writer() { data = 42; @atomic_store(&ready, 1); }
void reader() {
    while (@atomic_load(&ready) != 0) { }
    sink = data;
}
u32 main() {
    ThreadHandle a = spawn writer();
    ThreadHandle b = spawn reader();
    a.join(); b.join();
    return 0;
}
