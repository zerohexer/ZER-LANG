// BUG-1322: regression (see BUGS-FIXED.md).
// `@try_enum(E, -1)` with the literal -1 returns NULL although a = -1 is a declared variant:
// the literal is typed u32 (emitted `-1U`) and the membership test drops the negative variant.
// (With an i32 VARIABLE holding -1 it works.) Expected exit 0; actual exit 1.
enum E { a = -1, b = 0, c = 5 }
u32 main() {
    ?E t = @try_enum(E, -1);
    if (t) |x| { if (x != E.a) { return 2; } } else { return 1; }
    return 0;
}
