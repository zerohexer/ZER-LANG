// EXPECTED: compile error
// expect-error: use after free: 'a' is freed
// BUG-1626: a projection through a global pointer that can only designate one
// global (`*H gp = &g_h;`) names that global's slot, so the free through
// `gp.p` reaches what the caller stored in `g_h.p`.
struct T { u32 v; }
struct H { ?*T p; }
H g_h;
*H gp = &g_h;
u32 main() {
    *T a = alloc(T) orelse return;
    g_h.p = a;
    if (gp.p) |q| { free(q); }
    gp.p = null;
    *T b = alloc(T) orelse return;
    b.v = 5;
    a.v = 99;
    u32 r = b.v;
    free(b);
    return r;
}
