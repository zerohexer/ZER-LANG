// Cross-module *opaque wrapper — correct lifecycle
import resource;

u32 main() {
    ?*opaque mr = resource.resource_create(42);
    *opaque r = mr orelse { return 1; };
    u32 v = resource.resource_read(r);
    resource.resource_destroy(r);        // BUG-1071: before the early return
    if (v != 42) { return 2; }
    return 0;
}
