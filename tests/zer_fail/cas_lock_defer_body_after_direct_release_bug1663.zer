// expect-error: non-atomic read-modify-write
// BUG-1663: a `defer` body registered inside the region runs at the block's exit, AFTER the direct release that ends the region: the volatile update is not under the lock.
u32 lk;
volatile u32 counter;
void w() {
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        defer { counter += 1; }
        @atomic_store(&lk, 0);
    }
}
i32 main() {
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w();
    a.join(); b.join();
    return 0;
}
