// expect-trap
// expect-trap-at: 14
// BUG-1503: the hoisted guard tested i BEFORE f() re-polled this task and set
// i = 4 in the other arm; the access carries its own inline check now.
u32[4] arr;
u32[64] pad;
u32 get(u32 a) { return a; }
u32 depth;
u32 hit;
u32 f();
async void t() {
    u32 i = get(1);
    yield;
    if (depth == 0) { depth = 1; u32 v = f() + arr[i]; hit = 1; }
    else { i = 4; }
}
_zer_async_t T;
u32 f() { _zer_async_t_poll(&T); return 0; }
u32 main() {
    _zer_async_t_init(&T);
    _zer_async_t_poll(&T);
    _zer_async_t_poll(&T);
    if (hit == 1) { return 42; }
    return 0;
}
