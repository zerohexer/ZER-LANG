// BUG-1639 boundary: the new rule fires only for a callee whose summary says it
// MOVES OUT. Read-only helpers take a pointer / slice / pointer param any number of
// times, a move helper is called once per object, and two objects are independent.
move struct Tok { u32 k; }
struct W { Tok t; u32 n; }
void consume(Tok t) { }
void eat(*W w) { consume(w.t); }
u32 peek(*W w) { return w.n; }
u32 count([*]Tok s) { return @truncate(u32, s.len); }
u32 two(*W w) { return peek(w) + peek(w); }
void peek_then_eat(*W w) { u32 a = peek(w); eat(w); w.n = a; }
u32 pick(*W w, u32 c) {
    if (c > 1) { eat(w); } else { return peek(w); }
    return 0;
}
u32 main() {
    W w;
    *W p = &w;
    u32 a = peek(p);
    u32 b = peek(p);
    a += two(&w);
    Tok[2] ts;
    a += count(ts) + count(ts);
    W x;
    W y;
    *W px = &x;
    *W py = &y;
    eat(px);
    eat(py);
    W z;
    peek_then_eat(&z);
    W q;
    a += pick(&q, 1);
    if (a + b > 100) { return 1; }
    return 0;
}
