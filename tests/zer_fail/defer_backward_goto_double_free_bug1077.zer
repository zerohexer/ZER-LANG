// EXPECTED: compile error
// expect-error: fires once per pass
// BUG-1077 (H8): a block with a `defer` re-entered by a backward `goto` fires the
// defer once per pass — a double free, accepted pre-fix.
struct T { u32 v; }
u32 main() {
    u32 i = 0;
    *T a = alloc(T) orelse return;
again:
    {
        defer free(a);
        i += 1;
    }
    if (i < 2) { goto again; }
    return 0;
}
