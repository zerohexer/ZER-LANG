// The over-rejection boundary for the RMW-LAUNDER rule (2026-08-11). Every
// shape here is safe and MUST keep compiling — the rule fires on a
// read-modify-write reached through a pointer, not on pointer use in general.
//
//  1. a plain STORE through a pointer   — the single-word volatile flag idiom
//  2. an @atomic_* RMW                  — the remedy the diagnostic recommends
//  3. an RMW on a LOCAL through a pointer — no global involved
//  4. an RMW on a global with no ISR and no spawn — not a concurrent context
volatile u32 flag;
volatile u32 counted;
u32 atomic_cell;

void set_flag(volatile *u32 p) { *p = 1; }             /* 1 */
void tally(*u32 out)           { *out += 1; }          /* 3 */
void bump(volatile *u32 p)     { *p += 1; }            /* 4 */

void worker() {
    set_flag(&flag);
    @atomic_add(&atomic_cell, 1);                       /* 2 */
}

u32 main() {
    spawn worker();

    u32 acc = 0;
    tally(&acc);                                        /* 3 */

    bump(&counted);                                     /* 4 — single-threaded */

    u32 seen = flag;
    u32 cell = @atomic_load(&atomic_cell);
    if (acc == 1 && counted == 1 && (seen | cell) < 2) { return 0; }
    return 0;
}
