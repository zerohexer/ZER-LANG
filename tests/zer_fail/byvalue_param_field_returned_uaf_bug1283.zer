// EXPECTED: compile error
// expect-error: may be a view of an allocation that is freed
struct T { u32 v; }
struct G { *T p; }
struct H { *T p; }
H mk(G g) { H h; h.p = g.p; return h; }
u32 main() {
    *T a = alloc(T) orelse { return 1; };
    a.v = 11;
    G g;
    g.p = a;
    H h = mk(g);
    free(a);
    return h.p.v;
