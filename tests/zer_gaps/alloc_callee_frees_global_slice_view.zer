// GAP (2026-11-13 audit, docs/limitations.md): a callee frees through a slice view of a global array (exit 99)
struct T { u32 v; }
struct H { ?*T p; }
H[4] tbl;
void drop() { [*]H s = tbl[0..]; for (u32 i = 0; i < 4; i += 1) { if (s[i].p) |q| { free(q); } s[i].p = null; } }
u32 main() {
    *T a = alloc(T) orelse return;
    tbl[1].p = a;
    drop();
    *T b = alloc(T) orelse return;
    b.v = 5;
    a.v = 99;
    u32 r = b.v;
    free(b);
    return r;
}
