// EXPECTED: compile error
// expect-error: double free
// BUG-1360: killp(id(id(a))) frees a.
struct T { u32 v; }
*T id(*T p) { return p; }
void killp(*T p) { free(p); }
u32 main() {
    *T a = alloc(T) orelse return;
    killp(id(id(a)));
    *T b = alloc(T) orelse { free(a); return 0; };
    free(a);
    *T c = alloc(T) orelse { free(b); return 0; };
    b.v = 1;
    c.v = 2;
    u32 r = b.v;
    free(b);
    free(c);
    return r;
}
