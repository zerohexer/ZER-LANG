// expect-error: use after free
// BUG-1395: a GLOBAL carrier (gss.s = &gs) — gss.s.p and gs.p were strangers.
struct T { u32 v; }
struct S { ?*T p; }
struct SS { *S s; }
SS gss;
S gs;
u32 main() {
    *T a = alloc(T) orelse return;
    gss.s = &gs;
    gs.p = a;
    free(a);
    u32 r = 0;
    if (alloc(T)) |b| {
        b.v = 99;
        if (gss.s.p) |q| { r = q.v; }
        free(b);
    }
    gs.p = null;
    return r;
}
