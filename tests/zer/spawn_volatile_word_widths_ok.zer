// The single-word volatile-flag idiom must survive the 2026-08-03 width limit,
// at every width up to the target word. Companion to
// tests/zer_fail/spawn_volatile_wide_store_tear.zer, which pins the other side.
volatile u8  f8;
volatile u16 f16;
volatile u32 f32v;

void w8(u32 a)  { f8  = 1; }
void w16(u32 a) { f16 = 1; }
void w32(u32 a) { f32v = 1; }

u32 main() {
    f8 = 0; f16 = 0; f32v = 0;
    spawn w8(1);
    spawn w16(1);
    spawn w32(1);
    return 0;
}
