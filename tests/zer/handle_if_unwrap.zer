// if-unwrap |t| + Handle auto-deref — immutable capture allows data mutation

struct Task { u32 id; u32 priority; }
Slab(Task) heap;

u32 main() {
    ?Handle(Task) maybe = heap.alloc();
    if (maybe) |t| {
        t.id = 42;
        t.priority = 3;
        u32 id = t.id;
        u32 pri = t.priority;
        heap.free(t);
        if (id != 42) { return 1; }
        if (pri != 3) { return 2; }
    }
    return 0;
}
