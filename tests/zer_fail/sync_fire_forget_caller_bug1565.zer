// BUG-1565 (C1): a fire-and-forget thread outlives the helper that started it;
// main reads g after the helper returns, beside the thread.
// expect-error: no common lock and no release/acquire flag
u32 g;
u32 flag;
void w() { g = 1; @atomic_store(&flag, 1); }
void start() { spawn w(); }
u32 main() { start(); u32 x = g; return x; }
