// expect-error: wrong *opaque type
// BUG-806 sibling — switch subject.
struct Sensor { u32 id; }
struct Motor { u32 speed; }
u32 process(*opaque ctx) {
    *Sensor s = @ptrcast(*Sensor, ctx);
    return s.id;
}
Motor g_m;
void f() {
    switch (process(@ptrcast(*opaque, &g_m))) { default => { return; } }
}
u32 main() { f(); return 0; }
