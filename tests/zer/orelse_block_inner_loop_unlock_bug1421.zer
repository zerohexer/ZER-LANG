// BUG-1421: a break / continue releases the statement's lock group only when it
// LEAVES that statement. A loop inside an orelse block fallback is inside the
// statement; pre-fix its continue and break each unlocked the statement's
// shared(rw) lock again (one lock, four unlocks), releasing OTHER threads'
// locks: lost updates or a hang.
shared(rw) struct Q { u32 a; u32 n; }
Q q;
?u32 none(u32 x) { return null; }
u32 f() {
    u32 s = 0;
    u32 x = none(q.a) orelse {
        for (u32 k = 0; k < 3; k += 1) { if (k == 1) { continue; } if (k == 2) { break; } s += 1; }
        return s;
    };
    return x;
}
void w() { for (u32 i = 0; i < 100000; i += 1) { q.n += 1; } }
u32 main() {
    u32 bad = 0;
    ThreadHandle th = spawn w();
    for (u32 i = 0; i < 100000; i += 1) {
        if (f() != 1) { bad += 1; }
        q.n += 1;
    }
    th.join();
    if (bad != 0) { return 2; }
    if (q.n != 200000) { return 1; }
    return 0;
}
