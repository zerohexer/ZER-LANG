// expect-error: cannot mutate union
// BUG-1377: the switched union reached THROUGH a pointer (`switch (pw.u)`) — a
// write to the object it points at, by its own name, is the same bytes.
struct T { u32 v; }
struct Big { u32[64] a; }
T t0;
Big b0;
union U { *T p; *Big q; }
struct W { U u; }
u32 main() {
    W w;
    w.u.q = &b0;
    *W pw = &w;
    u32 r = 0;
    switch (pw.u) {
        .q => |*bq| { w.u.p = &t0; r = (*bq).a[2]; }
        .p => |m| { r = 1; }
    }
    return r;
}
