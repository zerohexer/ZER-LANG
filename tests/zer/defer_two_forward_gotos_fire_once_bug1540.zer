// BUG-1540: two forward gotos to two different labels fired the defer twice
// (each label guarded only its own goto; the return re-fired the defer).
u32 c0;
u32 f(u32 k) {
    defer c0 += 1;
    if (k == 1) { goto out; }
out:
    if (k == 2) { goto out2; }
out2:
    return 0;
}
u32 main() { f(1); if (c0 != 1) { return 1; } f(2); if (c0 != 2) { return 2; } f(0); if (c0 != 3) { return 3; } return 0; }
