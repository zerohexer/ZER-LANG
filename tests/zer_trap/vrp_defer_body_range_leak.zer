// VRP leak (2026-07-27): a range narrowed inside a `defer { }` body leaked to
// code BEFORE the defer fires (the defer body runs at scope exit, AFTER arr[idx]).
// Fix: the defer-body check now snapshots/restores VRP (discard). Expected: TRAP.
u32 f(u32 wildv) {
    [*]u32 arr = alloc(u32, 4) orelse { return 0; };
    u32 idx = wildv % 256;              // entry [0,255]; runtime idx = 100
    defer { idx = wildv % 4; }          // narrows idx; runs at scope exit
    arr[idx] = 7;                       // idx=100 here -> TRAP
    u32 r = arr[idx];
    free(arr);
    return r;
}
u32 main() { return f(100); }
