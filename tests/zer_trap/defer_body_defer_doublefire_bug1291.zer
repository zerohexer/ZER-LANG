// expect-trap
// expect-trap-msg: defer cleanup
struct T { u32 v; }
u32 cnt = 0;
u32[4] arr;
void f(u32 k) {
    u32 i = 0;
    *T t = alloc(T) orelse return;
    defer {
        cnt += 1;
        free(t);
        for (u32 j = arr[i]; j < 1; j += 1) { cnt += 10; }
    }
    i = k;
}
u32 main() {
    f(1);
    if (cnt != 11) { return 1; }
    cnt = 0;
    f(100);
    return cnt;
}
