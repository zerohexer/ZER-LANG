// BUG-1306: a CALL statement whose first argument is a dereference, `add(*p);`, was
// taken for a C-style funcptr declaration (`add (*p)…`) and failed to parse
// ("expected variable name"). Declarations need the whole shape `( * name ) (`.
u32 g = 0;
void add(u32 x) { g += x; }
void add2(u32 x, u32 y) { g += x + y; }
u32 main() {
    u32 v = 3;
    *u32 p = &v;
    add(*p);
    add(*p + 1);
    add2(*p, *p);
    u32 (*fp)(u32) = dbl;
    if (fp(2) != 4) { return 2; }
    if (g != 13) { return 1; }
    return 0;
}
u32 dbl(u32 x) { return x * 2; }
