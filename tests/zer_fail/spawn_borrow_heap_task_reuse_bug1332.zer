// EXPECTED: compile error
// expect-error: which is borrowed by a scoped spawn
// BUG-1332: task payload freed + reused in the window
struct T { u32 v; }
u32 go;
async void f(*T p) { yield; p.v += 1; }
void w(*_zer_async_f t) { _zer_async_f_poll(t); while (@atomic_load(&go) == 0) { } _zer_async_f_poll(t); }
u32 main() {
    ?*T mp = alloc(T);
    *T p = mp orelse return;
    _zer_async_f t; _zer_async_f_init(&t, p);
    ThreadHandle th = spawn w(&t);
    free(p);
    ?*T mq = alloc(T);
    *T q = mq orelse { th.join(); return 9; };
    q.v = 100;
    @atomic_store(&go, 1);
    th.join();
    u32 r = q.v;
    free(q);
    return r;
}
