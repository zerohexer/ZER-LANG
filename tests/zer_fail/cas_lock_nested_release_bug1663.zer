// expect-error: is not treated as a lock
// BUG-1663: a release nested in the region: the code after it ran unlocked and was treated as locked.
volatile u32 g;
u32 lk;
volatile u32 one = 1;
void w() {
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        g += 1;
        @atomic_store(&lk, 0);
    }
}
u32 main() {
    ThreadHandle a = spawn w();
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        if (one == 1) { @atomic_store(&lk, 0); }
        g += 1;
        @atomic_store(&lk, 0);
    }
    a.join();
    if (g != 400000) { return 1; }
    return 0;
}
