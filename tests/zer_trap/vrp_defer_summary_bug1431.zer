// expect-trap
// BUG-1431: the return value of pick() is read after the inner block's defer set
// i = 4; the summary used to record [0,3] and arr[pick()] was a bare store.
u32 get(u32 a) { return a; }
u32 pick() { u32 i = get(1); if (i < 4) { { defer i = 4; } return i; } return 0; }
u32 main() { u32[4] arr; arr[pick()] = 7; return arr[0]; }
