// EXPECTED: compile error
// expect-error: cannot satisfy 'keep' parameter
// BUG-1045 (fourth form): the retaining callee takes a by-value struct, and the
// caller builds it as a LITERAL around its own parameter — `inner({ .p = p })`.
// The by-value-local spelling (`W w; w.p = p; inner(w);`) was traced through the
// local's non-keep root; the literal has no local and the trace answered -1, so
// `outer(&d)` stored a pointer to main's frame in a global.
struct D { u32 a; }
struct W { *D p; }
?*D g;
void inner(W w) { g = w.p; }
void outer(*D p) { inner({ .p = p }); }
u32 main() { D d; outer(&d); return 0; }
