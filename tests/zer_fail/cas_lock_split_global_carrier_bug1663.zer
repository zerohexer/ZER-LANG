// expect-error: was read outside this critical section
// BUG-1663: the copy sits in a global between two critical sections.
volatile u32 g;
u32 lk;
u32 mem;
void w() {
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        g += 1;
        @atomic_store(&lk, 0);
    }
}
u32 main() {
    ThreadHandle a = spawn w();
    for (u32 i = 0; i < 200000; i += 1) {
        while (!@atomic_cas(&lk, 0, 1)) { }
        mem = g;
        @atomic_store(&lk, 0);
        while (!@atomic_cas(&lk, 0, 1)) { }
        g = mem + 1;
        @atomic_store(&lk, 0);
    }
    a.join();
    if (g != 400000) { return 1; }
    return 0;
}
