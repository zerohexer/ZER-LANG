// expect-error: @bitcast cannot reinterpret a bare array
// BUG-916, the WORSE half — an ARRAY source compiled clean and was WRONG:
// `__auto_type in = raw;` decays the array to a pointer, so the memcpy copied
// the POINTER VALUE. The u64 came back holding a stack address, with no
// diagnostic at compile time and no fault at run time.
u32 main() {
    u32[2] raw;
    raw[0] = 0x11111111;
    raw[1] = 0x22222222;
    u64 v = @bitcast(u64, raw);
    if (v == 0x2222222211111111) { return 0; }
    return 1;
}
