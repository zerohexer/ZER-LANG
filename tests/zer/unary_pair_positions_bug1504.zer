// BUG-1504: a unary operator applied to a unary expression was emitted as
// raw pasted tokens on the IR passthrough path: `-(-x)` became `--x` (a C
// PRE-DECREMENT: wrong value AND x modified), `-(-2.5)` became `--2.5`.
// Operator pairs x emission positions x types; every cell must hold.
i32 gi = 0;
i32 id32(i32 v) { return v; }
i64 id64(i64 v) { return v; }
f64 idf(f64 v) { return v; }
f32 idf32(f32 v) { return v; }
?i32 none32() { return null; }
?f64 nonef() { return null; }

i32 in_defer(i32 x) {
    defer gi = -(-x);                 // defer body
    return 0;
}

u32 main() {
    i32 x = 5;
    i64 w = 7;
    f64 d = 1.5;
    f32 h = 2.5;
    bool b = true;
    u32 u = 9;
    i32 y = 0;
    i64 z = 0;
    f64 e = 0.0;
    f32 q = 0.0;
    bool c = false;
    u32 v = 0;

    // plain assignment
    y = -(-x);            if (y != 5 || x != 5) { return 1; }
    z = -(-w);            if (z != 7 || w != 7) { return 2; }
    e = -(-d);            if (e != 1.5) { return 3; }
    q = -(-h);            if (q != 2.5) { return 4; }
    e = -(-2.5);          if (e != 2.5) { return 5; }
    y = -(-3);            if (y != 3) { return 6; }
    c = !(!b);            if (!c) { return 7; }
    v = ~(~u);            if (v != 9) { return 8; }
    y = -(~x);            if (y != 6) { return 9; }
    y = ~(-x);            if (y != 4) { return 10; }
    y = x - -x;           if (y != 10 || x != 5) { return 11; }
    y = x - (-(-x));      if (y != 0 || x != 5) { return 12; }
    *i32 p = &x;
    y = *(&x);            if (y != 5) { return 13; }
    y = -(*p);            if (y != -5) { return 14; }

    // call argument
    if (id32(-(-x)) != 5 || x != 5) { return 20; }
    if (id64(-(-w)) != 7 || w != 7) { return 21; }
    if (idf(-(-d)) != 1.5) { return 22; }
    if (idf32(-(-h)) != 2.5) { return 23; }
    if (idf(-(-2.5)) != 2.5) { return 24; }

    // orelse fallback
    y = none32() orelse -(-x);   if (y != 5 || x != 5) { return 30; }
    e = nonef() orelse -(-d);    if (e != 1.5) { return 31; }
    e = nonef() orelse -(-2.5);  if (e != 2.5) { return 32; }

    // defer body
    in_defer(x);
    if (gi != 5) { return 40; }

    // global store
    gi = -(-x);                  if (gi != 5 || x != 5) { return 50; }
    return 0;
}
