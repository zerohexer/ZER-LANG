// expect-error: both access non-shared global 'pool'
// BUG-1666 (was docs/limitations.md B.11): two global Handles name ONE pool slot (`h2 = h1;`); a thread works through each. A Handle
// dereference was not recorded as an access to its Pool.
// ThreadSanitizer reported a data race on the pre-fix compiler, which accepted this.
u32 flagx;
struct Task { u32 v; }
Pool(Task, 4) pool;
Handle(Task) h1;
Handle(Task) h2;
void setup() { h1 = pool.alloc() orelse return; h2 = h1; }
void w() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { h1.v += 1; } }
void w2() { @atomic_store(&flagx, 1); for (u32 i = 0; i < 100000; i += 1) { h2.v += 1; } }
i32 main() {
    setup();
    ThreadHandle a = spawn w();
    ThreadHandle b = spawn w2();
    a.join(); b.join();
    return 0;
}
