// EXPECTED: compile error
// expect-error: cannot call 'reset' while '|*w|' points into a variant of union 'U'
// BUG-1186: the callee assigns the OTHER variant of the union the arm is capturing,
// so `w` points at the bytes of a u64 read as a `P`. Pre-fix this compiled, and the
// integer written by reset() became a working pointer: `*w.ptr = 1234` wrote into
// `victim` (no @inttoptr, no mmio).
struct P { *u32 ptr; }
union U { u64 n; P p; }
U gu;
u32[4] buf;
u32[4] victim;
u64 target;
void reset() { gu.n = target; }
u32 main() {
    P pp = { .ptr = &buf[0] };
    gu.p = pp;
    target = (u64)@ptrtoint(&victim[2]);
    switch (gu) {
        .p => |*w| { reset(); *w.ptr = 1234; }
        .n => |n| { return 6; }
    }
    if (victim[2] == 1234) { return 1; }
    return 0;
}
