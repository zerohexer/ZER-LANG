// expect-error: cannot take the address of '.ptr' of a slice
// BUG-967: the `.ptr` half of the address-of door. `&s.len` had a branch test;
// `&s.ptr` is its sibling and had none — retarget the base through the pointer and
// keep the old length, and the header describes storage it does not own.
u8[2] gb;
void retarget(**u8 pp) { *pp = &gb[0]; }
u32 main() {
    u8[4] a;
    [*]u8 s = a;
    retarget(&s.ptr);
    s[3] = 1;
    return 0;
}
