// BUG-1377 boundary: inside `switch (w.u)`, writing a SIBLING field of the
// enclosing struct, or another object's non-union field, is not a write to the
// union and stays legal.
struct T { u32 v; }
union U { *T p; u32 n; }
struct W { U u; u32 k; }
T t0;
u32 main() {
    W w;
    w.u.p = &t0;
    t0.v = 5;
    W o;
    *W pw = &w;
    u32 r = 0;
    switch (pw.u) {
        .p => |*q| { w.k = 3; o.k = 4; r = (*q).v + w.k + o.k; }
        .n => |m| { r = m; }
    }
    if (r != 12) { return 1; }
    return 0;
}
