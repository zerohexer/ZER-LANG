// Gap 31 regression test (2026-04-27, Stage 2): range-for must snapshot
// collection.len BEFORE the loop. Changing the collection's length inside the body
// must NOT change the bound mid-iteration.
//
// REWRITTEN 2026-09-08 (BUG-967). The original built its slice by writing the header
// directly — `slice.ptr = &data[0]; slice.len = 5;` — and mutated `slice.len` inside
// the body. That is now rejected: a writable `.len` forges the bounds guarantee. The
// PROPERTY under test is unchanged and still reachable, because reassigning the WHOLE
// slice is legal and is now the only way to change the bound mid-loop. If range-for
// re-read the length each iteration this would run 10 times, not 5.

i32 main() {
    u8[10] data;
    data[0] = 1; data[1] = 2; data[2] = 3; data[3] = 4; data[4] = 5;
    [*]u8 slice = data[0..5];
    u32 count = 0;
    for (u8 b in slice) {
        count += 1;
        if (count == 2) {
            slice = data[0..10];   // widen mid-loop — must NOT affect the snapshot
        }
    }
    if (count != 5) { return 1; }     // snapshot held; loop ran exactly 5 times
    if (slice.len != 10) { return 2; } // and the widening really did take effect
    return 0;
}
