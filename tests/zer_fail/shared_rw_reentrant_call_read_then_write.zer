// EXPECTED: compile error
// expect-error: not re-entrant
// BUG-998 (2026-09-06): the statement holds S's READ lock (`g.v + ...`) and calls
// f, which takes S's WRITE lock on the same thread — the writer waits for the
// reader, which is itself. Measured on the pre-fix build: HANG (timeout 124).
shared(rw) struct S { u32 v; }
S g;
u32 f() { g.v = 2; return 1; }
u32 main() { u32 r = g.v + f(); return 0; }
