// BUG-1457: a `release` that only READS its argument.
u32 m1457_cnt;
void release([*]u32 s) { m1457_cnt += s[0]; }
u32 m1457_fa() {
    [*]u32 s = alloc(u32, 4) orelse return;
    s[0] = 5;
    release(s);
    u32 v = s[0];     // fine: THIS module's release does not free
    free(s);
    return v + m1457_cnt;
}
