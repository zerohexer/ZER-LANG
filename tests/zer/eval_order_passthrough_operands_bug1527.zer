// BUG-1527: left-to-right evaluation inside intrinsic arguments, slice bounds,
// bit-slice positions and a Ring push value (the passthrough emitted each as one
// C expression; GCC evaluated the call first). Exit = bitmask of wrong checks.
struct M { u32 v; }
Ring(M, 4) rq;
u32 g = 0;
u32 bump(*u32 p) { *p += 10; return 1; }
M mk(u32 a, u32 b) { M m = { .v = a * 100 + b }; return m; }
u32 main() {
    u32 bad = 0;
    u32 x = 5;
    if (x + bump(&x) != 6) { return 1; }            // plain: correct (6)
    x = 5;
    if (@saturate(u8, x + bump(&x)) != 6) { bad += 1 << 2; }   // gets 16
    x = 5;
    if (@popcount(x + bump(&x)) != 2) { bad += 1 << 3; }       // popcount(16)=1
    x = 5;
    u64 r = 0xFFFFFFFFFFFFFFFF;
    if (r[x + bump(&x) .. 0] != 127) { bad += 1 << 4; }        // reads bits 16..0
    x = 5;
    u32[32] a;
    [*]u32 s = a[0 .. x + bump(&x)];
    if (s.len != 6) { bad += 1 << 5; }                         // len 16
    x = 5;
    u32 o = @atomic_add(&g, x + bump(&x));
    if (g != 6) { bad += 1 << 6; }                             // g = 16
    x = 5;
    rq.push(mk(x, bump(&x)));
    M m = rq.pop() orelse return;
    if (m.v != 501) { bad += 1 << 7; }                         // 1501
    return bad;
}
