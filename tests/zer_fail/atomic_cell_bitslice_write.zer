// expect-error: plain access to 'g' in a concurrent context
// BUG-1588: a bit-slice write to an atomic cell was not seen as a plain access.
u32 g;
void worker() { for (u32 i = 0; i < 1000000; i += 1) { @atomic_add(&g, 16); } }
u32 main() {
    ThreadHandle th = spawn worker();
    for (u32 i = 0; i < 1000000; i += 1) { g[3..0] = 1; }
    th.join();
    u32 v = @atomic_load(&g);
    if (v != 16000001) { return 1; }
    return 0;
}
