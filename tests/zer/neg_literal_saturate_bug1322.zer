// BUG-1322: regression (see BUGS-FIXED.md).
// A negative literal operand to an intrinsic is typed u32 and emitted as `-1U` (4294967295):
// @saturate(i8, -1) gives 127, @saturate(i64, -1) gives 4294967295. Expected exit 0.
u32 main() {
    i8 a = @saturate(i8, -1);
    if (a != -1) { return 1; }
    i64 b = @saturate(i64, -1);
    if (b != -1) { return 2; }
    i32 c = @saturate(i32, -5);
    if (c != -5) { return 3; }
    return 0;
}
