// expect-trap
// BUG-1058: the variable-address span test was `ma + (sizeof(T)-1) <= end`, which
// WRAPS for an address near the top of the space: 0xFFFFFFFFFFFFFFFE + 3 == 1, and
// 1 <= 0x400000FF, so an address far outside the declared range passed and was
// dereferenced (a segfault on hosted, a stray read on bare metal).
mmio 0x40000000..0x400000FF;
u64 wild() { return 0xFFFFFFFFFFFFFFFE; }
u32 main() {
    volatile *u32 r = @inttoptr(*u32, wild());
    return *r;
}
