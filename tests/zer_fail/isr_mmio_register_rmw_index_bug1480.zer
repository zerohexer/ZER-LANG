// EXPECTED: compile error
// expect-error: is read-modify-written and is written from both interrupt
// BUG-1480: the same register RMW'd as an INDEX on a `*u32` from an ISR and main.
// The register key only knew a field path, so `u[1]` was no key at all.
mmio 0x40000000..0x4000FFFF;
interrupt USART1 { volatile *u32 u = @inttoptr(*u32, 0x40000000); u[1] |= 1; }
u32 main() { volatile *u32 u = @inttoptr(*u32, 0x40000000); u[1] |= 2; return 0; }
