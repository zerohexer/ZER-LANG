// BUG-1565 (C2): thread a reaches g only through the pointer it was handed.
// expect-error: no common lock and no release/acquire flag
u32 g;
u32 flag;
void a(*u32 p) { *p = 1; @atomic_store(&flag, 1); }
void b() { g = 2; @atomic_store(&flag, 2); }
u32 main() { ThreadHandle t1 = spawn a(&g); ThreadHandle t2 = spawn b(); t1.join(); t2.join(); return 0; }
