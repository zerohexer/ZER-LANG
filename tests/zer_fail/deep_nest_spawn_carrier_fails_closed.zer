// expect-error: carries a non-shared pointer
// BUG-980: type_carries_nonshared_pointer capped at 32 levels and answered
// "carries none" past the cap, so a HEAP pointer 36 struct levels deep slipped the
// fire-and-forget spawn-arg CARRIER GATE (the gate's policy: a copied non-shared
// pointer crossing a fire-and-forget spawn is refused whatever the parent does
// next). The pre-flip build accepted this program outright; the walk now fails
// CLOSED past its cap and the nest is refused at the gate.
struct T { u32 v; }
struct L0 { ?*T p; }
struct L1 { L0 inner; }
struct L2 { L1 inner; }
struct L3 { L2 inner; }
struct L4 { L3 inner; }
struct L5 { L4 inner; }
struct L6 { L5 inner; }
struct L7 { L6 inner; }
struct L8 { L7 inner; }
struct L9 { L8 inner; }
struct L10 { L9 inner; }
struct L11 { L10 inner; }
struct L12 { L11 inner; }
struct L13 { L12 inner; }
struct L14 { L13 inner; }
struct L15 { L14 inner; }
struct L16 { L15 inner; }
struct L17 { L16 inner; }
struct L18 { L17 inner; }
struct L19 { L18 inner; }
struct L20 { L19 inner; }
struct L21 { L20 inner; }
struct L22 { L21 inner; }
struct L23 { L22 inner; }
struct L24 { L23 inner; }
struct L25 { L24 inner; }
struct L26 { L25 inner; }
struct L27 { L26 inner; }
struct L28 { L27 inner; }
struct L29 { L28 inner; }
struct L30 { L29 inner; }
struct L31 { L30 inner; }
struct L32 { L31 inner; }
struct L33 { L32 inner; }
struct L34 { L33 inner; }
struct L35 { L34 inner; }
void worker(L35 x) { }
u32 main() {
    *T t = alloc(T) orelse return;
    L35 deep;
    deep.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.p = t;
    spawn worker(deep);
    return 0;
}
