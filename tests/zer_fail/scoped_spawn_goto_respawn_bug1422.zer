// expect-error: ThreadHandle 'th' re-spawned while the thread spawned at line
// BUG-1422: one scoped spawn re-executed by a backward goto; only the LAST
// thread is joined, the earlier ones write f's frame after it returned.
// Same shape, and the frame DIES: the first two threads write into f's
// stack slot after f has returned (stack use-after-return).
void w(*u32 p) {
    for (u32 k = 0; k < 20000000; k += 1) { *p += 1; }
}
u32 f() {
    u32 v = 0;
    u32 i = 0;
again:
    ThreadHandle th = spawn w(&v);
    i += 1;
    if (i < 3) { goto again; }
    th.join();
    return v;
}
u32 clobber() { u32[64] big; for (u32 k = 0; k < 64; k += 1) { big[k] = 7; } return big[3]; }
u32 main() {
    u32 r = f();
    u32 c = clobber();
    return 0;
}
