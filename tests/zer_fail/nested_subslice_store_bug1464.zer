// EXPECTED: compile error
// expect-error: use after free: 'la[2]' is freed
// BUG-1464: la[1..3][1..2][0] is la[2] — BUG-1383 folded only one sub-slice level.
struct T { u32 v; }
u32 main() {
    ?*T[4] la;
    *T a = alloc(T) orelse return;
    a.v = 5;
    la[1..3][1..2][0] = a;
    free(a);
    *T b = alloc(T) orelse return;
    b.v = 99;
    u32 r = 0;
    if (la[2]) |q| { r = q.v; }
    free(b);
    return r;
}
