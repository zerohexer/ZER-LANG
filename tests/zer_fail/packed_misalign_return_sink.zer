// EXPECTED: compile error
// expect-error: into a PACKED struct field
// NOTE: narrowed to the substring EVERY packed sink shares. Two branches
// phrased this rule differently ("points into" vs "a pointer into") and the
// sentence that reads naturally differs per sink (deref / argument / return),
// so the directive asserts the RULE rather than one sink's grammar.
// BUG-804 — the RETURN sink. Handing the CALLER a misaligned pointer is worse than
// the local forms: the fact does not cross the function boundary, so the caller's
// deref has no way to know. Rejected at the source, where the packedness is visible.
packed struct P { u8 a; u32 b; }
P g;
*u32 leak() { return &g.b; }
u32 main() {
    return 0;
}
