// BUG-1156: a braceless `defer c.n += 1;` on a shared struct took NO lock
// (lost updates under two threads); the braced spelling locked.
i32 printf(const *u8 fmt, ...);
shared struct C { u32 n; }
C c;
void inc() { defer c.n += 1; }
void w() {
    for (u32 i = 0; i < 1000000; i += 1) { inc(); }
}
u32 main() {
    ThreadHandle t1 = spawn w();
    ThreadHandle t2 = spawn w();
    t1.join();
    t2.join();
    u32 n = c.n;
    printf("n=%u (expect 2000000)\n", n);
    if (n != 2000000) { return 1; }
    return 0;
}
