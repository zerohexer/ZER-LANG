// Audit 2026-08-01: `*(&x) = v` (deref of address-of a local, semantically `x = v`)
// crashed the COMPILER with SIGSEGV — the const-check lvalue walker treated the
// non-STAR `&` NODE_UNARY as a NODE_INDEX and read a garbage union field. Fixed:
// the walker handles `&`-of-deref by walking the operand. Must compile + run.
u32 main() {
    u32 b = 0;
    *(&b) = 5;
    if (b == 5) { return 0; }
    return 1;
}
